<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tier-1 offline unit tests (ADR 0002) for the F7 protocol contracts: serialization
    round-trips, the version-compatibility rule, and the closed-vocabulary guard
    (trust-boundaries.md §9 rule 3). MTP test app; LangVersion pinned (ADR 0002 item 6).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <LangVersion>14.0</LangVersion>
    <!-- Silent-drop floor (ADR 0002). Update when tests are added or removed. -->
    <TestingPlatformCommandLineArguments>--minimum-expected-tests 33</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ZWarden.Contracts\ZWarden.Contracts.csproj" />
  </ItemGroup>

</Project>
