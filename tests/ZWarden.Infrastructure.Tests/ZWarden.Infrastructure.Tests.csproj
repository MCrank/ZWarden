<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tier-1 offline (ADR 0002): the value converter is exercised without a database. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <LangVersion>14.0</LangVersion>
    <TestingPlatformCommandLineArguments>--minimum-expected-tests 431</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ZWarden.Infrastructure\ZWarden.Infrastructure.csproj" />
    <ProjectReference Include="..\ZWarden.TestSupport\ZWarden.TestSupport.csproj" />
    <!-- The SQLite migration history, so MigrateAsync finds the offline provider's migrations. -->
    <ProjectReference Include="..\..\src\ZWarden.Migrations.Sqlite\ZWarden.Migrations.Sqlite.csproj" />
    <!-- F40 migration-drift drill: both providers' migration snapshots are checked for model drift offline
         (HasPendingModelChanges compares the model to the snapshot; it opens no connection). -->
    <ProjectReference Include="..\..\src\ZWarden.Migrations.Postgres\ZWarden.Migrations.Postgres.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- #227: the full-key B42 fixtures (ZWarden-authored, ADR 0009) drive the Configuration View reader end to end. -->
    <None Include="..\ZWarden.PzConfig.Tests\Fixtures\**" LinkBase="Fixtures" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
