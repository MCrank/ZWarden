<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    bUnit component tests in TUnit REFLECTION MODE (ADR 0002). TUnit's and bUnit's
    source generators cannot see each other, so TUnit source generation is OFF here
    and test discovery is by reflection. Both halves are required:
      - build side:   <EnableTUnitSourceGeneration>false</EnableTUnitSourceGeneration>
      - runtime side: [assembly: TUnit.Core.ReflectionMode]  (see ReflectionMode.cs)
    A Razor-bearing project also needs the explicit FrameworkReference below
    (Microsoft.NET.Sdk.Razor does not imply it).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <LangVersion>14.0</LangVersion>
    <EnableTUnitSourceGeneration>false</EnableTUnitSourceGeneration>

    <!--
      The silent-drop guard, baked in so it is always on (local and CI), not just
      when someone remembers the flag. Tests defined in a .razor file (see
      HarnessBadgeRazorTests.razor) are discovered ONLY in reflection mode; forget
      the switch and they vanish with a clean "Passed!" and exit 0. This floor turns
      that into a hard failure (MTP exit 9). Update the number when tests are added.
    -->
    <TestingPlatformCommandLineArguments>--minimum-expected-tests 39</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="bunit" />
    <!-- WebApplicationFactory<Program> for the F4 UI cookie-flow endpoint tests (#63). -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <!-- A real SignalR client driving the Agent hub over the test server (F10). -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
  </ItemGroup>

  <ItemGroup>
    <!-- The app under test (bUnit renders its components; WAF boots its Program). -->
    <ProjectReference Include="..\..\src\ZWarden.Web\ZWarden.Web.csproj" />
    <!-- TOTP generator matching Identity's authenticator, for the MFA flow tests. -->
    <ProjectReference Include="..\ZWarden.TestSupport\ZWarden.TestSupport.csproj" />
    <!-- The SQLite migration history, so the booted host's MigrateAsync finds the offline provider's migrations. -->
    <ProjectReference Include="..\..\src\ZWarden.Migrations.Sqlite\ZWarden.Migrations.Sqlite.csproj" />
  </ItemGroup>

</Project>
