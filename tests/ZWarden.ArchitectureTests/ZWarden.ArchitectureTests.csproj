<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Turns trust-boundaries.md §9 into a red build. Tier-1 (offline): it reads the
    src/*.csproj files from disk, so most rules need neither Docker nor project references
    to the assemblies under test. The reference-direction rules (§9 rules 1, 2, 5, 6) are
    csproj-only; the type-level rules (3, 4, 7) arrive with the features that introduce the
    types they constrain. F20a's seam rule (ADR 0010) is one such type-level rule: it
    reflects over ZWarden.PzConfig's public surface to prove no Loretta type crosses the
    seam, so it - and only it - needs a reference to that one assembly.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <LangVersion>14.0</LangVersion>
    <TestingPlatformCommandLineArguments>--minimum-expected-tests 59</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <!-- F20a seam rule only: reflect over the PzConfig public surface to prove Loretta never crosses it. -->
  <!-- F30 D-1: prove the SupportPackage pipeline core pulls in no ZIP/HTTP assembly. -->
  <!-- F40 §9 rule 3: reflect over the AgentCommand vocabulary to prove no free-form command crosses it. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\ZWarden.PzConfig\ZWarden.PzConfig.csproj" />
    <ProjectReference Include="..\..\src\ZWarden.Diagnostics\ZWarden.Diagnostics.csproj" />
    <ProjectReference Include="..\..\src\ZWarden.Contracts\ZWarden.Contracts.csproj" />
  </ItemGroup>

</Project>
