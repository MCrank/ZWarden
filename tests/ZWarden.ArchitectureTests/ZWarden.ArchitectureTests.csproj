<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Turns trust-boundaries.md §9 into a red build. Tier-1 (offline): it reads the
    src/*.csproj files from disk, so it needs neither Docker nor project references
    to the assemblies under test. The rules checkable now are the reference-direction
    ones (§9 rules 1, 2, 5, 6); the type-level rules (3, 4, 7) arrive with the
    features that introduce the types they constrain.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <LangVersion>14.0</LangVersion>
    <TestingPlatformCommandLineArguments>--minimum-expected-tests 9</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
  </ItemGroup>

</Project>
