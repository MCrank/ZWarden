<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tier-1 offline unit tests (ADR 0002) for F20a/F20b. The suite drives the pre-check, the INI and Lua
    readers, the value model, the parse-failure state and the validation schema (F20a), plus the write
    half: the INI and Lua edit backings (surgical, BOM-less), the value-level diff, the canonical
    snapshot + hash and the restore plan (F20b) - all against hand-written synthetic fixtures that mirror
    the shapes measured in docs/research/pz-lua-config.md. No PZ-derived artefact is committed (F12
    testing rule; ADR 0010 §6.5) - the fixtures are ZWarden's, including the full-key B42-shaped files under
    Fixtures/ (#227), which mirror only the game's key set, value shapes and stated ranges. MTP test app; LangVersion pinned (ADR 0002
    item 6).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <LangVersion>14.0</LangVersion>
    <!-- Silent-drop floor (ADR 0002). Update when tests are added or removed. -->
    <TestingPlatformCommandLineArguments>--minimum-expected-tests 196</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ZWarden.PzConfig\ZWarden.PzConfig.csproj" />
  </ItemGroup>

</Project>
