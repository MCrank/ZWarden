<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tier-2 (opt-in / networked) integration tests. Every test here needs a real
    PostgreSQL container, so CI tiers this WHOLE ASSEMBLY into the networked leg
    (ADR 0002: tiers split by assembly, categories slice within one). It never runs
    in the offline tier.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <LangVersion>14.0</LangVersion>
    <TestingPlatformCommandLineArguments>--minimum-expected-tests 3</TestingPlatformCommandLineArguments>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" />
    <PackageReference Include="Testcontainers.PostgreSql" />
    <PackageReference Include="Npgsql" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZWarden.TestSupport\ZWarden.TestSupport.csproj" />
  </ItemGroup>

</Project>
