<Project>

  <!--
    Solution-wide compiler and analyzer policy for ZWarden.
    See docs/adr/0013-feature-0-build-and-ci-policy.md and
    docs/feature-plans/F0-repository-and-engineering-foundation.md.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- PRD 56 / ADR 0013: warnings are errors, analyzers on, code style enforced. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!--
      NuGet advisory two-tier policy (ADR 0013). NU1901-NU1905 are demoted from
      errors so a newly published advisory WARNS on PR/main rather than blocking
      unrelated work. A scheduled CI job re-promotes them to errors (see the
      workflow), and the F40 gate treats any open advisory as a hard blocker.
      Third-party [Obsolete]/analyzer breakage is handled by targeted, per-diagnostic
      NoWarn with a tracking comment - never by widening this list.
    -->
    <WarningsNotAsErrors Condition="'$(PromoteNuGetAudit)' != 'true'">$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904;NU1905</WarningsNotAsErrors>

    <!-- PRD 55: reproducible, lockable restore. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

</Project>
