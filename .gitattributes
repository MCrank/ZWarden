# Normalize line endings to LF on checkin; let git handle the working tree.
* text=auto eol=lf

# Explicit text types (the ones the build and its guards care about).
*.cs      text eol=lf
*.csproj  text eol=lf
*.props   text eol=lf
*.targets text eol=lf
*.slnx    text eol=lf
*.razor   text eol=lf
*.css     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.sh      text eol=lf
*.editorconfig text eol=lf

# Windows-only scripts keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets - never touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff  binary
*.woff2 binary
