<Project>

  <!--
    Central package management (ADR 0002). Every version is pinned here; project
    files carry <PackageReference Include="..." /> with no Version attribute.
    Transitive pinning is on, so transitive versions are pinned here too when a
    restore conflict requires it.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test stack - exact pins (ADR 0002). -->
    <PackageVersion Include="TUnit" Version="1.66.27" />
    <PackageVersion Include="TUnit.Mocks" Version="1.66.27" />
    <PackageVersion Include="bunit" Version="2.10.3" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- WebApplicationFactory<Program> for the F4 UI cookie-flow endpoint tests (offline tier). -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI component library - exact pins (ADR 0003); never 3.*. -->
    <PackageVersion Include="BlazorBlueprint.Components" Version="3.16.0" />
    <PackageVersion Include="BlazorBlueprint.Primitives" Version="3.16.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Runtime host packages. -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- Data layer (ADR 0004/0005), exact pins as exercised in the dual-provider spike. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Identity store over EF Core (F4). Standalone NuGet package (not in the ASP.NET Core shared
         framework); pinned to the EF Core band (ADR 0002/0006). -->
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Server-side authenticator QR rendering (F4 UI, #63). Only the managed SvgQRCode path is used, so
         the static-rendered enrolment page needs no JS interop and no outbound internet. Exact pin. -->
    <PackageVersion Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

</Project>
