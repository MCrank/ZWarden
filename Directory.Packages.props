<Project>

  <!--
    Central package management (ADR 0002). Every version is pinned here; project
    files carry <PackageReference Include="..." /> with no Version attribute.
    Transitive pinning is on, so transitive versions are pinned here too when a
    restore conflict requires it.
  -->

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test stack - exact pins (ADR 0002). -->
    <PackageVersion Include="TUnit" Version="1.66.27" />
    <PackageVersion Include="TUnit.Mocks" Version="1.66.27" />
    <PackageVersion Include="bunit" Version="2.10.3" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.15.0" />
    <!-- Core Testcontainers, for the F13 Docker-runtime integration tier: seed labelled containers and run the
         wollomatic socket-proxy allowlist drift test (ADR 0008). Same band as Testcontainers.PostgreSql. -->
    <PackageVersion Include="Testcontainers" Version="4.15.0" />
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <!-- WebApplicationFactory<Program> for the F4 UI cookie-flow endpoint tests (offline tier). -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <!-- The Agent's outbound control-plane connection (F10, ZWarden.Agent) and the hub integration tests. -->
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI component library - exact pins (ADR 0003); never 3.*. -->
    <PackageVersion Include="BlazorBlueprint.Components" Version="3.16.0" />
    <PackageVersion Include="BlazorBlueprint.Primitives" Version="3.16.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Runtime host packages. -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
    <!-- Options binding + startup validation for AgentOptions (F8). -->
    <PackageVersion Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <!-- Logging stack (ADR 0021): Serilog, introduced by the Agent runtime (F8). Two-stage
         bootstrap via Serilog.Extensions.Hosting; Console + rolling File sinks; levels from
         configuration. Exact pins (ADR 0002 discipline). -->
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Observability baseline (ADR 0024, F16): OpenTelemetry SDK + hosting, auto-instrumentation for
         ASP.NET Core and HttpClient, and the OTLP + Console exporters. OTLP is opt-in via configuration
         (no endpoint => off); no Prometheus exporter ships (it never stabilised — F16 non-goal). Co-versioned
         at 1.18.0 — the version the F16 scope calls "OTel core is stable"; past the NU1902 advisories on the
         1.9.x line. Exact pins (ADR 0002 discipline). -->
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.Console" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Data layer (ADR 0004/0005), exact pins as exercised in the dual-provider spike. -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Agent's Docker runtime (F13, ADR 0008): the maintained Testcontainers fork of Docker.DotNet.
         It negotiates the Engine API version via GET/HEAD /_ping rather than pinning a /v1.xx prefix,
         which ADR 0008 requires (daemons in the field span API 1.48-1.56). Agent-only; the architecture
         guard forbids it in Web. Exact pin (ADR 0002). -->
    <PackageVersion Include="Docker.DotNet.Enhanced" Version="4.3.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Identity store over EF Core (F4). Standalone NuGet package (not in the ASP.NET Core shared
         framework); pinned to the EF Core band (ADR 0002/0006). -->
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <!-- Server-side authenticator QR rendering (F4 UI, #63). Only the managed SvgQRCode path is used, so
         the static-rendered enrolment page needs no JS interop and no outbound internet. Exact pin. -->
    <PackageVersion Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

</Project>
