# ZWarden reference deployment — environment template (F34, ADR 0037).
#
# Copy to `.env` (or run ./bootstrap-secrets.sh, which generates the secrets for you) and fill in the values.
# `.env` is git-ignored — it holds real secrets and must never be committed. Compose reads it automatically.

# --- Required: your deployment hostname -----------------------------------------------------------------
# The public DNS name clients use, e.g. zwarden.example.com. In Public TLS mode Caddy obtains a Let's Encrypt
# certificate for it (ports 80/443 must be reachable). Use a *.localhost name or an IP for a local trial.
ZWARDEN_DOMAIN=

# ACME (Let's Encrypt) contact e-mail: OPTIONAL and NOT set here. Let's Encrypt does not require one, and Caddy
# refuses to start on an empty `email` directive, so it is not wired through as a variable. To receive
# expiry/security notices, add an `email you@example.com` line to the global options block at the top of
# deploy/caddy/Caddyfile — see docs/deployment/https-reference.md.

# --- Secrets: generated by ./bootstrap-secrets.sh (do not hand-edit unless you know what you're doing) ---
# The AES-256-GCM key ring the control plane fails closed without (ADR 0015). Format: <id>:<base64-32-bytes>.
ZW_SECRET_KEYS=
# Which key id in the ring is active for new encryption.
ZW_SECRET_ACTIVE_KEY_ID=

# --- PostgreSQL mode (only used by compose.postgres.yaml) -----------------------------------------------
# The database password, generated by ./bootstrap-secrets.sh. Ignored in the SQLite base mode; consumed when
# you bring the stack up with the Postgres overlay.
POSTGRES_PASSWORD=

# --- Agent enrollment (operator-driven, D-4) ------------------------------------------------------------
# Leave BLANK for the initial bring-up. After `docker compose up -d`, open https://<ZWARDEN_DOMAIN>, complete
# the First-Run wizard (admin → TLS → enroll); it issues a one-time enrollment secret. Paste it here, then
# `docker compose up -d agent`. The Agent enrols once and persists its own credential — you can blank this
# again afterwards.
ZWARDEN_ENROLLMENT_SECRET=

# --- Project Zomboid runtime (F13/F14) ------------------------------------------------------------------
# The pinned canonical PZ image the Agent provisions servers from. Build it from src/ZWarden.PZServer, e.g.
#   docker build -t zwarden-pzserver:42.20.4 src/ZWarden.PZServer
# and set a SPECIFIC reference here (any tag except a floating `latest`, which is rejected — ADR 0008):
#   ZWARDEN_PZ_IMAGE=zwarden-pzserver:42.20.4
# For a hardened production deploy, push it to a registry and pin the repo@sha256:… digest instead (a locally
# built image that was never pushed has no digest, so pin its build tag). May be left blank until you
# provision your first server.
ZWARDEN_PZ_IMAGE=
# The Docker network provisioned PZ containers attach to (default: zwarden-pz).
ZWARDEN_PZ_NETWORK=zwarden-pz
