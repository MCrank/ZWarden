<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Clear inherited sources before adding nuget.org, so the restore graph does
    not depend on machine- or CI-level feed configuration (ADR 0002).
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
