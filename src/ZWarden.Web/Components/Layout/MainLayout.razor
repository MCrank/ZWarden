@inherits LayoutComponentBase

<div class="min-h-screen">
    @* The app shell (F14, the first UI feature). Nav links are visibility convenience only — every
       endpoint and page re-authorizes server-side (PRD 12). Servers is shown to any authenticated
       operator: the inventory self-filters to the Servers the caller may view (a server-scoped
       Server.View policy checked with no resource would deny outright, ADR 0018), so gating the link
       on it would wrongly hide the page from server-scoped operators. Audit is tenant-wide, so it
       gates cleanly. *@
    <AuthorizeView>
        <header class="border-b border-border">
            <nav class="mx-auto flex max-w-5xl items-center gap-6 px-6 py-4">
                <a href="/" class="text-sm font-semibold tracking-tight text-primary">ZWarden</a>
                <a href="/servers" class="text-sm font-medium text-muted-foreground hover:text-foreground">Servers</a>
                @* Hosts (F35) is tenant-wide (Agent.View), so — like Audit — it gates cleanly on the policy. *@
                <AuthorizeView Policy="Agent.View" Context="hosts">
                    <a href="/hosts" class="text-sm font-medium text-muted-foreground hover:text-foreground">Hosts</a>
                </AuthorizeView>
                <AuthorizeView Policy="Audit.View" Context="audit">
                    <a href="/audit" class="text-sm font-medium text-muted-foreground hover:text-foreground">Audit</a>
                </AuthorizeView>
            </nav>
        </header>
    </AuthorizeView>
    <main class="mx-auto max-w-5xl p-6">
        @Body
    </main>
</div>

@* Overlay host, toast and dialog providers (BbPortalHost / BbToastProvider /
   BbDialogProvider) are added by the first feature that needs an overlay - their
   API is version-sensitive and Feature 0 uses no overlays. *@

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
