@inherits LayoutComponentBase

<div class="min-h-screen">
    <AuthorizeView Policy="Audit.View">
        @* Visibility convenience only — the /audit endpoint re-authorizes server-side (PRD 12). *@
        <nav class="mx-auto max-w-5xl px-6 pt-6">
            <a href="/audit" class="text-sm font-medium text-muted-foreground hover:text-foreground">Audit</a>
        </nav>
    </AuthorizeView>
    <main class="mx-auto max-w-5xl p-6">
        @Body
    </main>
</div>

@* Overlay host, toast and dialog providers (BbPortalHost / BbToastProvider /
   BbDialogProvider) are added by the first feature that needs an overlay - their
   API is version-sensitive and Feature 0 uses no overlays. *@

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
