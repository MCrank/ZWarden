@using ZWarden.Domain.Servers
@* ZWarden owns the status badge outright (ADR 0003): Blueprint's BbBadge hard-codes
   `rounded-full` with no semantic status variant, and on an ops console the status
   colour IS the signal. Squared, dot + uppercase label - the Signal identity. #335 fills
   it in its status colour (the prototype's tinted chip): one zw-status-<tone> class sets
   the hue and status.css derives the tint, border, label ink (kept at 4.5:1) and the
   dot's glow from it, in both themes. Server chips are fixed-width so the fleet column
   lines up; host chips size to their label. *@

@* data-status-* hooks let live-status.js re-tone and re-label the fleet badge in place (#249, #335). *@
<span @attributes="AdditionalAttributes" class="zw-status @ToneClass @WidthClass" data-status-badge>
    <span class="zw-status-dot" data-status-dot></span>
    <span data-status-label>@Label</span>
</span>

@code {
    /// <summary>The Server's last-reported run-state (F14) — the badge's colour. The hierarchical health model is
    /// F16's. Set this or <see cref="Host"/>.</summary>
    [Parameter]
    public ServerRunState? State { get; set; }

    /// <summary>A Host's connection or trust state (#335), for the Hosts page. Set this or <see cref="State"/>.</summary>
    [Parameter]
    public HostStatus? Host { get; set; }

    /// <summary>An override for the label, e.g. a transitional <c>RESTARTING</c> worn in the busy tone (#249);
    /// null ⇒ the state's own name.</summary>
    [Parameter]
    public string? Text { get; set; }

    /// <summary>Extra attributes for the chip, e.g. a page's own <c>data-*</c> hook.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private string Label => Text
        ?? (Host is { } host ? host.ToString() : (State ?? ServerRunState.Unknown).ToString().ToUpperInvariant());

    private string WidthClass => Host is null ? "w-[112px]" : "";

    // running -> green, stopped -> grey, starting/stopping -> amber ("busy"), failed -> red,
    // unknown -> violet ("agent unreachable, not down"). A host maps onto the same ramp: online -> running,
    // unreachable -> unknown, revoked -> unhealthy, disabled -> stopped. The tones are tuned per theme in zwarden.css.
    private string ToneClass => Host switch
    {
        HostStatus.Online => "zw-status-running",
        HostStatus.Unreachable => "zw-status-unknown",
        HostStatus.Revoked => "zw-status-unhealthy",
        HostStatus.Disabled => "zw-status-stopped",
        _ => State switch
        {
            ServerRunState.Running => "zw-status-running",
            ServerRunState.Stopped => "zw-status-stopped",
            ServerRunState.Starting => "zw-status-busy",
            ServerRunState.Stopping => "zw-status-busy",
            ServerRunState.Failed => "zw-status-unhealthy",
            _ => "zw-status-unknown",
        },
    };
}
