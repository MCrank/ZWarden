@page "/account/forgot-password"
@layout AuthLayout
@inject AccountRecoveryService AccountRecovery

@* Requests a password-reset token through the recovery seam. The response is identical whether or not
   the address exists (no account enumeration). In v1.0 there is no email transport, so the token is
   delivered out-of-band by whatever transport a later feature registers behind IAccountNotification. *@

<PageTitle>Reset password · ZWarden</PageTitle>

<h1 class="text-lg font-semibold text-foreground">Forgot your password?</h1>
<p class="mt-1 text-sm text-muted-foreground">Enter your email and we'll start a reset.</p>

@if (_submitted)
{
    <div class="mt-4">
        <StatusAlert Kind="StatusAlert.AlertKind.Success"
                     Message="If an account exists for that address, a password-reset link has been sent." />
    </div>
    <div class="mt-4 text-center text-sm">
        <a href="/login" class="text-primary hover:underline">Back to sign in</a>
    </div>
}
else
{
    <EditForm class="mt-5 space-y-4" Model="Input" method="post" OnValidSubmit="RequestResetAsync" FormName="forgot-password">
        <DataAnnotationsValidator />

        <div class="space-y-1">
            <label for="email" class="block text-xs font-medium uppercase tracking-[0.1em] text-muted-foreground">Email</label>
            <InputText id="email" @bind-Value="Input.Email" autocomplete="username" autofocus
                       class="w-full rounded border border-input bg-background px-3 py-2 text-sm text-foreground outline-none focus:border-ring focus:ring-1 focus:ring-ring" />
            <ValidationMessage For="() => Input.Email" class="text-xs text-destructive" />
        </div>

        <button type="submit"
                class="w-full rounded bg-primary px-3 py-2 text-sm font-semibold text-primary-foreground transition hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-ring">
            Send reset link
        </button>
    </EditForm>

    <div class="mt-4 text-center text-sm">
        <a href="/login" class="text-primary hover:underline">Back to sign in</a>
    </div>
}

@code {
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    private bool _submitted;

    protected override void OnInitialized() => Input ??= new();

    private async Task RequestResetAsync()
    {
        // Behaves identically for an unknown address (the service does not reveal existence).
        await AccountRecovery.RequestPasswordResetAsync(Input.Email);
        _submitted = true;
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;
    }
}
