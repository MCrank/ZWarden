@page "/account/reset-password"
@layout AuthLayout
@inject UserManager<ApplicationUser> UserManager
@inject AccountRecoveryService AccountRecovery
@inject IdentityRedirectManager RedirectManager

@* Redeems a reset token (single-use: a successful reset rotates the security stamp, so the token cannot
   be replayed). The token arrives via the reset link's `code` query parameter; the new password must
   meet the NIST policy (15-char floor, breached-password check) - policy failures surface as errors. *@

<PageTitle>Reset password · ZWarden</PageTitle>

<h1 class="text-lg font-semibold text-foreground">Set a new password</h1>

<EditForm class="mt-5 space-y-4" Model="Input" method="post" OnValidSubmit="ResetAsync" FormName="reset-password">
    <DataAnnotationsValidator />

    @if (!string.IsNullOrEmpty(_error))
    {
        <StatusAlert Message="@_error" Kind="StatusAlert.AlertKind.Error" />
    }

    <input type="hidden" name="Input.Code" value="@Input.Code" />

    <div class="space-y-1">
        <label for="email" class="block text-xs font-medium uppercase tracking-[0.1em] text-muted-foreground">Email</label>
        <InputText id="email" @bind-Value="Input.Email" autocomplete="username"
                   class="w-full rounded border border-input bg-background px-3 py-2 text-sm text-foreground outline-none focus:border-ring focus:ring-1 focus:ring-ring" />
        <ValidationMessage For="() => Input.Email" class="text-xs text-destructive" />
    </div>

    <div class="space-y-1">
        <label for="password" class="block text-xs font-medium uppercase tracking-[0.1em] text-muted-foreground">New password</label>
        <InputText id="password" type="password" @bind-Value="Input.Password" autocomplete="new-password"
                   class="w-full rounded border border-input bg-background px-3 py-2 text-sm text-foreground outline-none focus:border-ring focus:ring-1 focus:ring-ring" />
        <ValidationMessage For="() => Input.Password" class="text-xs text-destructive" />
        <p class="text-xs text-muted-foreground">At least 15 characters. No other composition rules.</p>
    </div>

    <div class="space-y-1">
        <label for="confirm" class="block text-xs font-medium uppercase tracking-[0.1em] text-muted-foreground">Confirm new password</label>
        <InputText id="confirm" type="password" @bind-Value="Input.ConfirmPassword" autocomplete="new-password"
                   class="w-full rounded border border-input bg-background px-3 py-2 text-sm text-foreground outline-none focus:border-ring focus:ring-1 focus:ring-ring" />
        <ValidationMessage For="() => Input.ConfirmPassword" class="text-xs text-destructive" />
    </div>

    <button type="submit"
            class="w-full rounded bg-primary px-3 py-2 text-sm font-semibold text-primary-foreground transition hover:opacity-90 focus:outline-none focus:ring-2 focus:ring-ring">
        Reset password
    </button>
</EditForm>

@code {
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery(Name = "code")]
    private string? Code { get; set; }

    [SupplyParameterFromQuery(Name = "email")]
    private string? Email { get; set; }

    private string? _error;

    protected override void OnInitialized()
    {
        Input ??= new();

        // Prefill from the reset link on the initial GET; the POST carries the values back itself.
        if (string.IsNullOrEmpty(Input.Code) && !string.IsNullOrEmpty(Code))
        {
            Input.Code = Code;
        }

        if (string.IsNullOrEmpty(Input.Email) && !string.IsNullOrEmpty(Email))
        {
            Input.Email = Email;
        }
    }

    private async Task ResetAsync()
    {
        ApplicationUser? user = await UserManager.FindByEmailAsync(Input.Email);
        if (user is null)
        {
            // Same generic outcome as a bad token - no account enumeration.
            _error = "Invalid or expired reset link.";
            return;
        }

        IdentityResult result = await AccountRecovery.ResetPasswordAsync(user, Input.Code, Input.Password);
        if (result.Succeeded)
        {
            RedirectManager.RedirectTo("/login");
        }

        // Codes only - never echo the attempted password or the token.
        _error = result.Errors.Any(e => e.Code.Contains("Token", StringComparison.OrdinalIgnoreCase))
            ? "Invalid or expired reset link."
            : string.Join(" ", result.Errors.Select(e => e.Description));
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = string.Empty;

        [Required]
        public string Code { get; set; } = string.Empty;

        [Required]
        [StringLength(64, MinimumLength = 15, ErrorMessage = "The password must be at least 15 characters.")]
        [DataType(DataType.Password)]
        public string Password { get; set; } = string.Empty;

        [DataType(DataType.Password)]
        [Compare(nameof(Password), ErrorMessage = "The passwords do not match.")]
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}
