@page "/"
@inject NavigationManager Nav

@* The application entry point. Operators land on the fleet dashboard; when signed out, the /servers
   authorization redirects on to /login, so opening the app always leads somewhere real. Static SSR:
   NavigateTo during OnInitialized issues a redirect response before anything renders. (This replaced the
   Feature 0 UI-pipeline scaffolding, whose Blueprint/Tailwind wiring is now proven by the real pages.) *@

<PageTitle>ZWarden</PageTitle>

@code {
    protected override void OnInitialized() => Nav.NavigateTo("/servers");
}
