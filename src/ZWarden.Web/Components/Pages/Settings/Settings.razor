@page "/settings"
@page "/settings/{Section}"
@implements IAsyncDisposable
@using System.Globalization
@using System.Security.Claims
@using Microsoft.AspNetCore.Builder
@using Microsoft.AspNetCore.HttpOverrides
@using Microsoft.Extensions.Options
@using ZWarden.Application.Diagnostics
@using ZWarden.Application.Settings
@using ZWarden.Application.Setup
@using ZWarden.Application.Workshop
@using ZWarden.Domain.Ids
@using ZWarden.Domain.Security
@using ZWarden.Domain.Settings
@using ZWarden.Domain.Setup
@using ZWarden.Infrastructure.Identity
@using ZWarden.Web.Configuration
@using ZWarden.Web.Time
@attribute [Authorize(Policy = "User.Manage")]
@rendermode InteractiveServer
@using ZWarden.Infrastructure.Tenancy
@inject IOptions<InstanceOptions> Instance
@inject IOptions<ForwardedHeadersOptions> Forwarded
@inject DiagnosticsOptions Build
@inject ActionScopeRunner Actions
@inject IOperatorTimeZoneProvider OperatorTz
@inject UserManager<ApplicationUser> Users
@inject NavigationManager Navigation
@inject IJSRuntime JS

@* Control-plane Settings (#160, renamed from "Config" — per-server config stays inside Server Detail). A left sub-nav
   with one section per URL (#344, /settings/{section}; /settings is General), switched in the circuit by
   in-place-nav.js (#312) so a click doesn't prerender the page again. Interactive (#299, ADR 0046): the Workshop key's
   save and clear are circuit handlers, through ActionScopeRunner. The page's load (TLS mode, key status, host counts,
   the tenant-wide section gates) runs in one action scope on the prerender and reaches the circuit through
   [PersistentState]. Gated on User.Manage, which exactly the tenant-administrator tier holds (Tenant Owner +
   Administrator); enforcement is server-side (PRD 12), the sub-nav merely mirrors it. Values fixed at boot (instance
   name, TLS, forwarded-header trust, session lifetime) are shown as status with a "set in config" hint; they become
   editable in #345-#347. Host enrollment (Tenant.Enrollment.Manage), Integrations (Tenant.Manage) and Users & roles
   (Role.Manage) are offered only to operators who hold their grant; an unknown or withheld section falls back to
   General. *@

<ShellTitle Title="Settings" @key="_titleVersion" />

@* "on" once the circuit has rendered the page (browser tests wait for it); see ServerDetail. *@
<span hidden data-circuit="@(_circuitReady ? "on" : "off")" data-circuit-instance="@_instance"></span>

<div data-settings-page>
    <h1 class="text-2xl font-semibold tracking-tight">Settings</h1>
    <p class="mt-1 text-sm text-muted-foreground">
        Control-plane configuration for this ZWarden instance. Per-server settings live inside each server.
    </p>

    <div class="zw-srvlayout mt-6">
        <nav class="zw-rail zw-rail-scroll" aria-label="Settings sections" data-settings-nav>
            @foreach (SectionLink link in VisibleSections)
            {
                <a class="zw-railitem @Active(link.Id)" href="@link.Href" data-settings-nav-item="@link.Id"
                   aria-current="@(_active == link.Id ? "page" : null)">
                    <ShellIcon Name="@link.Icon" /><span>@link.Label</span>
                </a>
            }
        </nav>

        <div class="zw-secbody max-w-3xl" data-settings-section="@_active">
            @switch (_active)
            {
                case "security":
                    @* The boot-time security posture (F32/ADR 0035, F33) is read-only; the session idle timeout (PRD 11) is
                       the Owner's choice (#346, Tenant.Manage), applied to sessions on their next request. *@
                    <SettingsCard Icon="shield" Title="Security" Description="The ingress, forwarded-header trust, and session posture." data-settings-security>
                        <SettingRow Label="TLS deployment mode" Hint="How HTTPS reaches this instance">
                            <span data-settings-tls-mode>@TlsModeLabel(State?.TlsMode)</span>
                        </SettingRow>
                        <SettingRow Label="Trust X-Forwarded-* headers" Hint="Client address and scheme from the ingress">
                            <span data-settings-forwarded>@ForwardedSummary()</span>
                        </SettingRow>
                        <SettingRow Label="Session timeout" Hint="Sign-out after this long without activity. Existing sessions pick up a change on their next request">
                            <span class="inline-flex flex-wrap items-center gap-2 sm:justify-end">
                                <span data-settings-session>@SessionSummary()</span>
                                @if (State is { CanManageWorkshop: true })
                                {
                                    <EditForm Model="_timeout" OnValidSubmit="SaveTimeoutAsync" data-settings-session-form
                                              class="flex flex-wrap items-center gap-2 sm:flex-nowrap">
                                        <BbNativeSelect TValue="string" Id="session-timeout" @bind-Value="_timeout.Minutes" aria-label="Session timeout" Class="w-44">
                                            @foreach (TimeSpan choice in ControlPlaneSettings.SessionIdleTimeoutChoices)
                                            {
                                                <option value="@((int)choice.TotalMinutes)" selected="@(_timeout.Minutes == ((int)choice.TotalMinutes).ToString(CultureInfo.InvariantCulture))">
                                                    @SessionTimeouts.Describe(choice)@(choice == ControlPlaneSettings.DefaultSessionIdleTimeout ? " (default)" : "")
                                                </option>
                                            }
                                        </BbNativeSelect>
                                        <BbButton Type="ButtonType.Submit" Disabled="_acting" data-action="session-timeout-save">Save</BbButton>
                                    </EditForm>
                                }
                            </span>
                        </SettingRow>
                        @if (_timeoutMessage is not null)
                        {
                            <div class="pb-3" data-settings-session-saved>
                                <BbAlert Variant="AlertVariant.Success" AccentBorder>
                                    <BbAlertDescription>@_timeoutMessage</BbAlertDescription>
                                </BbAlert>
                            </div>
                        }
                        <p class="pb-3 pt-1 text-xs text-muted-foreground">
                            TLS and forwarded-header trust are set in config. ZWarden does not terminate TLS itself; they
                            reflect the deploy-time configuration and change with the deployment, not here.
                        </p>
                    </SettingsCard>
                    break;

                case "enrollment":
                    @* Owner-only (Tenant.Enrollment.Manage). Opens the Enroll host sheet on Hosts (#342) rather than
                       duplicating token issuance here. *@
                    <SettingsCard Icon="key-round" Title="Host enrollment" Description="Bring a host under management." data-settings-enrollment>
                        <SettingRow Label="Enroll a host" Hint="Generate a one-time token, then run the ZWarden Agent on the host with it">
                            <a href="/hosts?enroll=1"
                               class="inline-flex items-center gap-1.5 rounded bg-primary px-3 py-1.5 text-sm font-medium text-primary-foreground hover:opacity-90"
                               data-settings-enrollment-link>
                                Enroll host
                            </a>
                        </SettingRow>
                        @if (State is { EnrolledHosts: { } enrolled, OnlineHosts: { } online })
                        {
                            <SettingRow Label="Enrolled hosts" Hint="Hosts whose Agent holds a credential for this instance">
                                <span class="inline-flex flex-wrap items-center justify-end gap-3">
                                    <span class="font-mono tabular-nums" data-settings-hosts-count>@enrolled enrolled · @online online</span>
                                    <a href="/hosts" class="text-foreground underline hover:no-underline">Manage hosts</a>
                                </span>
                            </SettingRow>
                        }
                    </SettingsCard>
                    break;

                case "integrations":
                    @* Workshop search — Owner-only (Tenant.Manage). Optional, per-tenant Steam Web API key that unlocks
                       free-text Workshop search (F110/ADR 0044). Names and previews work without a key; this only adds
                       search. Write-only: the stored key is never echoed — only configured✓/not. Enforcement is
                       server-side in IWorkshopSettingsService (PRD 12); the flag (SettingsQuery) merely mirrors the gate. *@
                    <SettingsCard Icon="plug" Title="Integrations" Description="Services ZWarden talks to on your behalf." data-settings-workshop>
                        <div class="py-3">
                            <div class="text-sm font-semibold text-foreground">Steam Workshop search</div>
                            <p class="text-xs text-muted-foreground">
                                An optional Steam Web API key enables searching the Workshop. Names and previews work without one.
                            </p>

                            <p class="mt-3 text-sm @(_keyConfigured ? "text-foreground" : "text-muted-foreground")" data-settings-workshop-status>
                                @if (_keyConfigured)
                                {
                                    <span>A search key is configured. Search is enabled.</span>
                                }
                                else
                                {
                                    <span>No search key configured — search is off; browsing by id, names and previews still work.</span>
                                }
                            </p>

                            @if (_saved)
                            {
                                <div class="mt-3" data-settings-workshop-saved>
                                    <BbAlert Variant="AlertVariant.Success" AccentBorder>
                                        <BbAlertDescription>@_savedMessage</BbAlertDescription>
                                    </BbAlert>
                                </div>
                            }
                            @if (_error is not null)
                            {
                                <div class="mt-3" data-settings-workshop-error>
                                    <BbAlert Variant="AlertVariant.Danger" AccentBorder>
                                        <BbAlertDescription>@_error</BbAlertDescription>
                                    </BbAlert>
                                </div>
                            }

                            @* A form so Enter saves, as the button does. Immediate, so a click right after typing saves the
                               typed key (a BbInput otherwise reports on blur). *@
                            <EditForm class="mt-4 flex flex-wrap items-end gap-3" Model="_input" OnValidSubmit="SaveAsync">
                                <div class="flex flex-col text-sm">
                                    <BbLabel For="workshop-key" Class="mb-1 text-muted-foreground">Steam Web API key</BbLabel>
                                    <BbInput Id="workshop-key" Type="InputType.Password" UpdateTiming="UpdateTiming.Immediate" @bind-Value="_input.ApiKey"
                                             autocomplete="off"
                                             Placeholder="@(_keyConfigured ? "Enter a new key to replace it" : "Your steamcommunity.com/dev/apikey key")" />
                                </div>
                                <BbButton Type="ButtonType.Submit" Disabled="_acting" data-action="workshop-save">Save key</BbButton>
                            </EditForm>

                            @if (_keyConfigured)
                            {
                                <BbButton Class="mt-3" Variant="ButtonVariant.Destructive" Disabled="_acting" OnClick="ClearAsync" data-action="workshop-clear">Clear key</BbButton>
                            }

                            <p class="mt-4 text-xs text-muted-foreground">
                                Get a key at
                                <a href="https://steamcommunity.com/dev/apikey" target="_blank" rel="noreferrer"
                                   class="text-foreground underline hover:no-underline">steamcommunity.com/dev/apikey</a>.
                                The key is stored encrypted and is never shown again.
                            </p>
                        </div>
                    </SettingsCard>
                    break;

                case "backups":
                    @* The backup root is Agent-side, per-host config (F24); the control plane has no single backup path to
                       edit, so this points at the hosts that own theirs. *@
                    <SettingsCard Icon="archive" Title="Backups" Description="Where each host stores its world backups." data-settings-backups>
                        <SettingRow Label="Backup root" Hint="Set per host in its Agent's configuration">
                            <span class="text-muted-foreground">Per host — manage backups from each <a href="/hosts" class="text-foreground underline hover:no-underline">host</a> or server</span>
                        </SettingRow>
                    </SettingsCard>
                    break;

                case "users":
                    @* Owner+Admin (Role.Manage). The role/user administration backend exists (F5) but has no dedicated
                       UI yet (#171, v1.1); this is the reserved entry. *@
                    <SettingsCard Icon="users" Title="Users & roles" Description="Who can operate this instance, and what they can do." data-settings-users>
                        <SettingRow Label="User & role management" Hint="Built-in roles: Owner, Administrator, Operator, Moderator, Viewer, Support">
                            <span class="zw-rail-soon">Coming in v1.1</span>
                        </SettingRow>
                    </SettingsCard>
                    break;

                case "about":
                    <SettingsCard Icon="info" Title="About" Description="This ZWarden build and where to learn more." data-settings-about>
                        <SettingRow Label="Version" Hint="@(BuildId is null ? "The running control plane" : $"Build {BuildId}")">
                            <span class="font-mono" data-settings-version>@VersionLabel</span>
                        </SettingRow>
                        <SettingRow Label="Licence" Hint="Self-host and modify freely; hosted resale needs a commercial licence">
                            <a href="@($"{Repository}/blob/development/LICENSING.md")" target="_blank" rel="noreferrer"
                               class="text-foreground underline hover:no-underline" data-settings-licence>Business Source License 1.1</a>
                        </SettingRow>
                        <SettingRow Label="Documentation" Hint="Deployment, remote hosts and architecture">
                            <span class="inline-flex flex-wrap justify-end gap-3">
                                <a href="@($"{Repository}/tree/development/docs")" target="_blank" rel="noreferrer"
                                   class="text-foreground underline hover:no-underline">Docs</a>
                                <a href="@Repository" target="_blank" rel="noreferrer"
                                   class="text-foreground underline hover:no-underline">Repository</a>
                            </span>
                        </SettingRow>
                    </SettingsCard>
                    break;

                default:
                    @* General — instance identity and per-operator display. The default deploy host is chosen per deploy
                       until #347 adds a control-plane default. *@
                    <SettingsCard Icon="settings" Title="General" Description="How this instance identifies itself." data-settings-general>
                        @* Editable by Tenant.Settings.Manage (#345, ADR 0048): a saved name overrides ZWarden:Instance:Name;
                           "Use config name" clears it. The service validates, authorizes and audits. *@
                        <SettingRow Label="Instance name" Hint="Shown in the sidebar and page titles">
                            @if (State is { CanManageSettings: true })
                            {
                                <EditForm Model="_name" OnValidSubmit="SaveNameAsync" data-settings-instance-form
                                          class="flex flex-wrap items-center gap-2 sm:flex-nowrap sm:justify-end">
                                    <BbInput Id="instance-name" UpdateTiming="UpdateTiming.Immediate" @bind-Value="_name.Value"
                                             Placeholder="@Instance.Value.Name" aria-label="Instance name" maxlength="64"
                                             autocomplete="off" Class="w-56" />
                                    <BbButton Type="ButtonType.Submit" Disabled="_acting" data-action="instance-name-save">Save</BbButton>
                                    @if (State.InstanceNameOverride is not null)
                                    {
                                        <BbButton Variant="ButtonVariant.Outline" Disabled="_acting" OnClick="ResetNameAsync"
                                                  data-action="instance-name-reset">Use config name</BbButton>
                                    }
                                </EditForm>
                            }
                            else
                            {
                                <span>@EffectiveName</span>
                            }
                        </SettingRow>
                        @if (_nameMessage is not null)
                        {
                            <div class="pb-3" data-settings-instance-saved>
                                <BbAlert Variant="AlertVariant.Success" AccentBorder>
                                    <BbAlertDescription>@_nameMessage</BbAlertDescription>
                                </BbAlert>
                            </div>
                        }
                        @if (_nameError is not null)
                        {
                            <div class="pb-3" data-settings-instance-error>
                                <BbAlert Variant="AlertVariant.Danger" AccentBorder>
                                    <BbAlertDescription>@_nameError</BbAlertDescription>
                                </BbAlert>
                            </div>
                        }
                        @* #347: the host Deploy server pre-selects (Tenant.Settings.Manage); the operator can still pick another.
                           A saved host that is no longer enrolled and enabled means no default, said here. *@
                        <SettingRow Label="Default deploy host" Hint="Pre-selected in Deploy server; you can still pick another">
                            @if (State is { CanManageSettings: true, DeployHosts: { } choices })
                            {
                                <EditForm Model="_host" OnValidSubmit="SaveDefaultHostAsync" data-settings-default-host-form
                                          class="flex flex-wrap items-center gap-2 sm:flex-nowrap sm:justify-end">
                                    <BbNativeSelect TValue="string" Id="default-deploy-host" @bind-Value="_host.Id" aria-label="Default deploy host" Class="w-56">
                                        <option value="" selected="@(string.IsNullOrEmpty(_host.Id))">No default</option>
                                        @foreach (HostChoice choice in choices)
                                        {
                                            <option value="@choice.Id" selected="@(_host.Id == choice.Id)">@choice.Name</option>
                                        }
                                    </BbNativeSelect>
                                    <BbButton Type="ButtonType.Submit" Disabled="_acting" data-action="default-host-save">Save</BbButton>
                                </EditForm>
                            }
                            else
                            {
                                <span data-settings-default-host>@DefaultHostName</span>
                            }
                        </SettingRow>
                        @if (State is { DefaultDeployHostGone: true })
                        {
                            <div class="pb-3" data-settings-default-host-gone>
                                <BbAlert Variant="AlertVariant.Warning" AccentBorder>
                                    <BbAlertDescription>
                                        The saved default host is no longer enrolled and enabled, so Deploy server has no default.
                                        Pick another host, or <a href="/hosts" class="underline">manage hosts</a>.
                                    </BbAlertDescription>
                                </BbAlert>
                            </div>
                        }
                        @if (_hostError is not null)
                        {
                            <div class="pb-3" data-settings-default-host-error>
                                <BbAlert Variant="AlertVariant.Danger" AccentBorder>
                                    <BbAlertDescription>@_hostError</BbAlertDescription>
                                </BbAlert>
                            </div>
                        }
                        @if (_hostMessage is not null)
                        {
                            <div class="pb-3" data-settings-default-host-saved>
                                <BbAlert Variant="AlertVariant.Success" AccentBorder>
                                    <BbAlertDescription>@_hostMessage</BbAlertDescription>
                                </BbAlert>
                            </div>
                        }
                        @* Time display (#211) — a per-operator, per-browser preference (a cookie, not the tenant). Toggling
                           is client-side (shell.js sets/clears the cookie with the browser's detected zone, then reloads);
                           the server reads the cookie to render audit/log times. The prerender reads it (a circuit has no
                           request cookie) and hands it on with the rest of the load. *@
                        <div data-settings-time>
                            <SettingRow Label="Time display" Hint="For you, in this browser. Audit log and live logs; CSV exports stay in UTC">
                                <span class="inline-flex flex-wrap items-center justify-end gap-3">
                                    <span class="text-muted-foreground" data-settings-time-status>
                                        @if (_localTime)
                                        {
                                            <text>Showing <span class="text-foreground">@_zoneLabel</span></text>
                                        }
                                        else
                                        {
                                            <text>Showing UTC</text>
                                        }
                                    </span>
                                    <button type="button" data-shell-tz-toggle data-tz-on="@(_localTime ? "true" : "false")"
                                            aria-pressed="@(_localTime ? "true" : "false")"
                                            class="inline-flex items-center gap-2 rounded border border-border px-3 py-1.5 text-sm font-medium text-foreground hover:bg-muted">
                                        @(_localTime ? "Switch to UTC" : "Use my local time")
                                    </button>
                                </span>
                            </SettingRow>
                        </div>
                        <p class="pb-3 pt-1 text-xs text-muted-foreground" data-settings-instance-source>
                            Showing <span class="text-foreground" data-settings-instance-name>@EffectiveName</span>.
                            @if (State?.InstanceNameOverride is not null)
                            {
                                <text>Set here; it overrides the config name "@Instance.Value.Name"</text>
                            }
                            else
                            {
                                <text>From config</text>
                            }
                            (<code class="rounded bg-muted px-1 py-0.5 font-mono">ZWarden:Instance:Name</code>).
                        </p>
                    </SettingsCard>
                    break;
            }
        </div>
    </div>
</div>

@code {
    private const string Repository = "https://github.com/MCrank/ZWarden";

    // The sub-nav, in the issue's order (#344). Href is the section's own URL; General is the bare /settings.
    private static readonly SectionLink[] AllSections =
    [
        new("general", "General", "settings", "/settings"),
        new("security", "Security", "shield", "/settings/security"),
        new("enrollment", "Host enrollment", "key-round", "/settings/enrollment"),
        new("integrations", "Integrations", "plug", "/settings/integrations"),
        new("backups", "Backups", "archive", "/settings/backups"),
        new("users", "Users & roles", "users", "/settings/users"),
        new("about", "About", "info", "/settings/about"),
    ];

    /// <summary>The route's section. Only the router reads it: the page keeps its own location (an in-place switch is a
    /// <c>pushState</c> the router never sees), so the section shown comes from <see cref="SettingsLocation"/>.</summary>
    [Parameter]
    public string? Section { get; set; }

    /// <summary>The prerender's load, handed to the circuit (#299).</summary>
    [PersistentState]
    public SettingsState? State { get; set; }

    /// <summary>The time-display preference, read from the request cookie while prerendering: whether local time is
    /// on, and the zone's label (a circuit has no request cookie to read it from).</summary>
    [PersistentState]
    public string? TimeDisplay { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    // Write-only: this only ever carries a newly-entered key; the stored key is never read back into it.
    private readonly WorkshopKeyInput _input = new();
    private readonly string _instance = Guid.NewGuid().ToString("N");
    private SettingsLocation _location = new(true, null);
    private string _active = "general";
    private DotNetObjectReference<Settings>? _self;
    private bool _attached;
    private bool _saved;
    private string? _savedMessage;
    private string? _error;
    private bool _acting;
    private bool _circuitReady;
    private readonly InstanceNameInput _name = new();
    private string? _nameMessage;
    private string? _nameError;
    private int _titleVersion; // a rename re-creates the title, which reads the name once
    private readonly SessionTimeoutInput _timeout = new();
    private string? _timeoutMessage;
    private readonly DefaultHostInput _host = new();
    private string? _hostMessage;
    private string? _hostError;

    // The default deploy host as text (#347): its name, "None", or (gone) "None (saved host no longer enrolled)".
    private string DefaultHostName =>
        State?.DeployHosts?.FirstOrDefault(h => h.Id == State.DefaultDeployHost)?.Name
        ?? (State?.DefaultDeployHost is null ? "None" : "None (the saved host is no longer enrolled)");

    private string EffectiveName => State?.InstanceNameOverride ?? Instance.Value.Name;

    private bool _keyConfigured => State?.WorkshopKeyConfigured ?? false;

    // TimeDisplay is "utc", or the local zone's label.
    private bool _localTime => TimeDisplay is { } display && display != "utc";

    private string? _zoneLabel => _localTime ? TimeDisplay : null;

    private IEnumerable<SectionLink> VisibleSections => AllSections.Where(s => Resolve(s.Id) == s.Id);

    // The informational version is "<version>+<commit>" in a CI build; the version alone otherwise.
    private string VersionLabel => Build.Version?.Split('+')[0] is { Length: > 0 } version ? version : "Development build";

    private string? BuildId => Build.Version?.Split('+') is [_, { Length: > 0 } commit] ? commit[..Math.Min(7, commit.Length)] : null;

    protected override async Task OnInitializedAsync()
    {
        _location = SettingsLocation.Parse(Navigation.Uri);
        Navigation.LocationChanged += OnLocationChanged;

        if (TimeDisplay is null)
        {
            TimeZoneInfo zone = OperatorTz.Zone;
            TimeDisplay = OperatorTz.IsLocal
                ? $"{zone.Id} ({OperatorTimeZone.OffsetLabel(zone.GetUtcOffset(DateTimeOffset.UtcNow))})"
                : "utc";
        }

        State ??= await LoadAsync();
        _name.Value = State.InstanceNameOverride;
        _timeout.Minutes = MinutesOf(EffectiveTimeout);
        _host.Id = State.DefaultDeployHost;

        // Resolve only once the section gates are known, so a withheld section fails closed to General.
        _active = Resolve(_location.Section);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _circuitReady = true;
            StateHasChanged();
        }

        // #344: from here on a click on a section switches in the circuit (in-place-nav.js, #312).
        if (!_attached)
        {
            _attached = true;
            _self = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("zwInPlaceNav.attach", "/settings", _self, _instance, new { subpaths = true });
        }
    }

    // The fail-closed sub-nav: a section is selectable only where the operator holds its grant.
    private string Resolve(string? requested) => State is not { } s ? "general" : requested switch
    {
        "security" => "security",
        "enrollment" when s.CanManageEnrollment => "enrollment",
        "integrations" when s.CanManageWorkshop => "integrations",
        "backups" => "backups",
        "users" when s.CanManageRoles => "users",
        "about" => "about",
        _ => "general",
    };

    private string Active(string section) => _active == section ? "active" : string.Empty;

    /// <summary>A click on a section link, or a back/forward between Settings entries, already in the address bar
    /// (in-place-nav.js). False when <paramref name="url"/> isn't Settings, and the browser then loads it.</summary>
    [JSInvokable]
    public bool NavigatedInPlace(string url)
    {
        SettingsLocation location = SettingsLocation.Parse(url);
        if (!location.IsSettingsPage)
        {
            return false;
        }

        Show(location);
        return true;
    }

    // A real navigation (an enhanced one: a click before the circuit was up). It starts before the server is asked for
    // the new page, so the page follows it here; a move to another page is left alone.
    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        SettingsLocation location = SettingsLocation.Parse(e.Location);
        if (location.IsSettingsPage)
        {
            _ = InvokeAsync(() => Show(location));
        }
    }

    private void Show(SettingsLocation location)
    {
        string section = Resolve(location.Section);
        if (section != _active)
        {
            // A save's message belongs to its section; a refresh of the same section (after a rename) keeps it.
            _saved = false;
            _error = null;
            _nameMessage = null;
            _nameError = null;
            _timeoutMessage = null;
            _hostMessage = null;
            _hostError = null;
        }

        _location = location;
        _active = section;
        StateHasChanged();
    }

    // #345: the instance name, saved through the settings service (which authorizes, validates and audits). The shell
    // around this page is static, so an enhanced refresh re-renders the sidebar with the new name; the page keeps its
    // circuit and its message.
    private async Task SaveNameAsync() => await ChangeNameAsync(_name.Value);

    private async Task ResetNameAsync() => await ChangeNameAsync(null);

    private async Task ChangeNameAsync(string? name)
    {
        _nameMessage = null;
        _nameError = null;
        _acting = true;
        try
        {
            UserId user = await CurrentUserAsync();
            await Actions.RunAsync<IControlPlaneSettingsService>((settings, ct) => settings.SetInstanceNameAsync(user, name, ct));
            State = await LoadAsync();
            _name.Value = State.InstanceNameOverride;
            _nameMessage = State.InstanceNameOverride is null
                ? $"Instance name reset to the config name \"{Instance.Value.Name}\"."
                : $"Instance name saved as \"{State.InstanceNameOverride}\".";
            _titleVersion++;
            Navigation.Refresh();
        }
        catch (ArgumentException ex)
        {
            _nameError = ex.Message.Split(" (Parameter", 2)[0];
        }
        finally
        {
            _acting = false;
        }
    }

    private async Task<SettingsState> LoadAsync()
    {
        UserId user = await CurrentUserAsync();
        return await Actions.RunAsync<SettingsQuery, SettingsState>((query, ct) => query.LoadAsync(user, ct));
    }

    private async Task SaveAsync()
    {
        _saved = false;
        _error = null;
        string entered = _input.ApiKey?.Trim() ?? string.Empty;
        _input.ApiKey = null; // never retain the entered value across the render
        _acting = true;
        try
        {
            UserId user = await CurrentUserAsync();
            await Actions.RunAsync<IWorkshopSettingsService>((workshop, ct) => workshop.SetApiKeyAsync(user, new SecretString(entered), ct));
            _saved = true;
            _savedMessage = "Search key saved. Search is now enabled.";
        }
        catch (ArgumentException)
        {
            // The service rejected the key shape; never echo what was typed.
            _error = "That does not look like a Steam Web API key. Expected 16-64 letters and digits.";
        }
        finally
        {
            State = await LoadAsync();
            _acting = false;
        }
    }

    private async Task ClearAsync()
    {
        _error = null;
        _acting = true;
        try
        {
            UserId user = await CurrentUserAsync();
            await Actions.RunAsync<IWorkshopSettingsService>((workshop, ct) => workshop.ClearApiKeyAsync(user, ct));
            State = await LoadAsync();
            _saved = true;
            _savedMessage = "Search key cleared. Search is now off; enrichment still works.";
        }
        finally
        {
            _acting = false;
        }
    }

    private async Task<UserId> CurrentUserAsync()
    {
        ClaimsPrincipal principal = (await AuthState!).User;
        return Guid.TryParse(Users.GetUserId(principal), out Guid id)
            ? UserId.FromGuid(id)
            : throw new InvalidOperationException("Authenticated request carries no user id claim.");
    }

    public async ValueTask DisposeAsync()
    {
        Navigation.LocationChanged -= OnLocationChanged;
        if (_attached)
        {
            try
            {
                await JS.InvokeVoidAsync("zwInPlaceNav.detach", _instance);
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone; the module goes with it.
            }
        }

        _self?.Dispose();
    }

