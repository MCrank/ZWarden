    private static string TlsModeLabel(TlsMode? mode) => mode switch
    {
        TlsMode.Public => "Public (Let's Encrypt at the ingress)",
        TlsMode.Private => "Private (internal CA)",
        TlsMode.ExistingReverseProxy => "Existing reverse proxy (TLS terminated upstream)",
        _ => "Not declared",
    };

    // The forwarded-headers posture is fixed at boot (F32/ADR 0035): the reference ingress terminates TLS and
    // the middleware honours the X-Forwarded-* it sends. An empty known-proxy allowlist means any upstream is
    // trusted — safe because only the ingress can reach Web (PRD §45).
    private string ForwardedSummary()
    {
        ForwardedHeadersOptions options = Forwarded.Value;
        bool honoursProto = options.ForwardedHeaders.HasFlag(ForwardedHeaders.XForwardedProto);
        if (!honoursProto)
        {
            return "Not trusted";
        }

        bool trustsAnyUpstream = options.KnownProxies.Count == 0 && options.KnownIPNetworks.Count == 0;
        return trustsAnyUpstream
            ? "Trusted from the ingress (Proto, Host, For)"
            : "Trusted from configured proxies (Proto, Host, For)";
    }

    // The application session cookie's bounded, sliding idle timeout (PRD 11): the Owner's choice (#346), else the default.
    private TimeSpan EffectiveTimeout => State?.SessionIdleTimeout ?? ControlPlaneSettings.DefaultSessionIdleTimeout;

    private string SessionSummary() => $"{SessionTimeouts.Describe(EffectiveTimeout)} (sliding)";

    private async Task SaveTimeoutAsync()
    {
        _timeoutMessage = null;
        if (!int.TryParse(_timeout.Minutes, NumberStyles.None, CultureInfo.InvariantCulture, out int minutes))
        {
            return;
        }

        _acting = true;
        try
        {
            UserId user = await CurrentUserAsync();
            await Actions.RunAsync<IControlPlaneSettingsService>(
                (settings, ct) => settings.SetSessionIdleTimeoutAsync(user, TimeSpan.FromMinutes(minutes), ct));
            State = await LoadAsync();
            _timeout.Minutes = MinutesOf(EffectiveTimeout);
            _timeoutMessage = $"Session timeout set to {SessionTimeouts.Describe(EffectiveTimeout)}. Existing sessions pick it up on their next request.";
        }
        finally
        {
            _acting = false;
        }
    }

    private async Task SaveDefaultHostAsync()
    {
        _hostMessage = null;
        _hostError = null;
        AgentId? host = AgentId.TryParse(_host.Id, out AgentId parsed) ? parsed : null;
        _acting = true;
        try
        {
            UserId user = await CurrentUserAsync();
            await Actions.RunAsync<IControlPlaneSettingsService>((settings, ct) => settings.SetDefaultDeployHostAsync(user, host, ct));
            State = await LoadAsync();
            _host.Id = State.DefaultDeployHost;
            _hostMessage = host is null ? "Deploy server has no default host." : $"Deploy server now pre-selects {DefaultHostName}.";
        }
        catch (ArgumentException)
        {
            // The host was revoked or removed between loading the page and saving.
            State = await LoadAsync();
            _hostError = "That host is no longer enrolled and enabled. Pick another.";
        }
        finally
        {
            _acting = false;
        }
    }

    private static string MinutesOf(TimeSpan timeout) => ((int)timeout.TotalMinutes).ToString(CultureInfo.InvariantCulture);
}
