@page "/settings"
@using System.Security.Claims
@using Microsoft.AspNetCore.Builder
@using Microsoft.AspNetCore.HttpOverrides
@using Microsoft.Extensions.Options
@using ZWarden.Application.Setup
@using ZWarden.Application.Workshop
@using ZWarden.Domain.Ids
@using ZWarden.Domain.Security
@using ZWarden.Domain.Setup
@using ZWarden.Infrastructure.Identity
@using ZWarden.Web.Configuration
@using ZWarden.Web.Time
@attribute [Authorize(Policy = "User.Manage")]
@rendermode InteractiveServer
@using ZWarden.Infrastructure.Tenancy
@inject IOptions<InstanceOptions> Instance
@inject IOptions<ForwardedHeadersOptions> Forwarded
@inject ActionScopeRunner Actions
@inject IOperatorTimeZoneProvider OperatorTz
@inject UserManager<ApplicationUser> Users

@* Control-plane Settings landing (#160, renamed from "Config" — per-server config stays inside Server Detail).
   Interactive (#299, ADR 0046): the Workshop key's save and clear are circuit handlers, through ActionScopeRunner.
   The page's load (TLS mode, key status, the tenant-wide card gates) runs in one action scope on the prerender and
   reaches the circuit through [PersistentState]. Gated on User.Manage, which exactly the tenant-administrator tier
   holds (Tenant Owner + Administrator) and no operational or read-only role does — that is the "Owner/Admin" gate
   the ticket asks for; enforcement is server-side (PRD 12), the shell nav merely mirrors it. General and Security
   are wired to the real, deploy-time configured values (config-as-truth: instance name, forwarded-header trust
   and session lifetime are all fixed at boot, so they are shown as status, not editable toggles). The Owner-only
   Enrollment section is gated a second time on Tenant.Enrollment.Manage so an Administrator sees the page but not
   that control; Users & roles is gated on Role.Manage. Enrollment/Backups/Users link out to where the work
   already lives rather than duplicating it here. *@

<PageTitle>Settings · ZWarden</PageTitle>

@* "on" once the circuit has rendered the page (browser tests wait for it); see ServerDetail. *@
<span hidden data-circuit="@(_circuitReady ? "on" : "off")" data-circuit-instance="@_instance"></span>

<div data-settings-page>
    <h1 class="text-2xl font-semibold tracking-tight">Settings</h1>
    <p class="mt-1 text-sm text-muted-foreground">
        Control-plane configuration for this ZWarden instance. Per-server settings live inside each server.
    </p>

    <div class="mt-6 flex max-w-3xl flex-col gap-6">
        @* General — instance identity. Instance name is deploy-time config (ZWarden:Instance:Name); the
           default new-server host has no control-plane default yet — it is chosen at registration time. *@
        <BbCard data-settings-general>
            <BbCardHeader>
                <BbCardTitle>General</BbCardTitle>
                <BbCardDescription>How this instance identifies itself.</BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <dl class="grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-[12rem_1fr]">
                    <dt class="text-sm text-muted-foreground">Instance name</dt>
                    <dd class="text-sm text-foreground" data-settings-instance-name>@Instance.Value.Name</dd>

                    <dt class="text-sm text-muted-foreground">Default new-server host</dt>
                    <dd class="text-sm text-muted-foreground">
                        Chosen per registration — <a href="/hosts" class="text-foreground underline hover:no-underline">manage hosts</a>.
                    </dd>
                </dl>
                <p class="mt-4 text-xs text-muted-foreground">
                    Set the instance name with <code class="rounded bg-muted px-1 py-0.5 font-mono">ZWarden:Instance:Name</code>
                    in configuration.
                </p>
            </BbCardContent>
        </BbCard>

        @* Security & TLS — read-only status of the boot-time security posture (F32/ADR 0035, F33, PRD 11). *@
        <BbCard data-settings-security>
            <BbCardHeader>
                <BbCardTitle>Security &amp; TLS</BbCardTitle>
                <BbCardDescription>The ingress, forwarded-header trust, and session posture.</BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <dl class="grid grid-cols-1 gap-x-6 gap-y-4 sm:grid-cols-[12rem_1fr]">
                    <dt class="text-sm text-muted-foreground">TLS deployment mode</dt>
                    <dd class="text-sm text-foreground" data-settings-tls-mode>@TlsModeLabel(State?.TlsMode)</dd>

                    <dt class="text-sm text-muted-foreground">Trust <code class="font-mono">X-Forwarded-*</code></dt>
                    <dd class="text-sm text-foreground" data-settings-forwarded>@ForwardedSummary()</dd>

                    <dt class="text-sm text-muted-foreground">Session timeout</dt>
                    <dd class="text-sm text-foreground" data-settings-session>@SessionSummary()</dd>
                </dl>
                <p class="mt-4 text-xs text-muted-foreground">
                    ZWarden does not terminate TLS itself; these reflect the deploy-time configuration and are
                    changed with the deployment, not here.
                </p>
            </BbCardContent>
        </BbCard>

        @* Time display (#211) — a per-operator, per-browser preference (stored in a cookie, not the tenant), so it
           is visible to anyone who can reach Settings. Toggling is client-side (shell.js sets/clears the cookie
           with the browser's detected zone, then reloads); the server reads the cookie to render audit/log times.
           The prerender reads it (a circuit has no request cookie) and hands it on with the rest of the load. *@
        <BbCard data-settings-time>
            <BbCardHeader>
                <BbCardTitle>Time display</BbCardTitle>
                <BbCardDescription>Show timestamps in your local time zone instead of UTC.</BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <div class="flex flex-wrap items-center gap-3">
                    <button type="button" data-shell-tz-toggle data-tz-on="@(_localTime ? "true" : "false")"
                            aria-pressed="@(_localTime ? "true" : "false")"
                            class="inline-flex items-center gap-2 rounded border border-border px-3 py-1.5 text-sm font-medium text-foreground hover:bg-muted">
                        @(_localTime ? "Switch to UTC" : "Use my local time")
                    </button>
                    <span class="text-sm text-muted-foreground" data-settings-time-status>
                        @if (_localTime)
                        {
                            <text>Showing <span class="text-foreground">@_zoneLabel</span></text>
                        }
                        else
                        {
                            <text>Showing UTC</text>
                        }
                    </span>
                </div>
                <p class="mt-3 text-xs text-muted-foreground">
                    Applies to the audit log and live server logs. Your zone is detected from this browser and stored
                    in a cookie here; CSV exports stay in UTC.
                </p>
            </BbCardContent>
        </BbCard>

        @* Host enrollment — Owner-only (Tenant.Enrollment.Manage). Links to the existing enrollment surface
           rather than duplicating token issuance here. *@
        @if (State is { CanManageEnrollment: true })
        {
            <BbCard data-settings-enrollment>
                <BbCardHeader>
                    <BbCardTitle>Host enrollment</BbCardTitle>
                    <BbCardDescription>Bring a host under management.</BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <p class="text-sm text-muted-foreground">
                        Generate a one-time enrollment token, then run the ZWarden Agent on the host with it.
                    </p>
                    <a href="/enrollment"
                       class="mt-4 inline-flex items-center gap-1.5 rounded bg-primary px-3 py-1.5 text-sm font-medium text-primary-foreground hover:opacity-90"
                       data-settings-enrollment-link>
                        Enroll host
                    </a>
                </BbCardContent>
            </BbCard>
        }

        @* Workshop search — Owner-only (Tenant.Manage). Optional, per-tenant Steam Web API key that unlocks
           free-text Workshop search (F110/ADR 0044). Names and previews work without a key; this only adds
           search. Write-only: the stored key is never echoed — only configured✓/not. Enforcement is
           server-side in IWorkshopSettingsService (PRD 12); the flag (SettingsQuery) merely mirrors the gate. *@
        @if (State is { CanManageWorkshop: true })
        {
            <BbCard data-settings-workshop>
                <BbCardHeader>
                    <BbCardTitle>Workshop search</BbCardTitle>
                    <BbCardDescription>
                        An optional Steam Web API key enables searching the Workshop. Names and previews work without one.
                    </BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <p class="text-sm @(_keyConfigured ? "text-foreground" : "text-muted-foreground")" data-settings-workshop-status>
                        @if (_keyConfigured)
                        {
                            <span>A search key is configured. Search is enabled.</span>
                        }
                        else
                        {
                            <span>No search key configured — search is off; browsing by id, names and previews still work.</span>
                        }
                    </p>

                    @if (_saved)
                    {
                        <div class="mt-3" data-settings-workshop-saved>
                            <BbAlert Variant="AlertVariant.Success" AccentBorder>
                                <BbAlertDescription>@_savedMessage</BbAlertDescription>
                            </BbAlert>
                        </div>
                    }
                    @if (_error is not null)
                    {
                        <div class="mt-3" data-settings-workshop-error>
                            <BbAlert Variant="AlertVariant.Danger" AccentBorder>
                                <BbAlertDescription>@_error</BbAlertDescription>
                            </BbAlert>
                        </div>
                    }

                    @* A form so Enter saves, as the button does. Immediate, so a click right after typing saves the
                       typed key (a BbInput otherwise reports on blur). *@
                    <EditForm class="mt-4 flex flex-wrap items-end gap-3" Model="_input" OnValidSubmit="SaveAsync">
                        <div class="flex flex-col text-sm">
                            <BbLabel For="workshop-key" Class="mb-1 text-muted-foreground">Steam Web API key</BbLabel>
                            <BbInput Id="workshop-key" Type="InputType.Password" UpdateTiming="UpdateTiming.Immediate" @bind-Value="_input.ApiKey"
                                     autocomplete="off"
                                     Placeholder="@(_keyConfigured ? "Enter a new key to replace it" : "Your steamcommunity.com/dev/apikey key")" />
                        </div>
                        <BbButton Type="ButtonType.Submit" Disabled="_acting" data-action="workshop-save">Save key</BbButton>
                    </EditForm>

                    @if (_keyConfigured)
                    {
                        <BbButton Class="mt-3" Variant="ButtonVariant.Destructive" Disabled="_acting" OnClick="ClearAsync" data-action="workshop-clear">Clear key</BbButton>
                    }

                    <p class="mt-4 text-xs text-muted-foreground">
                        Get a key at
                        <a href="https://steamcommunity.com/dev/apikey" target="_blank" rel="noreferrer"
                           class="text-foreground underline hover:no-underline">steamcommunity.com/dev/apikey</a>.
                        The key is stored encrypted and is never shown again.
                    </p>
                </BbCardContent>
            </BbCard>
        }

        @* Backups — the backup root is Agent-side, per-host config (F24); the control plane has no single
           backup path to edit, so this points at the hosts that own theirs. *@
        <BbCard data-settings-backups>
            <BbCardHeader>
                <BbCardTitle>Backups</BbCardTitle>
                <BbCardDescription>Where each host stores its world backups.</BbCardDescription>
            </BbCardHeader>
            <BbCardContent>
                <p class="text-sm text-muted-foreground">
                    The backup root is configured per host on its Agent. Manage backups from each
                    <a href="/hosts" class="text-foreground underline hover:no-underline">host</a> or server.
                </p>
            </BbCardContent>
        </BbCard>

        @* Users & roles — Owner+Admin (Role.Manage). The role/user administration backend exists (F5) but has
           no dedicated UI yet; this is the reserved entry. *@
        @if (State is { CanManageRoles: true })
        {
            <BbCard data-settings-users>
                <BbCardHeader>
                    <BbCardTitle>Users &amp; roles</BbCardTitle>
                    <BbCardDescription>Who can operate this instance, and what they can do.</BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <p class="text-sm text-muted-foreground">
                        Built-in roles (Owner, Administrator, Operator, Moderator, Viewer, Support) are seeded per
                        tenant. A dedicated user &amp; role management screen is coming in a later release.
                    </p>
                </BbCardContent>
            </BbCard>
        }
    </div>
</div>

@code {
    /// <summary>The prerender's load, handed to the circuit (#299).</summary>
    [PersistentState]
    public SettingsState? State { get; set; }

    /// <summary>The time-display preference, read from the request cookie while prerendering: whether local time is
    /// on, and the zone's label (a circuit has no request cookie to read it from).</summary>
    [PersistentState]
    public string? TimeDisplay { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    // Write-only: this only ever carries a newly-entered key; the stored key is never read back into it.
    private readonly WorkshopKeyInput _input = new();
    private readonly string _instance = Guid.NewGuid().ToString("N");
    private bool _saved;
    private string? _savedMessage;
    private string? _error;
    private bool _acting;
    private bool _circuitReady;

    private bool _keyConfigured => State?.WorkshopKeyConfigured ?? false;

    // TimeDisplay is "utc", or the local zone's label.
    private bool _localTime => TimeDisplay is { } display && display != "utc";

    private string? _zoneLabel => _localTime ? TimeDisplay : null;

    protected override async Task OnInitializedAsync()
    {
        if (TimeDisplay is null)
        {
            TimeZoneInfo zone = OperatorTz.Zone;
            TimeDisplay = OperatorTz.IsLocal
                ? $"{zone.Id} ({OperatorTimeZone.OffsetLabel(zone.GetUtcOffset(DateTimeOffset.UtcNow))})"
                : "utc";
        }

        State ??= await LoadAsync();
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _circuitReady = true;
            StateHasChanged();
        }
    }

    private async Task<SettingsState> LoadAsync()
    {
        UserId user = await CurrentUserAsync();
        return await Actions.RunAsync<SettingsQuery, SettingsState>((query, ct) => query.LoadAsync(user, ct));
    }

    private async Task SaveAsync()
    {
        _saved = false;
        _error = null;
        string entered = _input.ApiKey?.Trim() ?? string.Empty;
        _input.ApiKey = null; // never retain the entered value across the render
        _acting = true;
        try
        {
            UserId user = await CurrentUserAsync();
            await Actions.RunAsync<IWorkshopSettingsService>((workshop, ct) => workshop.SetApiKeyAsync(user, new SecretString(entered), ct));
            _saved = true;
            _savedMessage = "Search key saved. Search is now enabled.";
        }
        catch (ArgumentException)
        {
            // The service rejected the key shape; never echo what was typed.
            _error = "That does not look like a Steam Web API key. Expected 16-64 letters and digits.";
        }
        finally
        {
            State = await LoadAsync();
            _acting = false;
        }
    }

    private async Task ClearAsync()
    {
        _error = null;
        _acting = true;
        try
        {
            UserId user = await CurrentUserAsync();
            await Actions.RunAsync<IWorkshopSettingsService>((workshop, ct) => workshop.ClearApiKeyAsync(user, ct));
            State = await LoadAsync();
            _saved = true;
            _savedMessage = "Search key cleared. Search is now off; enrichment still works.";
        }
        finally
        {
            _acting = false;
        }
    }

    private async Task<UserId> CurrentUserAsync()
    {
        ClaimsPrincipal principal = (await AuthState!).User;
        return Guid.TryParse(Users.GetUserId(principal), out Guid id)
            ? UserId.FromGuid(id)
            : throw new InvalidOperationException("Authenticated request carries no user id claim.");
    }

    private sealed class WorkshopKeyInput
    {
        public string? ApiKey { get; set; }
    }


    private static string TlsModeLabel(TlsMode? mode) => mode switch
    {
        TlsMode.Public => "Public (Let's Encrypt at the ingress)",
        TlsMode.Private => "Private (internal CA)",
        TlsMode.ExistingReverseProxy => "Existing reverse proxy (TLS terminated upstream)",
        _ => "Not declared",
    };

    // The forwarded-headers posture is fixed at boot (F32/ADR 0035): the reference ingress terminates TLS and
    // the middleware honours the X-Forwarded-* it sends. An empty known-proxy allowlist means any upstream is
    // trusted — safe because only the ingress can reach Web (PRD §45).
    private string ForwardedSummary()
    {
        ForwardedHeadersOptions options = Forwarded.Value;
        bool honoursProto = options.ForwardedHeaders.HasFlag(ForwardedHeaders.XForwardedProto);
        if (!honoursProto)
        {
            return "Not trusted";
        }

        bool trustsAnyUpstream = options.KnownProxies.Count == 0 && options.KnownIPNetworks.Count == 0;
        return trustsAnyUpstream
            ? "Trusted from the ingress (Proto, Host, For)"
            : "Trusted from configured proxies (Proto, Host, For)";
    }

    // The application session cookie's bounded, sliding lifetime (PRD 11), read from the single source of truth.
    private static string SessionSummary()
    {
        TimeSpan lifetime = IdentityAuthenticationServiceCollectionExtensions.SessionLifetime;
        string hours = lifetime.TotalHours is var h && h == Math.Floor(h)
            ? $"{(int)h} hour{((int)h == 1 ? "" : "s")}"
            : $"{lifetime.TotalHours:0.#} hours";
        return $"{hours} (sliding)";
    }
}
