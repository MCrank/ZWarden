@using ZWarden.Application.Players
@using ZWarden.Domain.Ids
@implements IDisposable
@inject IPlayerRosterCache Rosters

@* The live roster panel (F19), a child of the interactive Server Detail page's Players section (#299), mirroring
   LiveServerPanel. The page does the authorized, tenant-filtered work; this child only reads the process-local,
   ownership-guarded roster cache (keyed by ServerId + owning AgentId), so it needs no tenant context. It refreshes
   once per second and shows the newest roster a ListPlayers Operation observed. Usernames are untrusted PZ output
   and rendered as data (trust-boundaries.md §8). *@

<div data-live-roster>
    @if (_roster is { } roster)
    {
        <div class="flex items-baseline justify-between gap-3">
            <span class="text-sm font-medium" data-roster-count>@roster.Count connected</span>
            <span class="text-xs text-muted-foreground tabular-nums">as of @Observed(roster.ObservedAt)</span>
        </div>
        @if (roster.Players.Count > 0)
        {
            @* BbItemGroup does not splat attributes, so the data-roster-list hook rides a wrapper div; BbItem does splat
               (data-roster-player). Matches the mod-manage BbItem lists on the parent page (#121). *@
            <div data-roster-list>
                <BbItemGroup Class="mt-3">
                    @foreach (string player in roster.Players)
                    {
                        <BbItem Variant="ItemVariant.Outline" Size="ItemSize.Sm" data-roster-player>
                            <BbItemContent>
                                <BbItemTitle><span class="font-mono text-sm">@player</span></BbItemTitle>
                            </BbItemContent>
                        </BbItem>
                    }
                </BbItemGroup>
            </div>
        }
        else
        {
            <p class="mt-3 text-sm text-muted-foreground">No players are connected.</p>
        }
    }
    else
    {
        <p class="text-sm text-muted-foreground" data-roster-awaiting>No roster yet — use Refresh to enumerate the connected players.</p>
    }
</div>

@code {
    /// <summary>The Server.</summary>
    [Parameter]
    [EditorRequired]
    public ServerId ServerId { get; set; }

    /// <summary>The Server's owning Agent (the cache ownership-guard key).</summary>
    [Parameter]
    [EditorRequired]
    public AgentId AgentId { get; set; }

    private PlayerRoster? _roster;
    private PeriodicTimer? _timer;
    private Task? _loop;

    protected override void OnInitialized()
    {
        Refresh();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _loop = RunAsync();
    }

    private async Task RunAsync()
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync().ConfigureAwait(false))
            {
                Refresh();
                await InvokeAsync(StateHasChanged).ConfigureAwait(false);
            }
        }
        catch (ObjectDisposedException)
        {
            // The panel was disposed while awaiting the next tick — expected on navigation away.
        }
    }

    private void Refresh() => _roster = Rosters.GetLatest(ServerId, AgentId);

    private static string Observed(DateTimeOffset at) =>
        at.UtcDateTime.ToString("HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture) + " UTC";

    public void Dispose() => _timer?.Dispose();
}
