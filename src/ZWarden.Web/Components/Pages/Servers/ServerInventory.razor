@page "/servers"
@attribute [Authorize]
@using System.Security.Claims
@using ZWarden.Application.Agents
@using ZWarden.Application.Authorization
@using ZWarden.Application.Operations
@using ZWarden.Domain.Authorization
@using ZWarden.Domain.Ids
@using ZWarden.Domain.Operations
@using ZWarden.Web.Components.Servers
@inject IServerInventory Inventory
@inject IOperationStore OperationStore
@inject IServerMetricsCache Metrics
@inject IAgentConnectionRegistry Connections
@inject IServerDiscoveryCache Discovery
@inject IPermissionChecker PermissionChecker
@inject UserManager<ApplicationUser> Users
@inject NavigationManager Nav
@inject TimeProvider Clock

@* The Fleet board (#158; /servers, where / resolves). Static server render (no @rendermode on the page) like
   /audit: it runs per request with a live HttpContext so the session-derived tenant resolves and the read is
   tenant-filtered. Gated by [Authorize] (authenticated) rather than a server-scoped Server.View policy, which
   with no resource denies outright (ADR 0018) — the inventory self-filters to the Servers the caller may view,
   fail-closed. The KPI strip, degraded banner and the Register/Import forms are static SSR; only the fleet
   TABLE is an interactive island (FleetBoard) for sort + row-click. The first render reads the ownership-guarded
   metrics cache here (this render has the owning AgentId); from then on live-status.js polls the batched status
   endpoint and updates the Status badges (#253), the fact cells and the Running / Needs attention / Players
   tiles (#257) in place. Lifecycle controls moved to Server Detail with the redesign (#162); this
   board is display + navigate + deploy. All Agent-reported text is untrusted and rendered as data (§3/§8). *@

<PageTitle>Fleet — ZWarden</PageTitle>

<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
    <h1 class="text-2xl font-semibold tracking-tight">Fleet</h1>
    <p class="text-sm text-muted-foreground">
        @_servers.Count @(_servers.Count == 1 ? "server" : "servers") · @_hostsTotal @(_hostsTotal == 1 ? "host" : "hosts")
    </p>
</div>
<p class="mt-1 text-sm text-muted-foreground">
    Your fleet of managed Project Zomboid servers, filtered to those you may view. State is the last the managing
    Agent reported.
</p>

@if (_offlineHosts.Count > 0)
{
    @* Degraded banner — driven by the live F10 connection registry over the owning Agents of the visible fleet
       (no Agent.View needed; derived from Servers the caller can already see). *@
    <div class="mt-4" data-degraded-banner>
        <BbAlert Variant="AlertVariant.Warning" AccentBorder>
            <BbAlertDescription>
                @if (_offlineHosts.Count == 1)
                {
                    <text>ZWarden.Agent on <span class="font-mono">@_offlineHosts[0]</span> is unreachable — its servers show their last-known state while it reconnects.</text>
                }
                else
                {
                    <text>@_offlineHosts.Count Agents are unreachable — their servers show their last-known state while they reconnect.</text>
                }
            </BbAlertDescription>
        </BbAlert>
    </div>
}

@* KPI strip on the Blueprint BbCard surface (ADR 0003 seam): the card chrome (border, radius, bg-card) comes
   from the component; only the compact stat layout is ZWarden's. Reflows 2-up on narrow, 4-up from sm. *@
<div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4" data-kpi-strip>
    <BbCard Class="p-4" data-kpi="running">
        <div class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Running</div>
        <div class="mt-1 font-mono text-2xl tabular-nums text-status-running" data-kpi-value>@_kpis.Running</div>
        <div class="mt-0.5 text-xs text-muted-foreground">of @_servers.Count @(_servers.Count == 1 ? "server" : "servers")</div>
    </BbCard>
    <BbCard Class="p-4" data-kpi="needs-attention">
        <div class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Needs attention</div>
        <div class="mt-1 font-mono text-2xl tabular-nums @(_kpis.NeedsAttention > 0 ? "text-status-unhealthy" : "text-foreground")" data-kpi-value>@_kpis.NeedsAttention</div>
        @* live-status.js rebuilds this line with the same three phrasings (#257). *@
        <div class="mt-0.5 truncate text-xs text-muted-foreground" data-kpi-sub>@(_kpis.NeedsAttention == 0 ? "all healthy" : (_kpis.AttentionName is { Length: > 0 } name ? $"{name} · unhealthy" : "unhealthy"))</div>
    </BbCard>
    <BbCard Class="p-4" data-kpi="players">
        <div class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Players online</div>
        <div class="mt-1 font-mono text-2xl tabular-nums text-foreground" data-kpi-value>@(_kpis.PlayersOnline?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? FleetFacts.Dash)</div>
        <div class="mt-0.5 text-xs text-muted-foreground">across the fleet</div>
    </BbCard>
    <BbCard Class="p-4" data-kpi="hosts">
        <div class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Hosts</div>
        <div class="mt-1 font-mono text-2xl tabular-nums text-foreground">@_hostsOnline<span class="text-muted-foreground">/@_hostsTotal</span></div>
        <div class="mt-0.5 text-xs text-muted-foreground">@(_offlineHosts.Count == 0 ? "all connected" : $"{_offlineHosts.Count} unreachable")</div>
    </BbCard>
</div>

@* The fleet table is the page's one interactive island (sort + row-click), reading only the rows projected
   above — no tenant-scoped service in the circuit (ADR 0040). Prerenders with the rows so the URLs and first
   paint are server-rendered. #253: data-live-fleet names the batched, Server.View-filtered status endpoint
   live-status.js polls to re-tone each row's badge in place (a stop, a restart, a boot) — no reload. *@
<div class="mt-6" data-live-fleet="/api/servers/status" data-status-busy="@(_anyBusy ? "true" : "false")">
    <FleetBoard @rendermode="InteractiveServer" Rows="_rows" />
</div>

@if (_canRegister)
{
    <section class="mt-10">
        <h2 class="text-lg font-semibold tracking-tight">Register a new server</h2>
        <p class="mt-1 text-sm text-muted-foreground">
            Provision a fresh Project Zomboid container on a connected host. The server appears immediately and
            starts once its Agent has built the container.
        </p>

        @if (_registerMessage is not null)
        {
            <div class="mt-3" data-register-message>
                <BbAlert Variant="AlertVariant.Warning" AccentBorder>
                    <BbAlertDescription>@_registerMessage</BbAlertDescription>
                </BbAlert>
            </div>
        }

        @if (_knownAgents.Count == 0)
        {
            <p class="mt-3 text-sm text-muted-foreground" data-no-hosts>
                No connected hosts. A host appears here once its Agent connects and reports in.
            </p>
        }
        else
        {
            <EditForm Model="_registerForm" FormName="register-server" OnValidSubmit="RegisterAsync" class="mt-4 flex flex-wrap items-end gap-3">
                <DataAnnotationsValidator />
                <div class="flex flex-col text-sm">
                    <BbLabel For="register-host" Class="mb-1 text-muted-foreground">Host</BbLabel>
                    @* Explicit Name for static-SSR binding — see the import form below (issue #84). *@
                    <BbNativeSelect TValue="string" Id="register-host" Name="_registerForm.AgentId" @bind-Value="_registerForm!.AgentId" Placeholder="Select…">
                        @foreach (AgentId agent in _knownAgents)
                        {
                            <option value="@agent">@agent</option>
                        }
                    </BbNativeSelect>
                </div>
                <div class="flex flex-col text-sm">
                    <BbLabel For="register-name" Class="mb-1 text-muted-foreground">Name</BbLabel>
                    <BbInput Id="register-name" @bind-Value="_registerForm!.Name" />
                </div>
                <BbButton Type="ButtonType.Submit">Deploy server</BbButton>
            </EditForm>
        }
    </section>

    <section class="mt-10">
        <h2 class="text-lg font-semibold tracking-tight">Import a discovered container</h2>
        <p class="mt-1 text-sm text-muted-foreground">
            Canonical containers an Agent has reported that are not yet registered. Adopting one brings it
            under management as a Server.
        </p>

        @if (_importMessage is not null)
        {
            <div class="mt-3" data-import-message>
                <BbAlert Variant="AlertVariant.Warning" AccentBorder>
                    <BbAlertDescription>@_importMessage</BbAlertDescription>
                </BbAlert>
            </div>
        }

        @if (_discovered.Count == 0)
        {
            <p class="mt-3 text-sm text-muted-foreground" data-discovered-empty>
                No unregistered containers discovered. They appear here once a connected Agent reports them.
            </p>
        }
        else
        {
            @* Blueprint form primitives over the seam (ADR 0003) — the SSR-safe subset (BbNativeSelect/BbInput/
               BbButton render real named form controls that participate in the static POST; see issue #84). *@
            <EditForm Model="_form" FormName="import-server" OnValidSubmit="ImportAsync" class="mt-4 flex flex-wrap items-end gap-3">
                <DataAnnotationsValidator />
                <div class="flex flex-col text-sm">
                    <BbLabel For="import-target" Class="mb-1 text-muted-foreground">Discovered container</BbLabel>
                    @* BbNativeSelect auto-derives only the leaf field name ("Target"); under static SSR the POST
                       binds by the full model path, so Name is set explicitly (issue #84 exemplar note). *@
                    <BbNativeSelect TValue="string" Id="import-target" Name="_form.Target" @bind-Value="_form!.Target" Placeholder="Select…">
                        @foreach (DiscoveredServerOnAgent d in _discovered)
                        {
                            <option value="@($"{d.AgentId}|{d.ServerId}")">@d.ServerId (@d.RunState on @d.AgentId)</option>
                        }
                    </BbNativeSelect>
                </div>
                <div class="flex flex-col text-sm">
                    <BbLabel For="import-name" Class="mb-1 text-muted-foreground">Name</BbLabel>
                    <BbInput Id="import-name" @bind-Value="_form!.Name" />
                </div>
                <BbButton Type="ButtonType.Submit">Import</BbButton>
            </EditForm>
        }
    </section>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    [SupplyParameterFromForm(FormName = "import-server")]
    private ImportModel? _form { get; set; }

    [SupplyParameterFromForm(FormName = "register-server")]
    private RegisterModel? _registerForm { get; set; }

    private IReadOnlyList<ServerSummary> _servers = [];
    private IReadOnlyList<FleetRow> _rows = [];
    private IReadOnlyList<DiscoveredServerOnAgent> _discovered = [];
    private IReadOnlyList<AgentId> _knownAgents = [];
    private IReadOnlyList<AgentId> _offlineHosts = [];
    private bool _canRegister;
    private bool _anyBusy;
    private FleetKpis _kpis = new(0, 0, null, null);
    private int _hostsTotal;
    private int _hostsOnline;
    private string? _importMessage;
    private string? _registerMessage;

    protected override async Task OnInitializedAsync()
    {
        _form ??= new ImportModel();
        _registerForm ??= new RegisterModel();
        UserId user = await CurrentUserAsync();

        _servers = await Inventory.ListVisibleAsync(user);

        // Project each Server into a serializable row, overlaying the ownership-guarded metrics cache (keyed by the
        // Server's owning Agent, which this authorized load knows). A missing sample renders as — in the island.
        // Each row's Status is resolved against the in-flight mutating Operations — one read for the whole fleet
        // (#253) — so a load mid-restart already says RESTARTING; live-status.js keeps it current from there.
        IReadOnlyDictionary<ServerId, Operation> activeByServer = ServerLiveStatus.ActiveByServer(
            _servers.Count == 0 ? [] : await OperationStore.ListActiveAsync());
        // #257: the fleet facts (players, uptime, version, meters) come from the one FleetFacts projection the
        // status poll also uses, so the first render and the live updates agree.
        DateTimeOffset now = Clock.GetUtcNow();
        List<FleetRow> rows = new(_servers.Count);
        List<(ServerSummary, FleetServerFacts)> fleet = new(_servers.Count);
        foreach (ServerSummary server in _servers)
        {
            ServerMetrics? sample = Metrics.GetLatest(server.Id, server.AgentId);
            FleetServerFacts facts = FleetFacts.For(server, sample, Connections.IsConnected(server.AgentId));
            fleet.Add((server, facts));
            ServerStatusView status = ServerLiveStatus.Resolve(server.LastRunState, server.Id, activeByServer);
            _anyBusy |= status.Busy;
            rows.Add(new FleetRow(
                server.Id.ToString(),
                server.Name,
                server.Description,
                server.AgentId.ToString(),
                server.LastRunState,
                status.Label,
                status.Tone,
                facts.Version ?? FleetFacts.Dash,
                facts.CpuPercent,
                facts.MemoryUsedBytes,
                facts.MemoryLimitBytes,
                facts.Players,
                facts.PlayersSampledAt is { } counted ? FleetFacts.FormatSampleAge(counted, now) : null,
                FleetFacts.FormatUptime(facts.StartedAt, now)));
        }

        _rows = rows;

        // Running / Needs attention (a fatal or impaired health rollup, or a failed run-state) / Players online —
        // live-status.js recomputes the same tiles from the poll (#257). The attention name is untrusted data.
        _kpis = FleetFacts.Kpis(fleet);

        // Hosts (online/total): the distinct owning Agents of the visible fleet, "online" per the live F10
        // registry. Deriving from visible Servers keeps this fail-closed and needs no Agent.View (ADR 0018).
        List<AgentId> agents = _servers.Select(s => s.AgentId).Distinct().ToList();
        _hostsTotal = agents.Count;
        _offlineHosts = agents.Where(a => !Connections.IsConnected(a)).ToList();
        _hostsOnline = _hostsTotal - _offlineHosts.Count;

        _canRegister = (await PermissionChecker.EvaluateAsync(user, Permissions.ServerRegister)).IsAllowed;
        if (_canRegister)
        {
            _discovered = await Inventory.ListAllDiscoveredUnregisteredAsync();
            _knownAgents = [.. Discovery.KnownAgents()];
        }
    }

    private async Task ImportAsync()
    {
        UserId user = await CurrentUserAsync();
        ImportModel form = _form ?? new ImportModel();
        if (string.IsNullOrWhiteSpace(form.Target) || string.IsNullOrWhiteSpace(form.Name))
        {
            _importMessage = "Choose a discovered container and a name.";
            return;
        }

        string[] parts = form.Target.Split('|');
        if (parts.Length != 2
            || !AgentId.TryParse(parts[0], out AgentId agentId)
            || !ServerId.TryParse(parts[1], out ServerId serverId))
        {
            _importMessage = "That selection is no longer valid.";
            return;
        }

        ServerImportResult result = await Inventory.ImportAsync(user, agentId, serverId, form.Name.Trim());
        if (result.Succeeded)
        {
            // Redirect after post so a refresh does not re-submit and the new Server shows in the table.
            Nav.NavigateTo("/servers");
            return;
        }

        _importMessage = result.Failure switch
        {
            ServerImportFailure.NotAuthorized => "You are not permitted to register servers.",
            ServerImportFailure.AgentNotFound => "That host is no longer known.",
            ServerImportFailure.NotDiscovered => "That container is no longer discovered.",
            _ => "The import could not be completed.",
        };
    }

    private async Task RegisterAsync()
    {
        UserId user = await CurrentUserAsync();
        RegisterModel form = _registerForm ?? new RegisterModel();
        if (string.IsNullOrWhiteSpace(form.AgentId) || string.IsNullOrWhiteSpace(form.Name))
        {
            _registerMessage = "Choose a host and a name.";
            return;
        }

        if (!AgentId.TryParse(form.AgentId, out AgentId agentId))
        {
            _registerMessage = "That host selection is no longer valid.";
            return;
        }

        ServerRegisterResult result = await Inventory.RegisterAsync(user, agentId, form.Name.Trim());
        if (result.Succeeded)
        {
            // Redirect after post so a refresh does not re-submit; the new server shows in Unknown state
            // and starts once its Agent provisions the container.
            Nav.NavigateTo("/servers");
            return;
        }

        _registerMessage = result.Failure switch
        {
            ServerRegisterFailure.NotAuthorized => "You are not permitted to register servers.",
            ServerRegisterFailure.AgentNotFound => "That host is no longer known.",
            _ => "The server could not be registered.",
        };
    }

    private async Task<UserId> CurrentUserAsync()
    {
        ClaimsPrincipal principal = (await AuthState!).User;
        return Guid.TryParse(Users.GetUserId(principal), out Guid id)
            ? UserId.FromGuid(id)
            : throw new InvalidOperationException("Authenticated request carries no user id claim.");
    }

    private sealed class ImportModel
    {
        public string? Target { get; set; }

        public string? Name { get; set; }
    }

    private sealed class RegisterModel
    {
        public string? AgentId { get; set; }

        public string? Name { get; set; }
    }
}
