@page "/servers"
@attribute [Authorize]
@using System.Security.Claims
@using ZWarden.Application.Agents
@using ZWarden.Application.Authorization
@using ZWarden.Application.Mods
@using ZWarden.Application.Operations
@using ZWarden.Domain.Authorization
@using ZWarden.Domain.Ids
@using ZWarden.Domain.Operations
@using ZWarden.Web.Components.Hosts
@using ZWarden.Web.Components.Servers
@inject IServerInventory Inventory
@inject IHostCapacityCache HostCapacity
@inject IOperationStore OperationStore
@inject IServerMetricsCache Metrics
@inject IAgentConnectionRegistry Connections
@inject IAgentInventory AgentInventory
@inject IPermissionChecker PermissionChecker
@inject IServerModOverviewService ModOverview
@inject UserManager<ApplicationUser> Users
@inject NavigationManager Nav
@inject TimeProvider Clock

@* The Fleet board (#158; /servers, where / resolves). Static server render (no @rendermode on the page) like
   /audit: it runs per request with a live HttpContext so the session-derived tenant resolves and the read is
   tenant-filtered. Gated by [Authorize] (authenticated) rather than a server-scoped Server.View policy, which
   with no resource denies outright (ADR 0018) — the inventory self-filters to the Servers the caller may view,
   fail-closed. The KPI strip and degraded banner are static SSR; the fleet TABLE (FleetBoard: sort + row-click),
   the Deploy server sheet (#338) and the adopt callout (#339) are interactive islands. The first render reads the
   ownership-guarded metrics cache here (this render has the owning AgentId); from then on live-status.js polls
   the batched status endpoint and updates the Status badges (#253), the fact cells and the Running / Needs
   attention / Players tiles (#257) in place. Lifecycle controls moved to Server Detail with the redesign (#162); this
   board is display + navigate + deploy. All Agent-reported text is untrusted and rendered as data (§3/§8). *@

<ShellTitle Title="Fleet" />

<div class="flex flex-wrap items-center gap-x-3 gap-y-2">
    <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <h1 class="text-2xl font-semibold tracking-tight">Fleet</h1>
        <p class="text-sm text-muted-foreground">
            @_servers.Count @(_servers.Count == 1 ? "server" : "servers") · <span data-fleet-hosts-count>@_hosts.Total @(_hosts.Total == 1 ? "host" : "hosts")</span>
        </p>
    </div>
    @if (_canRegister)
    {
        @* #338: the Deploy server button + sheet, an interactive island; ?deploy=1 opens it (as ?add=1 on Mods). *@
        <div class="ml-auto" data-deploy-server>
            <DeployServerSheet @rendermode="InteractiveServer" OpenOnLoad="@(Deploy == "1" || Adopt == "1")" StartOnAdopt="@(Adopt == "1")" />
        </div>
    }
</div>
<p class="mt-1 text-sm text-muted-foreground">
    Your fleet of managed Project Zomboid servers, filtered to those you may view. State is the last the managing
    Agent reported.
</p>

@if (_canRegister)
{
    @* #339: the adopt callout, shown while a Host reports containers with no Server record (Server.Register only). #357:
       always rendered for such a caller — empty at zero — because it re-reads the counts itself, so containers an Agent
       reports on reconnect show up without a reload. *@
    <UnmanagedBanner @rendermode="InteractiveServer" Hosts="_unmanaged" />
}

@* Degraded banner — driven by the live F10 connection registry over the owning Agents of the visible fleet (no
   Agent.View needed; derived from Servers the caller can already see). #357: always in the page, hidden while every
   Host is connected; live-status.js polls data-live-fleet-hosts and switches it between the one-Host and the
   many-Hosts wording (names and counts by textContent — they are untrusted, observed strings). *@
<div class="mt-4" data-degraded-banner hidden="@(_hosts.Unreachable.Count == 0)">
    <BbAlert Variant="AlertVariant.Warning" AccentBorder>
        <BbAlertDescription>
            <span data-degraded-one hidden="@(_hosts.Unreachable.Count != 1)">ZWarden.Agent on <span class="font-mono" data-degraded-host>@(_hosts.Unreachable.Count == 1 ? _hosts.Unreachable[0] : "")</span> is unreachable — its servers show their last-known state while it reconnects.</span>
            <span data-degraded-many hidden="@(_hosts.Unreachable.Count < 2)" title="@string.Join(", ", _hosts.Unreachable)"><span data-degraded-count>@_hosts.Unreachable.Count</span> Agents are unreachable — their servers show their last-known state while they reconnect.</span>
        </BbAlertDescription>
    </BbAlert>
</div>

@* KPI strip on the Blueprint BbCard surface (ADR 0003 seam): the card chrome (border, radius, bg-card) comes
   from the component; only the compact stat layout is ZWarden's. Reflows 2-up on narrow, 4-up from sm. *@
<div class="mt-6 grid grid-cols-2 gap-3 sm:grid-cols-4" data-kpi-strip data-live-fleet-hosts="/api/fleet/hosts">
    <BbCard Class="p-4" data-kpi="running">
        <div class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Running</div>
        <div class="mt-1 font-mono text-2xl tabular-nums text-status-running" data-kpi-value>@_kpis.Running</div>
        <div class="mt-0.5 text-xs text-muted-foreground">of @_servers.Count @(_servers.Count == 1 ? "server" : "servers")</div>
    </BbCard>
    <BbCard Class="p-4" data-kpi="needs-attention">
        <div class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Needs attention</div>
        <div class="mt-1 font-mono text-2xl tabular-nums @(_kpis.NeedsAttention > 0 ? "text-status-unhealthy" : "text-foreground")" data-kpi-value>@_kpis.NeedsAttention</div>
        @* live-status.js rebuilds this line with the same three phrasings (#257). *@
        <div class="mt-0.5 truncate text-xs text-muted-foreground" data-kpi-sub>@(_kpis.NeedsAttention == 0 ? "all healthy" : (_kpis.AttentionName is { Length: > 0 } name ? $"{name} · unhealthy" : "unhealthy"))</div>
    </BbCard>
    <BbCard Class="p-4" data-kpi="players">
        <div class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Players online</div>
        <div class="mt-1 font-mono text-2xl tabular-nums text-foreground" data-kpi-value>@(_kpis.PlayersOnline?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? FleetFacts.Dash)</div>
        <div class="mt-0.5 text-xs text-muted-foreground">across the fleet</div>
    </BbCard>
    <BbCard Class="p-4" data-kpi="hosts">
        <div class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Hosts</div>
        <div class="mt-1 font-mono text-2xl tabular-nums text-foreground"><span data-hosts-online>@_hosts.Online</span><span class="text-muted-foreground">/<span data-hosts-total>@_hosts.Total</span></span></div>
        @* live-status.js rebuilds this line with the same two phrasings (#357). *@
        <div class="mt-0.5 text-xs text-muted-foreground" data-kpi-sub>@(_hosts.Unreachable.Count == 0 ? "all connected" : $"{_hosts.Unreachable.Count} unreachable")</div>
    </BbCard>
</div>

@* The fleet table is the page's one interactive island (sort + row-click), reading only the rows projected
   above — no tenant-scoped service in the circuit (ADR 0040). Prerenders with the rows so the URLs and first
   paint are server-rendered. #253: data-live-fleet names the batched, Server.View-filtered status endpoint
   live-status.js polls to re-tone each row's badge in place (a stop, a restart, a boot) — no reload. #340: for a caller
   who may view Hosts, data-live-hosts names the Agent.View-gated host telemetry endpoint that moves each Host row's
   CPU / Memory meters (the /hosts cards' feed). *@
<div class="mt-6" data-live-fleet="/api/servers/status" data-live-hosts="@(_canViewHosts ? "/api/hosts/telemetry" : null)"
     data-status-busy="@(_anyBusy ? "true" : "false")">
    <FleetBoard @rendermode="InteractiveServer" Nodes="_nodes" />
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    /// <summary><c>?deploy=1</c> opens the Deploy server sheet (#338).</summary>
    [SupplyParameterFromQuery(Name = "deploy")]
    private string? Deploy { get; set; }

    /// <summary><c>?adopt=1</c> opens it on Adopt existing (#339).</summary>
    [SupplyParameterFromQuery(Name = "adopt")]
    private string? Adopt { get; set; }

    private IReadOnlyList<ServerSummary> _servers = [];
    private List<FleetNode> _nodes = [];
    private List<UnmanagedHost> _unmanaged = [];
    private FleetHostsSummary _hosts = new(0, 0, []);
    private bool _canRegister;
    private bool _anyBusy;
    private FleetKpis _kpis = new(0, 0, null, null);
    private IReadOnlyDictionary<AgentId, string> _hostNames = new Dictionary<AgentId, string>();
    private bool _canViewHosts;

    protected override async Task OnInitializedAsync()
    {
        UserId user = await CurrentUserAsync();

        _servers = await Inventory.ListVisibleAsync(user);

        // #336: Hosts are named (Label, else Hostname) only for a caller who may view Hosts; anyone else sees each
        // Host's short id — the fleet never widens authorization (D3).
        _canViewHosts = (await PermissionChecker.EvaluateAsync(user, Permissions.AgentView)).IsAllowed;
        if (_canViewHosts)
        {
            _hostNames = (await AgentInventory.ListHostsAsync(user))
                .ToDictionary(h => h.Id, h => HostNames.Display(h.Id, h.Label, h.Hostname));
        }

        // Project each Server into a serializable row, overlaying the ownership-guarded metrics cache (keyed by the
        // Server's owning Agent, which this authorized load knows). A missing sample renders as — in the island.
        // Each row's Status is resolved against the in-flight mutating Operations — one read for the whole fleet
        // (#253) — so a load mid-restart already says RESTARTING; live-status.js keeps it current from there.
        IReadOnlyDictionary<ServerId, Operation> activeByServer = ServerLiveStatus.ActiveByServer(
            _servers.Count == 0 ? [] : await OperationStore.ListActiveAsync());
        // #257: the fleet facts (players, uptime, version, meters) come from the one FleetFacts projection the
        // status poll also uses, so the first render and the live updates agree.
        DateTimeOffset now = Clock.GetUtcNow();
        // #275 D5/D7: the "N mod updates" hint, for running servers only (a start pulls updates anyway), counted once
        // at load from the persisted mod state; Mod.View is re-checked per Server by the service.
        IReadOnlyDictionary<ServerId, int> modUpdates = await ModOverview.CountUpdatesReadyAsync(
            user, [.. _servers.Where(s => s.LastRunState == ServerRunState.Running).Select(s => s.Id)]);
        List<(AgentId, FleetRow)> rows = new(_servers.Count);
        List<(ServerSummary, FleetServerFacts)> fleet = new(_servers.Count);
        foreach (ServerSummary server in _servers)
        {
            ServerMetrics? sample = Metrics.GetLatest(server.Id, server.AgentId);
            FleetServerFacts facts = FleetFacts.For(server, sample, Connections.IsConnected(server.AgentId));
            fleet.Add((server, facts));
            ServerStatusView status = ServerLiveStatus.Resolve(server.LastRunState, server.Id, activeByServer);
            _anyBusy |= status.Busy;
            rows.Add((server.AgentId, new FleetRow(
                server.Id.ToString(),
                server.Name,
                server.Description,
                server.LastRunState,
                status.Label,
                status.Tone,
                facts.Version ?? FleetFacts.Dash,
                facts.CpuPercent,
                facts.MemoryUsedBytes,
                facts.MemoryLimitBytes,
                facts.Players,
                facts.PlayersSampledAt is { } counted ? FleetFacts.FormatSampleAge(counted, now) : null,
                FleetFacts.FormatUptime(facts.StartedAt, now),
                FleetFacts.FormatVersionTitle(facts),
                server.Branch,
                modUpdates.GetValueOrDefault(server.Id),
                facts.MaxPlayers)));
        }

        // #340: every Server under its Host's rollup row; a Server whose Agent the caller may view but which is gone
        // from the Host list (deleted) goes in the Unassigned group.
        // #342 live pass: a Host with no Servers yet (just enrolled) still gets its row, for a caller who may view Hosts.
        _nodes = FleetTree.Build(rows, agent => HostInfo(agent, now), _hostNames.Keys);

        // Running / Needs attention (a fatal or impaired health rollup, or a failed run-state) / Players online —
        // live-status.js recomputes the same tiles from the poll (#257). The attention name is untrusted data.
        _kpis = FleetFacts.Kpis(fleet);

        // Hosts (online/total): the distinct owning Agents of the visible fleet, "online" per the live F10
        // registry. Deriving from visible Servers keeps this fail-closed and needs no Agent.View (ADR 0018).
        // A caller who may view Hosts also counts the Hosts with no Servers yet (#342), as /hosts does. #357: the same
        // projection as /api/fleet/hosts, which live-status.js polls to keep the banner and the tile current.
        _hosts = FleetHosts.Summarize(_servers, _hostNames.Keys, HostName, Connections.IsConnected);

        _canRegister = (await PermissionChecker.EvaluateAsync(user, Permissions.ServerRegister)).IsAllowed;
        if (_canRegister)
        {
            // #339: per-host counts for the adopt callout (this tenant's Hosts only), by the Host's name (#336); the
            // island re-reads them while the page is open (#357).
            _unmanaged = UnmanagedHost.From(await Inventory.ListUnmanagedHostsAsync(user));
        }
    }

    // A Host's operator-facing name (#336): its Label or Hostname when the caller may view Hosts, else its short id.
    // Both names are untrusted, observed strings (rendered as data).
    private string HostName(AgentId agent) =>
        _hostNames.TryGetValue(agent, out string? name) ? name : HostNames.ShortId(agent);

    // A Host row's facts (#340). Without Agent.View every Agent is named by its short id and shows no telemetry — the
    // fleet never widens authorization (#336 D3); with it, an Agent not in the caller's Host list is unknown (null).
    private FleetHostInfo? HostInfo(AgentId agent, DateTimeOffset now)
    {
        bool connected = Connections.IsConnected(agent);
        if (!_canViewHosts)
        {
            return new FleetHostInfo(HostNames.ShortId(agent), connected, null, Identified: false);
        }

        return _hostNames.TryGetValue(agent, out string? name)
            ? new FleetHostInfo(name, connected, HostTelemetry.For(HostCapacity.GetLatest(agent), connected, now))
            : null;
    }

    private async Task<UserId> CurrentUserAsync()
    {
        ClaimsPrincipal principal = (await AuthState!).User;
        return Guid.TryParse(Users.GetUserId(principal), out Guid id)
            ? UserId.FromGuid(id)
            : throw new InvalidOperationException("Authenticated request carries no user id claim.");
    }
}
