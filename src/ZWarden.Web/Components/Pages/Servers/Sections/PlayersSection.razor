@inherits ServerSectionBase
@using ZWarden.Application.Players

@* The Players rail section (F19): the live roster panel plus the player actions, gated per control on the
   per-server Player.* / Server.Configuration.Edit grants the page evaluates; the service re-checks on every action.
   Usernames are untrusted Agent text, rendered as data. Each button is a circuit handler (#299). *@

<BbCard Class="p-5" data-players-card>
    <h2 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">Players</h2>

    @if (_playerMessage is not null)
    {
        <div class="mt-3" data-player-message>
            <BbAlert Variant="AlertVariant.Warning" AccentBorder>
                <BbAlertDescription>@_playerMessage</BbAlertDescription>
            </BbAlert>
        </div>
    }

    <div class="mt-4">
        @if (Perm.CanView)
        {
            <div class="flex items-center justify-between gap-3">
                <h3 class="text-sm font-medium">Connected players</h3>
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Disabled="_acting"
                          OnClick="@(() => ActionAsync("refresh"))" data-action="refresh">Refresh</BbButton>
            </div>
            <div class="mt-3">
                <LivePlayerRosterPanel ServerId="@Server.Id.ToString()" AgentId="@Server.AgentId.ToString()" />
            </div>
        }

        @if (Perm.CanKick || Perm.CanBan || Perm.CanUnban)
        {
            <div class="mt-6 border-t border-border pt-4">
                <h3 class="text-sm font-medium">Act on a player</h3>
                <p class="mt-1 text-xs text-muted-foreground">Enter the player's account username exactly (case-sensitive).</p>
                <div class="mt-3 grid gap-3 sm:grid-cols-2">
                    <div class="flex flex-col text-sm">
                        <BbLabel For="player-username" Class="mb-1 text-muted-foreground">Username</BbLabel>
                        <BbInput Id="player-username" @bind-Value="_actionForm.Username" autocomplete="off" />
                    </div>
                    <div class="flex flex-col text-sm">
                        <BbLabel For="player-reason" Class="mb-1 text-muted-foreground">Reason (optional, kick/ban)</BbLabel>
                        <BbInput Id="player-reason" @bind-Value="_actionForm.Reason" autocomplete="off" />
                    </div>
                </div>
                <div class="mt-3 flex flex-wrap gap-2">
                    @if (Perm.CanKick)
                    {
                        <BbButton Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" Disabled="_acting"
                                  OnClick="@(() => ActionAsync("kick"))" data-action="kick">Kick</BbButton>
                    }
                    @if (Perm.CanBan)
                    {
                        <BbButton Variant="ButtonVariant.Destructive" Size="ButtonSize.Small" Disabled="_acting"
                                  OnClick="@(() => ActionAsync("ban"))" data-action="ban">Ban</BbButton>
                    }
                    @if (Perm.CanUnban)
                    {
                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Disabled="_acting"
                                  OnClick="@(() => ActionAsync("unban"))" data-action="unban">Unban</BbButton>
                    }
                    @if (Perm.CanBan)
                    {
                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Disabled="_acting"
                                  OnClick="@(() => ActionAsync("remove"))" data-action="remove-from-whitelist">Remove from whitelist</BbButton>
                    }
                </div>
            </div>
        }

        @if (Perm.CanConfigEdit)
        {
            <div class="mt-6 border-t border-border pt-4">
                <h3 class="text-sm font-medium">Whitelist mode</h3>
                <p class="mt-1 text-xs text-muted-foreground">
                    Open lets clients join without a whitelist account; closing it admits only whitelisted
                    players. Applied at runtime over RCON.
                </p>
                <div class="mt-3 flex flex-wrap gap-2">
                    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Disabled="_acting"
                              OnClick="@(() => ActionAsync("whitelist-open"))" data-action="whitelist-open">Open to all</BbButton>
                    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Disabled="_acting"
                              OnClick="@(() => ActionAsync("whitelist-close"))" data-action="whitelist-close">Whitelist only</BbButton>
                </div>
            </div>
        }
    </div>

    @if (Perm.CanView || Perm.CanUnban)
    {
        <div class="mt-6 border-t border-border pt-4">
            <h3 class="text-sm font-medium">Bans issued through ZWarden</h3>
            <p class="mt-1 text-xs text-muted-foreground">
                Bans this control plane issued — not a mirror of the server's full ban list (bans made
                in-game or from the console do not appear).
            </p>
            @if (_bans.Count == 0)
            {
                <p class="mt-3 text-sm text-muted-foreground" data-bans-empty>No bans on record.</p>
            }
            else
            {
                <div class="mt-3 block overflow-x-auto">
                    <table class="w-full border-collapse text-left text-sm" data-bans-table>
                        <thead>
                            <tr class="border-b border-border text-muted-foreground">
                                <th class="py-2 pr-4 font-medium">Username</th>
                                <th class="py-2 pr-4 font-medium">Reason</th>
                                <th class="py-2 pr-4 font-medium">Status</th>
                                <th class="py-2 pr-4 font-medium">Issued (UTC)</th>
                                <th class="py-2 font-medium"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (BanView ban in _bans)
                            {
                                <tr class="border-b border-border/60" data-ban-row>
                                    <td class="py-2 pr-4 font-mono">@ban.Username</td>
                                    <td class="py-2 pr-4 text-muted-foreground">@(string.IsNullOrWhiteSpace(ban.Reason) ? "—" : ban.Reason)</td>
                                    <td class="py-2 pr-4">@(ban.IsActive ? "Active" : "Lifted")</td>
                                    <td class="py-2 pr-4 tabular-nums">@BanIssued(ban.IssuedAt)</td>
                                    <td class="py-2">
                                        @if (ban.IsActive && Perm.CanUnban)
                                        {
                                            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Disabled="_acting"
                                                      OnClick="@(() => UnbanRowAsync(ban.Username))" data-action="unban-row">Unban</BbButton>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
</BbCard>

@code {
    /// <summary>The caller's per-server player grants (fail-closed).</summary>
    [Parameter, EditorRequired]
    public PlayerPermissions Perm { get; set; }

    private readonly PlayerActionModel _actionForm = new();
    private IReadOnlyList<BanView> _bans = [];
    private string? _playerMessage;
    private bool _acting;

    protected override async Task OnInitializedAsync() => await LoadBansAsync();

    private async Task LoadBansAsync()
    {
        ServerId serverId = Server.Id;
        _bans = (Perm.CanView || Perm.CanUnban)
            ? await Actions.RunAsync<IBanQuery, IReadOnlyList<BanView>>((bans, ct) => bans.ListForServerAsync(serverId, ct))
            : [];
    }

    private async Task ActionAsync(string verb)
    {
        _acting = true;
        try
        {
            UserId user = await CurrentUserAsync();
            ServerId serverId = Server.Id;
            string username = _actionForm.Username?.Trim() ?? string.Empty;
            string? reason = NullIfBlank(_actionForm.Reason);

            PlayerManagementResult? result = await Actions.RunAsync<IPlayerManagement, PlayerManagementResult?>(
                async (players, ct) => verb switch
                {
                    "refresh" => await players.ListPlayersAsync(user, serverId, ct),
                    "kick" => await players.KickAsync(user, serverId, username, reason, ct),
                    "ban" => await players.BanAsync(user, serverId, username, reason, ct),
                    "unban" => await players.UnbanAsync(user, serverId, username, ct),
                    "remove" => await players.RemoveFromWhitelistAsync(user, serverId, username, ct),
                    "whitelist-open" => await players.SetWhitelistModeAsync(user, serverId, open: true, ct),
                    "whitelist-close" => await players.SetWhitelistModeAsync(user, serverId, open: false, ct),
                    _ => null,
                });

            _playerMessage = Describe(verb, result);
            await LoadBansAsync(); // reflect a just-lifted/issued ban in the list
        }
        finally
        {
            _acting = false;
        }
    }

    private async Task UnbanRowAsync(string username)
    {
        if (string.IsNullOrWhiteSpace(username))
        {
            return;
        }

        _acting = true;
        try
        {
            UserId user = await CurrentUserAsync();
            ServerId serverId = Server.Id;
            string target = username.Trim();
            PlayerManagementResult result = await Actions.RunAsync<IPlayerManagement, PlayerManagementResult>(
                (players, ct) => players.UnbanAsync(user, serverId, target, ct));
            _playerMessage = Describe("unban", result);
            await LoadBansAsync();
        }
        finally
        {
            _acting = false;
        }
    }

    private static string? NullIfBlank(string? value) => string.IsNullOrWhiteSpace(value) ? null : value.Trim();

    private static string Describe(string verb, PlayerManagementResult? result)
    {
        if (result is null)
        {
            return "Choose an action.";
        }

        if (result.Succeeded)
        {
            string what = verb switch
            {
                "refresh" => "Roster refresh started",
                "kick" => "Kick enqueued",
                "ban" => "Ban enqueued",
                "unban" => "Unban enqueued",
                "remove" => "Whitelist removal enqueued",
                "whitelist-open" => "Whitelist opened",
                "whitelist-close" => "Whitelist closed",
                _ => "Action enqueued",
            };
            return $"{what} (operation {result.Operation}). The outcome appears on that operation shortly.";
        }

        return result.Failure switch
        {
            PlayerManagementFailure.NotAuthorized => "You are not permitted to perform that action on this server.",
            PlayerManagementFailure.ServerNotFound => "That server is no longer available.",
            PlayerManagementFailure.InvalidInput => result.Detail ?? "That username or reason is not valid.",
            _ => "The action could not be completed.",
        };
    }

    private static string BanIssued(DateTimeOffset at) =>
        at.UtcDateTime.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture);

    private sealed class PlayerActionModel
    {
        public string? Username { get; set; }

        public string? Reason { get; set; }
    }
}
