@using ZWarden.Domain.Ids
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject ConfigDraftStore Drafts

@* #331: warns before unsaved Config edits are lost. While Active, unsaved-guard.js holds a link to another page in the
   app and this asks in a Blueprint alert dialog; a reload, a tab close or an external link gets the browser's own
   "Leave site?" prompt (the only one a browser allows there). Moving between this Server's rail sections and config
   file tabs never asks: the circuit keeps the edits (ConfigDraftStore). *@
<BbAlertDialog @bind-Open="_asking">
    <BbAlertDialogContent data-unsaved-dialog>
        <BbAlertDialogHeader>
            <BbAlertDialogTitle>Discard unsaved configuration changes?</BbAlertDialogTitle>
            <BbAlertDialogDescription>
                You have configuration changes that haven't been applied. Leaving this server's page discards them.
            </BbAlertDialogDescription>
        </BbAlertDialogHeader>
        <BbAlertDialogFooter Class="mt-4">
            <BbAlertDialogCancel>
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" data-action="unsaved-stay">Stay</BbButton>
            </BbAlertDialogCancel>
            <BbButton Variant="ButtonVariant.Destructive" Size="ButtonSize.Small"
                      OnClick="LeaveAsync" data-action="unsaved-leave">Discard and leave</BbButton>
        </BbAlertDialogFooter>
    </BbAlertDialogContent>
</BbAlertDialog>

@code {
    /// <summary>The module that holds the warning in the browser.</summary>
    public const string ModulePath = "./js/unsaved-guard.js";

    /// <summary>The Server whose page this is; links to it (any section or file) keep the edits.</summary>
    [Parameter, EditorRequired]
    public ServerId ServerId { get; set; }

    /// <summary>Whether there are unsaved edits to warn about.</summary>
    [Parameter]
    public bool Active { get; set; }

    private IJSObjectReference? _module;
    private DotNetObjectReference<UnsavedConfigGuard>? _self;
    private bool? _sent;
    private bool _asking;
    private string? _leavingFor;
    private bool _left;

    /// <summary>Called by unsaved-guard.js with the link it held: asks whether to leave.</summary>
    [JSInvokable]
    public Task AskToLeave(string href) => InvokeAsync(() =>
    {
        _leavingFor = href;
        _asking = true;
        StateHasChanged();
    });

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        bool warn = Active && !_left;
        if (_sent == warn)
        {
            return;
        }

        _module ??= await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
        _self ??= DotNetObjectReference.Create(this);
        _sent = warn;
        await _module.InvokeVoidAsync("set", warn ? $"/servers/{ServerId}" : null, _self);
    }

    // The operator chose to leave: discard the edits, stop guarding (so the browser doesn't ask again on the way out)
    // and follow the link.
    private async Task LeaveAsync()
    {
        _asking = false;
        _left = true;
        Drafts.DiscardAll(ServerId);
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("set", null, null);
            _sent = false;
        }

        if (_leavingFor is { } href)
        {
            Navigation.NavigateTo(href);
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                // Off for now; the guard that replaces this one (the page's or the Config section's) turns it back on.
                await _module.InvokeVoidAsync("set", null, null);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is gone, and so is the page.
            }
        }

        _self?.Dispose();
    }
}
