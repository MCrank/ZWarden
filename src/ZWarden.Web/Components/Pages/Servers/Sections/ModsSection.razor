@inherits ServerSectionBase
@using ZWarden.Application.Mods
@inject IModInventoryCache ModInventories

@* The Mods rail section (#292 Variant B): the Server's mods as one table in load order (ModsTable), with a sticky
   pending-changes bar whose "Restart to apply" loads every change in one restart. Rows come from the persisted #290
   overview (ModTable, D1); warnings from the last inventory's mod.info (ModRowWarnings, D2). Each action is a
   circuit handler (#299) through the mod manager, which re-checks the per-server Mod.* / Server.Restart grants
   fail-closed; the page only decides which controls to offer. *@

<BbCard Class="p-5" data-mods-card>
    <div class="flex flex-wrap items-start justify-between gap-3">
        <div>
            <h2 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">Mods</h2>
            <p class="mt-1 text-xs text-muted-foreground" data-mods-lede>
                @if (_table.Rows.Count > 0)
                {
                    <span>Top to bottom in load order. Changes take effect when the server restarts.</span>
                }
                else
                {
                    <span>Workshop mods this server loads, top to bottom in load order.</span>
                }
            </p>
        </div>
        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Disabled="_acting"
                  title="Read this server's mod files and settings again"
                  OnClick="DiscoverModsAsync" data-action="mod-refresh">Re-scan</BbButton>
    </div>

    @if (_message is not null)
    {
        <div class="mt-3" data-mod-message>
            <BbAlert Variant="_alert" AccentBorder>
                <BbAlertDescription>@_message</BbAlertDescription>
            </BbAlert>
        </div>
    }

    @if (Perm.CanInstall)
    {
        <div class="mt-4 flex flex-wrap items-end gap-2" data-mod-add>
            <div class="flex flex-col text-sm">
                <BbLabel For="mod-workshop-id" Class="mb-1 text-muted-foreground">Install a Workshop item</BbLabel>
                <BbInput Id="mod-workshop-id" UpdateTiming="UpdateTiming.Immediate" @bind-Value="_workshopId" autocomplete="off"
                         inputmode="numeric" Placeholder="Workshop id, e.g. 2392709985" />
            </div>
            <ModInstallControl Server="Server" WorkshopId="@(_workshopId ?? string.Empty)" OnInstalled="ReloadAsync" />
        </div>
    }

    <div class="mt-4">
        @if (!_loaded)
        {
            <p class="text-sm text-muted-foreground" data-mod-manage-awaiting>
                ZWarden hasn't read this server's mods yet. Re-scan to read them now.
            </p>
        }
        else
        {
            <ModsTable Rows="_rows" Warnings="_warnings" Perm="Perm" Busy="_acting" Zone="OperatorZone" OnCommand="RunAsync" />
        }
    </div>

    <PendingChangesBar Pending="_pending" CanRestart="@(Perm.CanUpdate || Perm.CanRestart)" Busy="_acting" OnRestart="RestartAsync" />
</BbCard>

@code {
    /// <summary>The caller's per-server mod grants (fail-closed).</summary>
    [Parameter, EditorRequired]
    public ModManagePermissions Perm { get; set; }

    private string? _workshopId;
    private string? _message;
    private AlertVariant _alert = AlertVariant.Warning;
    private bool _acting;
    private bool _loaded;
    private ModTableView _table = new([], []);
    private List<ModTableRow> _rows = [];
    private List<ModTableRow> _pending = [];
    private IReadOnlyDictionary<string, IReadOnlyList<string>> _warnings = new Dictionary<string, IReadOnlyList<string>>();

    protected override Task OnInitializedAsync() => ReloadAsync();

    private async Task ReloadAsync()
    {
        UserId user = await CurrentUserAsync();
        ServerId serverId = Server.Id;
        ServerModOverview? overview = await Actions.RunAsync<IServerModOverviewService, ServerModOverview?>(
            (service, ct) => service.GetAsync(user, serverId, ct));
        ModInventory? inventory = ModInventoryView.Load(ModInventories, Server).Inventory;

        // Nothing read yet: no persisted lists (before the first discovery) and no inventory.
        _loaded = overview is { ConfigObservedAt: not null } || overview is { Items.Count: > 0 } || inventory is not null;
        _table = overview is null ? new ModTableView([], []) : ModTable.Build(overview);
        _rows = _table.Rows.ToList();
        _pending = _table.PendingRows.ToList();
        _warnings = ModRowWarnings.For(_table, inventory);
    }

    private async Task DiscoverModsAsync()
    {
        _acting = true;
        try
        {
            UserId user = await CurrentUserAsync();
            ServerId serverId = Server.Id;
            ModDiscoveryDispatch result = await Actions.RunAsync<IModDiscoveryService, ModDiscoveryDispatch>(
                (discovery, ct) => discovery.RequestAsync(user, serverId, ct));
            SetMessage(
                result.Succeeded
                    ? "Re-scan started. The list updates when it finishes."
                    : result.Failure switch
                    {
                        ModDiscoveryFailure.NotAuthorized => "You are not permitted to view this server's mods.",
                        ModDiscoveryFailure.ServerNotFound => "That server is no longer available.",
                        _ => "The re-scan could not be started.",
                    },
                ok: result.Succeeded);
        }
        finally
        {
            _acting = false;
        }
    }

    // One row action from the table, through the mod manager. A Workshop item row uses the item verbs; an "other mod"
    // row (an enabled id no tracked item provides) turns that one id off or back on.
    private async Task RunAsync(ModRowCommand command)
    {
        _acting = true;
        try
        {
            ServerId serverId = Server.Id;
            UserId user = await CurrentUserAsync();
            ModTableRow row = command.Row;
            string? workshopId = row.Item?.WorkshopId;
            string modId = row.Mods.Count > 0 ? row.Mods[0].ModId : string.Empty;

            Task<ModManagementResult> Manage(Func<IServerModManager, CancellationToken, Task<ModManagementResult>> action) =>
                Actions.RunAsync(action);

            switch (command.Verb)
            {
                case ModRowVerb.Remove when workshopId is not null:
                    SetResult(await Manage((mods, ct) => mods.RemoveWorkshopItemsAsync(user, serverId, [workshopId], ct)));
                    break;
                case ModRowVerb.Remove:
                    SetResult(await Manage((mods, ct) => mods.DisableModsAsync(user, serverId, [modId], ct)));
                    break;
                case ModRowVerb.Undo when workshopId is not null:
                    SetResult(await Manage((mods, ct) => mods.UndoPendingAsync(user, serverId, workshopId, ct)));
                    break;
                case ModRowVerb.Undo when row.Status is ModChangeStatus.RemovedOnRestart:
                    SetResult(await Manage((mods, ct) => mods.EnableModsAsync(user, serverId, [modId], ct)));
                    break;
                case ModRowVerb.Undo:
                    SetResult(await Manage((mods, ct) => mods.DisableModsAsync(user, serverId, [modId], ct)));
                    break;
                case ModRowVerb.SaveParts when workshopId is not null:
                    IReadOnlyList<string> parts = command.Parts;
                    SetResult(await Manage((mods, ct) => mods.SetItemPartsAsync(user, serverId, workshopId, parts, ct)));
                    break;
                case ModRowVerb.MoveUp or ModRowVerb.MoveDown:
                    IReadOnlyList<string>? order = _table.MoveOrder(row.Key, command.Verb == ModRowVerb.MoveUp ? ModMove.Up : ModMove.Down);
                    if (order is not null)
                    {
                        SetResult(await Manage((mods, ct) => mods.ReorderModsAsync(user, serverId, order, ct)));
                    }

                    break;
                default:
                    SetMessage("Choose an action.", ok: false);
                    break;
            }

            await ReloadAsync();
        }
        finally
        {
            _acting = false;
        }
    }

    // #292 D3: the bar's restart loads every pending change (and pulls newer Workshop versions, #273) after warning
    // players on the chosen countdown.
    private async Task RestartAsync(string preset)
    {
        _acting = true;
        try
        {
            ServerId serverId = Server.Id;
            UserId user = await CurrentUserAsync();
            GracefulRestartPayload plan = new(ServerDetailFormat.CountdownLeads(preset), "Applying mod changes.");
            ModManagementResult result = await Actions.RunAsync<IServerModManager, ModManagementResult>(
                (mods, ct) => mods.UpdateModsAsync(user, serverId, plan, ct));
            if (result.Succeeded)
            {
                SetMessage("Restart started. Mods load and Workshop updates download as the server boots.", ok: true);
            }
            else
            {
                SetResult(result);
            }
        }
        finally
        {
            _acting = false;
        }
    }

    private void SetResult(ModManagementResult result)
    {
        if (result.Succeeded)
        {
            SetMessage("Saved. It takes effect when the server restarts.", ok: true);
            return;
        }

        SetMessage(
            result.Failure switch
            {
                ModManagementFailure.NotAuthorized => "You are not permitted to manage this server's mods.",
                ModManagementFailure.ServerNotFound => "That server is no longer available.",
                ModManagementFailure.ServerBusy => "The server is busy with another operation; try again once it finishes.",
                ModManagementFailure.SnapshotUnavailable => "Re-scan this server's mods before making changes.",
                ModManagementFailure.NoChange => "That did not change anything.",
                ModManagementFailure.InvalidReorder => "The mod list changed underneath you; re-scan and try again.",
                ModManagementFailure.InvalidInput => result.Message ?? "That mod change is not valid.",
                _ => "The mod change could not be completed.",
            },
            ok: false);
    }

    private void SetMessage(string message, bool ok)
    {
        _message = message;
        _alert = ok ? AlertVariant.Success : AlertVariant.Warning;
    }
}
