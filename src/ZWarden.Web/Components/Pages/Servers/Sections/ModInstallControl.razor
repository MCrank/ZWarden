@inherits ServerSectionBase
@using ZWarden.Application.Mods
@using ZWarden.Application.Workshop

@* #291 one-click Install for one Workshop item, shared by the Mod Browser cards and the Mods section's add field.
   Install reads the item's description (keyless preview, Mod.View) and plans it: no ids → add the item only (Pick
   parts after the next boot); one id → install with it; several → an inline part picker, every part ticked, before
   anything is written. With a Steam Web API key, the item's required items are offered too, ticked, and installed in
   the same apply with their own description ids (D5). The manager re-checks Mod.Install and validates every id.
   Workshop text is rendered as data. Inline, not a dialog: the app has no portal host yet (#292 adds one). *@

<div class="zw-mb-actions flex-col items-start gap-2" data-mod-install data-workshop-id="@WorkshopId">
    @if (_plan is { } plan)
    {
        <div class="w-full rounded-md border border-border p-3" data-mod-install-picker>
            @if (plan.Kind == ModInstallKind.Choose)
            {
                <p class="text-xs text-muted-foreground">
                    This item has @plan.CandidateModIds.Count parts. Choose which to turn on. The download is checked
                    after the next restart, and anything it doesn't provide shows as <span class="font-medium">Pick parts</span>.
                </p>
                <div class="mt-2 space-y-1.5">
                    @foreach (string part in plan.CandidateModIds.Select(p => p.Value))
                    {
                        string id = $"part-{WorkshopId}-{part}";
                        <div class="flex items-center gap-2" data-mod-install-part data-mod-id="@part">
                            <BbCheckbox Id="@id" Checked="_picked.Contains(part)"
                                        CheckedChanged="@((bool on) => Toggle(_picked, part, on))" />
                            <BbLabel For="@id" Class="font-mono text-sm">@part</BbLabel>
                        </div>
                    }
                </div>
            }

            @if (_required.Count > 0)
            {
                <p class="@(plan.Kind == ModInstallKind.Choose ? "mt-3 " : "")text-xs text-muted-foreground">
                    It requires @_required.Count other item@(_required.Count == 1 ? "" : "s") on the Workshop. Install them too:
                </p>
                <div class="mt-2 space-y-1.5">
                    @foreach (WorkshopItemMetadata dependency in _required)
                    {
                        string id = $"dep-{WorkshopId}-{dependency.WorkshopId}";
                        <div class="flex items-center gap-2" data-mod-install-dependency data-workshop-id="@dependency.WorkshopId">
                            <BbCheckbox Id="@id" Checked="_pickedRequired.Contains(dependency.WorkshopId)"
                                        CheckedChanged="@((bool on) => Toggle(_pickedRequired, dependency.WorkshopId, on))" />
                            <BbLabel For="@id" Class="text-sm">
                                @(dependency.Found && !string.IsNullOrWhiteSpace(dependency.Title) ? dependency.Title : "Untitled item")
                                <span class="font-mono text-xs text-muted-foreground">@dependency.WorkshopId</span>
                            </BbLabel>
                        </div>
                    }
                </div>
            }

            <div class="mt-3 flex gap-2">
                <BbButton Size="ButtonSize.Small" Disabled="_acting" OnClick="ConfirmAsync" data-action="mod-install-confirm">
                    @ConfirmLabel(plan)
                </BbButton>
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Disabled="_acting"
                          OnClick="Cancel" data-action="mod-install-cancel">Cancel</BbButton>
            </div>
        </div>
    }
    else
    {
        <BbButton Size="ButtonSize.Small" Disabled="_acting || string.IsNullOrWhiteSpace(WorkshopId)"
                  OnClick="StartAsync" data-action="mod-install">@Label</BbButton>
    }

    @if (_message is not null)
    {
        <p class="text-xs @(_ok ? "text-muted-foreground" : "text-destructive")" data-mod-install-message>@_message</p>
    }
</div>

@code {
    /// <summary>The Workshop item to install.</summary>
    [Parameter, EditorRequired]
    public string WorkshopId { get; set; } = string.Empty;

    /// <summary>The button text.</summary>
    [Parameter]
    public string Label { get; set; } = "Install";

    /// <summary>Raised after an Install was enqueued, so the host can reload what it shows.</summary>
    [Parameter]
    public EventCallback OnInstalled { get; set; }

    // Set while the inline panel is open (several parts, or required items to offer).
    private ModInstallPlan? _plan;
    private HashSet<string> _picked = new(StringComparer.Ordinal);
    private IReadOnlyList<WorkshopItemMetadata> _required = [];
    private HashSet<string> _pickedRequired = new(StringComparer.Ordinal);
    private string? _message;
    private bool _ok;
    private bool _acting;

    private async Task StartAsync()
    {
        string workshopId = WorkshopId.Trim();
        _acting = true;
        _message = null;
        try
        {
            UserId user = await CurrentUserAsync();
            ServerId serverId = Server.Id;
            WorkshopPreview preview = await Actions.RunAsync<IWorkshopMetadataService, WorkshopPreview>(
                (metadata, ct) => metadata.ResolveAsync(user, serverId, workshopId, ct));
            WorkshopItemMetadata item = preview.Items.FirstOrDefault(i => i.WorkshopId == workshopId)
                ?? WorkshopItemMetadata.NotFound(workshopId);
            ModInstallPlan plan = ModInstallPlan.For(item);
            IReadOnlyList<WorkshopItemMetadata> required = await Actions.RunAsync<IWorkshopDependencyService, IReadOnlyList<WorkshopItemMetadata>>(
                (dependencies, ct) => dependencies.GetRequiredItemsAsync(user, serverId, workshopId, ct));

            if (plan.Kind == ModInstallKind.Choose || required.Count > 0)
            {
                _plan = plan;
                _picked = new HashSet<string>(plan.CandidateModIds.Select(p => p.Value), StringComparer.Ordinal);
                _required = required;
                _pickedRequired = new HashSet<string>(required.Select(r => r.WorkshopId), StringComparer.Ordinal);
                return;
            }

            await InstallCoreAsync(user, plan, [plan.WorkshopId], [.. plan.CandidateModIds.Select(p => p.Value)], requiredCount: 0);
        }
        finally
        {
            _acting = false;
        }
    }

    private async Task ConfirmAsync()
    {
        if (_plan is not { } plan)
        {
            return;
        }

        _acting = true;
        try
        {
            // The item's parts (all of them, or the ticked ones when it has several), then each ticked required
            // item with every id its own description lists.
            List<string> modIds = plan.Kind == ModInstallKind.Choose
                ? [.. plan.CandidateModIds.Select(p => p.Value).Where(_picked.Contains)]
                : [.. plan.CandidateModIds.Select(p => p.Value)];
            List<WorkshopItemMetadata> required = [.. _required.Where(r => _pickedRequired.Contains(r.WorkshopId))];
            foreach (WorkshopItemMetadata dependency in required)
            {
                modIds.AddRange(ModInstallPlan.For(dependency).CandidateModIds.Select(p => p.Value));
            }

            List<string> workshopIds = [plan.WorkshopId, .. required.Select(r => r.WorkshopId)];
            await InstallCoreAsync(await CurrentUserAsync(), plan, workshopIds, [.. modIds.Distinct(StringComparer.Ordinal)], required.Count);
        }
        finally
        {
            _acting = false;
        }
    }

    private async Task InstallCoreAsync(
        UserId user, ModInstallPlan plan, IReadOnlyList<string> workshopIds, IReadOnlyList<string> modIds, int requiredCount)
    {
        ServerId serverId = Server.Id;
        ModManagementResult result = await Actions.RunAsync<IServerModManager, ModManagementResult>(
            (mods, ct) => mods.InstallWorkshopItemsAsync(user, serverId, workshopIds, modIds, ct));

        _ok = result.Succeeded;
        _message = result.Succeeded ? Installed(plan, modIds, requiredCount) : Refused(result);
        if (result.Succeeded)
        {
            _plan = null;
            await OnInstalled.InvokeAsync();
        }
    }

    private static void Toggle(HashSet<string> set, string value, bool on)
    {
        if (on)
        {
            set.Add(value);
        }
        else
        {
            set.Remove(value);
        }
    }

    private void Cancel()
    {
        _plan = null;
        _message = null;
    }

    private string ConfirmLabel(ModInstallPlan plan)
    {
        string parts = plan.Kind == ModInstallKind.Choose ? $" {_picked.Count} of {plan.CandidateModIds.Count}" : string.Empty;
        string plus = _pickedRequired.Count > 0 ? $" + {_pickedRequired.Count} required" : string.Empty;
        return $"Install{parts}{plus}";
    }

    private static string Installed(ModInstallPlan plan, IReadOnlyList<string> modIds, int requiredCount)
    {
        string with = requiredCount > 0 ? $" with {requiredCount} required item{(requiredCount == 1 ? "" : "s")}" : string.Empty;
        return modIds.Count switch
        {
            0 when plan.Kind == ModInstallKind.NoIds =>
                $"Added{with}. Its Workshop page lists no mod ids, so after the next restart choose its parts in Mods.",
            0 => $"Added{with} with no parts turned on. After the next restart, choose its parts in Mods.",
            1 => $"Installed{with} — {modIds[0]} loads on the next restart.",
            _ => $"Installed{with} — {modIds.Count} mods load on the next restart.",
        };
    }

    private static string Refused(ModManagementResult result) => result.Failure switch
    {
        ModManagementFailure.NotAuthorized => "You are not permitted to install mods on this server.",
        ModManagementFailure.ServerNotFound => "That server is no longer available.",
        ModManagementFailure.ServerBusy => "The server is busy with another operation; try again once it finishes.",
        ModManagementFailure.SnapshotUnavailable => "This server's mods haven't been read yet; refresh discovery in Mods first.",
        ModManagementFailure.NoChange => "That item and its parts are already installed.",
        ModManagementFailure.InvalidInput => result.Message ?? "That Workshop item can't be installed.",
        _ => "The item could not be installed.",
    };
}
