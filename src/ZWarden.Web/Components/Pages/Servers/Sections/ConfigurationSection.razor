@inherits ServerSectionBase
@implements IDisposable
@using ZWarden.Application.Configuration
@using ZWarden.Application.Operations
@using ZWarden.Domain.Configuration
@using ZWarden.Domain.Operations
@inject NavigationManager Navigation
@inject IJSRuntime JS

@* The Config rail section (F20/F20c): the live schema editor, the gated raw edit, the by-path apply and the revision
   history, gated on the per-server Server.Configuration.Edit by the page and re-checked in the services. Values read
   from the host are untrusted Agent text, rendered as data. Interactive since #299: search, the changed-row mark,
   collapse/expand-all and the "applying…" tracking are circuit state (config-editor.js is gone), and the unsaved
   edits are a [PersistentState] draft (D1), kept in server memory only — the values include secrets. *@

<BbCard Class="p-5" data-config-card>
    <h2 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">Configuration</h2>
    <p class="mt-1 text-xs text-muted-foreground">
        The current values of this server's configuration files, read live from the host and grouped for
        editing. Change as many settings as you like, then <span class="font-medium">Apply changes</span> —
        each changed value is re-checked against the live file and refused if it changed outside ZWarden
        (fail-closed), then written byte-for-byte and recorded as a revision. Adding or removing keys is not
        supported — the game owns the key set. <span class="font-mono">.ini</span> changes are reloaded live on a running server (mods and ports still need a restart);
        sandbox and spawn changes take effect on the next restart.
    </p>

    @if (_configDrift)
    {
        <div class="mt-3" data-config-drift>
            <BbAlert Variant="AlertVariant.Warning" AccentBorder>
                <BbAlertDescription>
                    This file changed on the host since you loaded it — another operator or the in-game admin
                    panel wrote it, or the server rewrote it on start. Nothing was applied. The editor below now
                    shows the <span class="font-medium">current</span> values with your changes kept on top
                    (highlighted); review them and <span class="font-medium">Apply changes</span> again to write them.
                </BbAlertDescription>
            </BbAlert>
        </div>
    }

    @if (_write is { } write && _configMessage is null)
    {
        @if (!write.IsTerminal)
        {
            <div class="mt-3" data-config-applying>
                <BbAlert Variant="AlertVariant.Info" AccentBorder>
                    <BbAlertDescription>
                        @if (_tracking)
                        {
                            <span>Applying your changes… The editor reloads when the host has written them.</span>
                        }
                        else
                        {
                            <span>This change is still waiting to be applied — the host may be offline or busy.
                                <BbButton Variant="ButtonVariant.Link" Size="ButtonSize.Small" Class="h-auto p-0"
                                          OnClick="CheckWriteAgainAsync" data-action="config-check-again">Check again</BbButton>.</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(write.StatusLine))
                        {
                            <span class="block text-xs">@write.StatusLine</span>
                        }
                        <span class="block font-mono text-xs text-muted-foreground">operation @write.Id</span>
                    </BbAlertDescription>
                </BbAlert>
            </div>
        }
        else if (write.State == OperationState.Succeeded)
        {
            <div class="mt-3" data-config-applied>
                <BbAlert Variant="AlertVariant.Success" AccentBorder>
                    <BbAlertDescription>
                        @(string.IsNullOrWhiteSpace(write.StatusLine) ? "Applied." : write.StatusLine)
                        The editor shows the values now on the host.
                    </BbAlertDescription>
                </BbAlert>
            </div>
        }
        else
        {
            <div class="mt-3" data-config-apply-failed>
                <BbAlert Variant="AlertVariant.Warning" AccentBorder>
                    <BbAlertDescription>
                        The change was not applied:
                        @(write.State == OperationState.Cancelled
                            ? "the operation was cancelled."
                            : write.FailureReason ?? "the host reported a failure.")
                        The editor shows the values currently on the host.
                    </BbAlertDescription>
                </BbAlert>
            </div>
        }
    }

    @if (_configMessage is not null)
    {
        <div class="mt-3" data-config-message>
            <BbAlert Variant="_configAlert" AccentBorder>
                <BbAlertDescription>@_configMessage</BbAlertDescription>
            </BbAlert>
        </div>
    }

    @* File tabs — bookmarkable switching (?file=), like the section rail. Switching files discards unsaved edits. *@
    <div class="zw-cfg-tabs" data-config-tabs>
        @foreach (PzConfigFile file in ConfigFiles)
        {
            <a class="zw-cfg-tab @(file == _selectedFile ? "active" : string.Empty)"
               href="@ConfigFileHref(file)" data-config-tab="@file">@FileLabel(file)</a>
        }
    </div>

    @* While a tracked write runs the host still holds the old values, so the editor is withheld rather than shown
       stale; it reloads once the Agent is done (#226). *@
    @if (_tracking)
    {
    }
    else if (Draft is { View: { IsRead: true } view } draft && view.Sections.Count > 0)
    {
        <div class="mt-2" data-cfg-form>
            <div class="zw-cfg-toolbar">
                <label class="zw-cfg-searchbox">
                    <ShellIcon Name="search" />
                    <input type="search" placeholder="Search settings…" autocomplete="off" spellcheck="false"
                           aria-label="Search settings" data-cfg-search
                           @bind="_search" @bind:event="oninput" />
                </label>
                @* #243: collapse/expand every section, remembered per browser. *@
                <span class="zw-cfg-sections" data-cfg-sections-controls>
                    @* Outline in the brand accent (style guide: primary marks controls, never status), a step
                       below the filled Apply button. *@
                    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                              Class="zw-cfg-sections-btn" OnClick="@(() => SetAllSectionsAsync(collapsed: true))" data-cfg-sections="collapse">
                        <ShellIcon Name="chevrons-down-up" />Collapse all
                    </BbButton>
                    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                              Class="zw-cfg-sections-btn" OnClick="@(() => SetAllSectionsAsync(collapsed: false))" data-cfg-sections="expand">
                        <ShellIcon Name="chevrons-up-down" />Expand all
                    </BbButton>
                </span>
                <span class="zw-spacer"></span>
                <BbButton Variant="ButtonVariant.Link" Size="ButtonSize.Small" Class="h-auto p-0 text-xs text-muted-foreground hover:text-foreground"
                          OnClick="ReloadFromHostAsync" Disabled="_acting" data-action="config-reload">Reload from host</BbButton>
                <BbButton Size="ButtonSize.Small" OnClick="ApplyEditsAsync" Disabled="_acting" data-action="config-apply-batch">Apply changes</BbButton>
            </div>

            <p class="mt-2 text-xs text-muted-foreground">@RestartHint(_selectedFile)</p>

            @{ int rowIndex = 0; }
            @foreach (ConfigSection section in view.Sections)
            {
                int first = rowIndex;
                rowIndex += section.Settings.Count;
                List<(ConfigSettingView Setting, ConfigEditorRow Row)> shown = [];
                for (int s = 0; s < section.Settings.Count; s++)
                {
                    ConfigSettingView setting = section.Settings[s];
                    if (Matches(setting) && draft.Rows.Count > first + s)
                    {
                        shown.Add((setting, draft.Rows[first + s]));
                    }
                }

                if (shown.Count == 0)
                {
                    continue;
                }

                <details class="zw-cfg-sec" open="@IsOpen(section.Name)" data-cfg-sec @key="section.Name">
                    <summary @onclick="@(() => ToggleSection(section.Name))" @onclick:preventDefault>
                        <span>@section.Name</span>
                        <span class="zw-cfg-count">@section.Settings.Count</span>
                    </summary>
                    @foreach ((ConfigSettingView setting, ConfigEditorRow row) in shown)
                    {
                        <div class="zw-cfg-row @(row.IsDirty ? "zw-cfg-changed" : string.Empty)" data-cfg-row
                             data-cfg-path="@setting.Path" @key="setting.Path">
                            <div class="zw-cfg-name">
                                <span class="zw-cfg-changed-dot" aria-hidden="true">•</span>
                                <div class="min-w-0">
                                    <span class="zw-cfg-labeltext">@setting.Label</span>
                                    @if (!string.Equals(setting.Label, setting.Path, StringComparison.Ordinal))
                                    {
                                        <span class="zw-cfg-path">@setting.Path</span>
                                    }
                                    @if (setting.Managed)
                                    {
                                        <span class="zw-cfg-path" data-cfg-managed>@ManagedNote(setting.Path)</span>
                                    }
                                </div>
                                @if (HasHelp(setting))
                                {
                                    <span class="zw-cfg-info" tabindex="0" role="button"
                                          aria-label="About @setting.Label">i<span class="zw-cfg-pop" role="tooltip">
                                        @if (!string.IsNullOrWhiteSpace(setting.Tooltip))
                                        {
                                            <div>@setting.Tooltip</div>
                                        }
                                        @if (setting.Options.Count > 0)
                                        {
                                            <div class="zw-cfg-pop-meta">
                                                @foreach (ConfigOption opt in setting.Options)
                                                {
                                                    <div>@opt.Value = @opt.Label</div>
                                                }
                                            </div>
                                        }
                                        @if (MetaText(setting) is { Length: > 0 } meta)
                                        {
                                            <div class="zw-cfg-pop-meta">@meta</div>
                                        }
                                        @if (!setting.KnownToSchema)
                                        {
                                            <div class="zw-cfg-pop-src">Not in ZWarden's schema — applied as-is, unvalidated.</div>
                                        }
                                    </span></span>
                                }
                            </div>

                            <div class="zw-cfg-control">
                                @if (setting.Managed)
                                {
                                    @* #228: ZWarden-managed (the INI ports). Read-only, so it never becomes an edit; every
                                       apply path refuses a change regardless. *@
                                    <input type="text" class="zw-cfg-input" value="@row.Value" readonly aria-readonly="true" data-cfg-value />
                                }
                                else if (setting.Options.Count > 0)
                                {
                                    <select class="zw-cfg-input" @bind="row.Value" data-cfg-value>
                                        @foreach (ConfigOption opt in setting.Options)
                                        {
                                            <option value="@opt.Value">@opt.Label</option>
                                        }
                                        @* A value that isn't one of the choices — damaged on the host (#223), or an edit carried
                                           across a drift (#226) — stays selectable as itself. *@
                                        @foreach (string extra in ExtraChoices(setting, row))
                                        {
                                            <option value="@extra">@(string.IsNullOrEmpty(extra) ? "(empty)" : extra)</option>
                                        }
                                    </select>
                                }
                                else if (setting.Shape == ConfigValueShape.Boolean)
                                {
                                    <label class="zw-cfg-toggle">
                                        <input type="checkbox" class="zw-cfg-switch" @bind="row.Flag" data-cfg-value />
                                        <span class="zw-cfg-state">@(row.Flag ? "On" : "Off")</span>
                                    </label>
                                }
                                else if (setting.Shape is ConfigValueShape.Whole or ConfigValueShape.Fractional)
                                {
                                    <input type="number" class="zw-cfg-input" @bind="row.Value" @bind:event="oninput" data-cfg-value
                                           step="@(setting.Shape == ConfigValueShape.Whole ? "1" : "any")"
                                           min="@(setting.Min?.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                           max="@(setting.Max?.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
                                }
                                else
                                {
                                    <input type="text" class="zw-cfg-input" @bind="row.Value" @bind:event="oninput"
                                           autocomplete="off" spellcheck="false" data-cfg-value />
                                }
                            </div>
                        </div>
                    }
                </details>
            }

            <div class="mt-4 flex flex-wrap gap-2">
                <BbButton Size="ButtonSize.Small" OnClick="ApplyEditsAsync" Disabled="_acting" data-action="config-apply-batch-bottom">Apply changes</BbButton>
            </div>
        </div>
    }
    else if (Draft is { View: { IsRead: false } unread })
    {
        <div class="zw-cfg-empty" data-config-unavailable="@unread.Outcome">
            @ReadOutcomeText(unread)
        </div>
    }
    else if (Draft is { View.IsRead: true })
    {
        <div class="zw-cfg-empty" data-config-empty>No editable settings were found in this file.</div>
    }

    @if (!_tracking && Draft?.View.RawText is { Length: > 0 } rawText)
    {
        <details class="zw-cfg-raw" data-config-raw>
            <summary><ShellIcon Name="scroll-text" /> Raw file — @FileLabel(_selectedFile)</summary>
            @if (Draft.View.IsRead)
            {
                @* Gated raw whole-file edit (F20c PR-D, ADR 0042). Arbitrary operator text bypasses the
                   surgical writer and can stop the server on start, so it is gated behind an explicit
                   acknowledgement; the Agent still parse-validates, drift-checks, and writes BOM-less. *@
                <div class="mt-2" data-config-raweditform>
                    <p class="mb-2 text-xs text-muted-foreground">
                        Editing the whole file replaces every byte the game reads. A typo can stop the server
                        from starting. The text is re-parsed and re-checked against the live file before it is
                        written; a syntax error or a drift is refused. Prefer the structured editor above unless
                        you need a setting it does not surface (for example the spawn files).
                    </p>
                    <BbTextarea Class="zw-cfg-rawedit" rows="16" spellcheck="false" autocomplete="off"
                                AriaLabel="Raw file contents" Value="@(Draft.RawContent ?? rawText)"
                                ValueChanged="@((string? text) => Draft.RawContent = text)" data-config-rawtext />
                    <div class="mt-2 flex items-start gap-2 text-xs text-muted-foreground">
                        <BbCheckbox Id="config-raw-confirm" @bind-Checked="Draft.RawConfirmed" data-config-rawconfirm />
                        <BbLabel For="config-raw-confirm" Class="text-xs font-normal text-muted-foreground">
                            I understand this replaces the whole file and can prevent the server from starting.
                        </BbLabel>
                    </div>
                    <div class="mt-2 flex flex-wrap items-center gap-2">
                        <BbButton Size="ButtonSize.Small" OnClick="RawEditAsync" Disabled="_acting" data-action="config-raw-apply">Apply raw edit</BbButton>
                        <BbButton Variant="ButtonVariant.Link" Size="ButtonSize.Small" Class="h-auto p-0 text-xs text-muted-foreground hover:text-foreground"
                                  OnClick="ReloadFromHostAsync" Disabled="_acting" data-action="config-raw-reload">Reload from host</BbButton>
                    </div>
                </div>
            }
            else
            {
                <pre>@rawText</pre>
            }
        </details>
    }

    @* Advanced: the by-path single-edit form. It needs no live read, so it stays available when the host is
       offline, and covers a key the structured editor does not surface (e.g. a spawn-file value). *@
    <details class="mt-6 border-t border-border pt-4" data-config-advanced>
        <summary class="cursor-pointer text-sm font-medium">Advanced — edit a single setting by path</summary>
        <EditForm Model="_configForm" OnValidSubmit="ConfigAsync" class="mt-3">
            <DataAnnotationsValidator />
            <div class="grid gap-3 sm:grid-cols-4">
                <div class="flex flex-col text-sm">
                    <BbLabel For="config-file" Class="mb-1 text-muted-foreground">File</BbLabel>
                    <BbNativeSelect TValue="string" Id="config-file" @bind-Value="_configForm.File">
                        <option value="Ini">servertest.ini</option>
                        <option value="SandboxVars">SandboxVars.lua</option>
                        <option value="SpawnRegions">spawnregions.lua</option>
                        <option value="SpawnPoints">spawnpoints.lua</option>
                    </BbNativeSelect>
                </div>
                <div class="flex flex-col text-sm">
                    <BbLabel For="config-path" Class="mb-1 text-muted-foreground">Setting path</BbLabel>
                    <BbInput Id="config-path" UpdateTiming="UpdateTiming.Immediate" @bind-Value="_configForm.Path" autocomplete="off" Placeholder="e.g. Map.AllowMiniMap" />
                </div>
                <div class="flex flex-col text-sm">
                    <BbLabel For="config-kind" Class="mb-1 text-muted-foreground">Type</BbLabel>
                    <BbNativeSelect TValue="string" Id="config-kind" @bind-Value="_configForm.Kind">
                        <option value="Bool">true / false</option>
                        <option value="Number">number</option>
                        <option value="Text">text</option>
                    </BbNativeSelect>
                </div>
                <div class="flex flex-col text-sm">
                    <BbLabel For="config-value" Class="mb-1 text-muted-foreground">New value</BbLabel>
                    <BbInput Id="config-value" UpdateTiming="UpdateTiming.Immediate" @bind-Value="_configForm.Value" autocomplete="off" />
                </div>
            </div>
            <div class="mt-3 flex flex-wrap gap-2">
                <BbButton Type="ButtonType.Submit" Size="ButtonSize.Small" Disabled="_acting" data-action="config-apply">Apply edit</BbButton>
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="LoadAdvancedHistory" data-action="config-load">Load history</BbButton>
            </div>
        </EditForm>
    </details>

    <div class="mt-6 border-t border-border pt-4">
        <h3 class="text-sm font-medium">Revision history — @FileLabel(_selectedFile)</h3>
        <p class="mt-1 text-xs text-muted-foreground">
            Each recorded change to this file, newest first, shown as the parsed values that changed —
            not a text diff (the game rewrites these files on every start). Restoring re-applies a prior
            revision's values as a fresh, drift-checked edit.
        </p>

        @if (_revisions.Count == 0)
        {
            <p class="mt-3 text-sm text-muted-foreground" data-revisions-empty>
                No revisions recorded for this file yet. A revision is recorded the first time a change is applied.
            </p>
        }
        else
        {
            <div class="mt-3 block overflow-x-auto">
                <table class="w-full border-collapse text-left text-sm" data-revisions-table>
                    <thead>
                        <tr class="border-b border-border text-muted-foreground">
                            <th class="py-2 pr-4 font-medium">Recorded (UTC)</th>
                            <th class="py-2 pr-4 font-medium">Changes</th>
                            <th class="py-2 pr-4 font-medium">Snapshot</th>
                            <th class="py-2 font-medium"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (ConfigRevisionView rev in _revisions)
                        {
                            <tr class="border-b border-border/60 align-top" data-revision-row>
                                <td class="py-2 pr-4 tabular-nums">
                                    @Recorded(rev.RecordedAt)
                                    @if (rev.IsCurrent)
                                    {
                                        <span class="ml-1 text-xs text-muted-foreground">(current)</span>
                                    }
                                </td>
                                <td class="py-2 pr-4">
                                    @if (rev.Changes.Count == 0)
                                    {
                                        <span class="text-muted-foreground">baseline</span>
                                    }
                                    else
                                    {
                                        foreach (ConfigValueChange change in rev.Changes)
                                        {
                                            <div class="font-mono text-xs" data-change>@ChangeText(change)</div>
                                        }
                                    }
                                </td>
                                <td class="py-2 pr-4 font-mono text-xs">@rev.ShortHash</td>
                                <td class="py-2">
                                    @if (!rev.IsCurrent)
                                    {
                                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Disabled="_acting"
                                                  OnClick="@(() => RestoreAsync(rev.Id))" data-action="config-restore">Restore</BbButton>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</BbCard>

@code {
    // How often a tracked write is re-checked, and for how long before the page stops on its own (#226).
    private static readonly TimeSpan WritePoll = TimeSpan.FromSeconds(2);
    private static readonly TimeSpan ConfigRefreshWindow = TimeSpan.FromMinutes(2);

    // The browser preference (#243) for collapse/expand-all, one choice for every editor.
    private const string SectionsPrefKey = "zw-cfg-sections";

    // Which config file the live editor shows (F20c): the page's ?file=, bookmarkable like ?section=; Ini by default.
    // The page reads the query and passes it down: a section created while the query changes must not subscribe to
    // the query itself, or the circuit's location-changed dispatch throws (collection modified).
    [Parameter]
    public string? FileParam { get; set; }

    // A configuration write to track (#226): the page's ?op=, from a link (e.g. a by-path edit to another file). Only a
    // config write for this Server, visible in the tenant, is honoured; anything else is ignored (fail-closed).
    [Parameter]
    public string? OperationParam { get; set; }

    /// <summary>The unsaved editor state (D1): restored from the prerender, or after a reconnect.</summary>
    [PersistentState]
    public ConfigEditorDraft? Draft { get; set; }

    private readonly ConfigFormModel _configForm = new();
    private readonly Dictionary<string, bool> _sectionOverrides = new(StringComparer.Ordinal);
    private (PzConfigFile File, string? Operation)? _loadedFor;
    private PzConfigFile _selectedFile = PzConfigFile.Ini;
    private IReadOnlyList<ConfigRevisionView> _revisions = [];
    private string? _configMessage;
    private AlertVariant _configAlert = AlertVariant.Warning;
    private bool _configDrift;
    private bool _acting;
    private string _search = string.Empty;
    private bool _collapseAll;
    private IJSObjectReference? _prefs;

    // The tracked configuration write (#226), and whether the circuit is still polling it.
    private ConfigWriteView? _write;
    private bool _tracking;
    private CancellationTokenSource? _trackingCts;

    protected override async Task OnParametersSetAsync()
    {
        // The page re-renders this section on every header poll; load only when the file or tracked write changes.
        PzConfigFile file = ParseFile(FileParam);
        if (_loadedFor == (file, OperationParam))
        {
            return;
        }

        bool fileChanged = _loadedFor?.File != file;
        _loadedFor = (file, OperationParam);
        _selectedFile = file;
        _configForm.File = file.ToString();
        if (fileChanged)
        {
            _configMessage = null;
            _configDrift = false;
            _search = string.Empty;
            _sectionOverrides.Clear();
        }

        await LoadHistoryAsync();
        if (await TrackLinkedWriteAsync())
        {
            return;
        }

        // A draft for this file (from the prerender, or kept across a reconnect) is the editor as the operator left
        // it; anything else is a fresh read. Switching files discards the other file's unsaved edits.
        if (Draft is null || Draft.File != file)
        {
            await ReadAsync();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _prefs = await JS.InvokeAsync<IJSObjectReference>("import", "./js/local-prefs.js");
        if (await _prefs.InvokeAsync<string?>("get", SectionsPrefKey) == "collapsed")
        {
            _collapseAll = true;
            StateHasChanged();
        }
    }

    // ---- reading -------------------------------------------------------------------------------------------------

    // Reads the live Configuration View of the selected file from the host and resets the draft to it (F20c).
    // Fail-closed and non-throwing: every unavailable/denied case is an outcome the markup renders as a message.
    private async Task ReadAsync() => Draft = ConfigEditorDraft.From(_selectedFile, await FreshReadAsync(_selectedFile));

    private async Task<ConfigDocumentView> FreshReadAsync(PzConfigFile file)
    {
        UserId user = await CurrentUserAsync();
        ServerId serverId = Server.Id;
        return await Actions.RunAsync<IServerConfigurationReader, ConfigDocumentView>(
            (reader, ct) => reader.ReadAsync(user, serverId, file, ct));
    }

    private async Task LoadHistoryAsync()
    {
        UserId user = await CurrentUserAsync();
        ServerId serverId = Server.Id;
        PzConfigFile file = _selectedFile;
        _revisions = await Actions.RunAsync<IServerConfigurationHistory, IReadOnlyList<ConfigRevisionView>>(
            (history, ct) => history.GetHistoryAsync(user, serverId, file, ct));
    }

    private async Task ReloadFromHostAsync()
    {
        await ActAsync(async () =>
        {
            _configMessage = null;
            _configDrift = false;
            await ReadAsync();
        });
    }

    // ---- applying ------------------------------------------------------------------------------------------------

    // The batch apply (F20c): enqueue the changed rows as one surgical apply. A fresh read first confirms the file
    // still matches the baseline the operator was shown; a mismatch (or a read that could not confirm the current
    // state) refuses and shows the current values with the edits carried on top. The Agent's own fail-closed check
    // (ADR 0011) still guards the race between this read and the write (ADR 0042).
    private Task ApplyEditsAsync() => ActAsync(async () =>
    {
        if (Draft is not { } draft)
        {
            return;
        }

        List<ConfigApplyEdit> edits = draft.Edits();
        if (edits.Count == 0)
        {
            SetConfigMessage("No changes to apply — every setting still holds its loaded value.", ok: false);
            return;
        }

        ConfigDocumentView live = await FreshReadAsync(draft.File);
        if (!live.IsRead)
        {
            SetConfigMessage(
                "Could not read the current configuration from the host, so nothing was applied. "
                + "Try Reload from host, then apply again.",
                ok: false);
            return;
        }

        if (!InSync(draft.BaselineHash, live))
        {
            // Drift: show the current values with the operator's edits kept on top; a second Apply writes them.
            _configDrift = true;
            Draft = ConfigEditorDraft.From(draft.File, live);
            Draft.Carry(edits);
            return;
        }

        UserId user = await CurrentUserAsync();
        ServerId serverId = Server.Id;
        string? baseline = draft.BaselineHash;
        PzConfigFile file = draft.File;
        ServerConfigurationResult result = await Actions.RunAsync<IServerConfigurationEditor, ServerConfigurationResult>(
            (editor, ct) => editor.ApplyAsync(user, serverId, file, edits, expectedBaselineHash: baseline, ct));
        await SetConfigResultAsync(result, file, $"{edits.Count} change{(edits.Count == 1 ? string.Empty : "s")} enqueued");
    });

    // The gated raw whole-file edit (F20c PR-D, ADR 0042): the acknowledgement, a drift pre-check against a fresh read
    // like the structured editor, then a staged ConfigApplyRaw. The Agent still parse-validates and drift-checks.
    private Task RawEditAsync() => ActAsync(async () =>
    {
        if (Draft is not { } draft)
        {
            return;
        }

        string content = draft.RawContent ?? draft.View.RawText;
        if (!draft.RawConfirmed)
        {
            SetConfigMessage("Confirm you understand a raw edit replaces the whole file before applying it.", ok: false);
            return;
        }

        if (string.IsNullOrWhiteSpace(content))
        {
            SetConfigMessage("The edited file text is empty, so nothing was applied.", ok: false);
            return;
        }

        ConfigDocumentView live = await FreshReadAsync(draft.File);
        if (!live.IsRead)
        {
            SetConfigMessage(
                "Could not read the current configuration from the host, so the raw edit was not applied. "
                + "Try Reload from host, then apply again.",
                ok: false);
            return;
        }

        if (!InSync(draft.BaselineHash, live))
        {
            // A raw edit can't be auto-merged: keep the text and the stale baseline (a blind re-apply re-drifts, fail
            // closed) and show the banner; Reload from host picks up the current text.
            _configDrift = true;
            return;
        }

        UserId user = await CurrentUserAsync();
        ServerId serverId = Server.Id;
        string? baseline = draft.BaselineHash;
        PzConfigFile file = draft.File;
        ServerConfigurationResult result = await Actions.RunAsync<IServerConfigurationEditor, ServerConfigurationResult>(
            (editor, ct) => editor.ApplyRawAsync(user, serverId, file, content, expectedBaselineHash: baseline, ct));
        await SetConfigResultAsync(result, file, "raw whole-file edit enqueued");
    });

    // The by-path single edit. Drift-checks against the file as it is now (#226), not ZWarden's last recorded
    // revision; with no read (an offline host) it falls back to the recorded revision, so the edit still queues.
    private Task ConfigAsync() => ActAsync(async () =>
    {
        PzConfigFile file = ParseFile(_configForm.File);
        string path = _configForm.Path?.Trim() ?? string.Empty;
        if (path.Length == 0)
        {
            SetConfigMessage("Enter the setting path to change (e.g. Map.AllowMiniMap).", ok: false);
            return;
        }

        ConfigDocumentView live = await FreshReadAsync(file);
        var edit = new ConfigApplyEdit(path, ParseKind(_configForm.Kind), _configForm.Value ?? string.Empty);
        UserId user = await CurrentUserAsync();
        ServerId serverId = Server.Id;
        string? baseline = live.IsRead ? live.BaselineHash : null;
        ServerConfigurationResult result = await Actions.RunAsync<IServerConfigurationEditor, ServerConfigurationResult>(
            (editor, ct) => editor.ApplyAsync(user, serverId, file, [edit], expectedBaselineHash: baseline, ct));
        await SetConfigResultAsync(result, file, $"Edit to {path} enqueued");
    });

    private Task RestoreAsync(ConfigurationRevisionId revisionId) => ActAsync(async () =>
    {
        UserId user = await CurrentUserAsync();
        ServerId serverId = Server.Id;
        ServerConfigurationResult result = await Actions.RunAsync<IServerConfigurationEditor, ServerConfigurationResult>(
            (editor, ct) => editor.RestoreAsync(user, serverId, revisionId, ct));
        await SetConfigResultAsync(result, _selectedFile, "Restore enqueued");
    });

    // "Load history" for the Advanced form's file: show that file (its editor and history).
    private void LoadAdvancedHistory()
    {
        PzConfigFile file = ParseFile(_configForm.File);
        if (file != _selectedFile)
        {
            Navigation.NavigateTo(ConfigFileHref(file));
        }
    }

    private static bool InSync(string? baseline, ConfigDocumentView live) =>
        live.BaselineHash is { } current
        && !string.IsNullOrEmpty(baseline)
        && string.Equals(baseline, current, StringComparison.Ordinal);

    private async Task SetConfigResultAsync(ServerConfigurationResult result, PzConfigFile file, string success)
    {
        if (result.Succeeded)
        {
            _configDrift = false;
            if (result.Operation is { } operation)
            {
                if (file == _selectedFile)
                {
                    // Track the write here (#226): the editor shows "Applying…" until the Agent finishes, then
                    // re-reads, so the operator sees the written values and a fresh baseline.
                    _configMessage = null;
                    await TrackWriteAsync(operation);
                }
                else
                {
                    // A by-path edit to another file: show that file, tracking the write.
                    Navigation.NavigateTo(ConfigOperationHref(file, operation));
                }

                return;
            }

            SetConfigMessage($"{success}. The outcome appears on that operation shortly.", ok: true);
            return;
        }

        string message = result.Failure switch
        {
            ServerConfigurationFailure.NotAuthorized => "You are not permitted to edit this server's configuration.",
            ServerConfigurationFailure.ServerNotFound => "That server is no longer available.",
            ServerConfigurationFailure.ServerBusy => "The server is busy with another operation; try again once it finishes.",
            ServerConfigurationFailure.InvalidInput => result.Message ?? "That configuration change is not valid.",
            ServerConfigurationFailure.AgentOffline => result.Message ?? "The server's host is offline; try again once it reconnects.",
            _ => "The configuration change could not be completed.",
        };
        SetConfigMessage(message, ok: false);
    }

    // ---- tracking a write (#226) ---------------------------------------------------------------------------------

    // A ?op= link names a write to track: only a ConfigApply/ConfigApplyRaw for this Server, visible through the
    // tenant filter, counts. Returns whether one is being tracked.
    private async Task<bool> TrackLinkedWriteAsync()
    {
        if (!OperationId.TryParse(OperationParam, out OperationId operationId))
        {
            return false;
        }

        ConfigWriteView? write = await FindWriteAsync(operationId);
        if (write is null)
        {
            return false;
        }

        if (write.IsTerminal)
        {
            _write = write;
            return false;
        }

        await TrackWriteAsync(operationId);
        return true;
    }

    private async Task TrackWriteAsync(OperationId operationId)
    {
        _write = await FindWriteAsync(operationId);
        if (_write is null)
        {
            return;
        }

        if (_write.IsTerminal)
        {
            await WriteFinishedAsync();
            return;
        }

        _tracking = TimeProvider.System.GetUtcNow() - _write.EnqueuedAt < ConfigRefreshWindow;
        if (!_tracking)
        {
            return;
        }

        _trackingCts?.Cancel();
        _trackingCts = new CancellationTokenSource();
        _ = PollWriteAsync(operationId, _trackingCts.Token);
    }

    private async Task PollWriteAsync(OperationId operationId, CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(WritePoll, ct);
                ConfigWriteView? write = await FindWriteAsync(operationId);
                await InvokeAsync(async () =>
                {
                    if (ct.IsCancellationRequested)
                    {
                        return;
                    }

                    _write = write;
                    if (write is null || write.IsTerminal)
                    {
                        await WriteFinishedAsync();
                    }
                    else if (TimeProvider.System.GetUtcNow() - write.EnqueuedAt >= ConfigRefreshWindow)
                    {
                        _tracking = false;
                    }

                    StateHasChanged();
                });

                if (!_tracking)
                {
                    return;
                }
            }
        }
        catch (OperationCanceledException)
        {
            // The section closed, or a newer write is being tracked.
        }
    }

    // The write is done (either way): the host now holds its values, so re-read and reset the draft.
    private async Task WriteFinishedAsync()
    {
        _tracking = false;
        await ReadAsync();
        await LoadHistoryAsync();
    }

    private async Task CheckWriteAgainAsync()
    {
        if (_write is { } write)
        {
            ConfigWriteView? latest = await FindWriteAsync(write.Id);
            _write = latest;
            if (latest is null || latest.IsTerminal)
            {
                await WriteFinishedAsync();
            }
        }
    }

    private async Task<ConfigWriteView?> FindWriteAsync(OperationId operationId)
    {
        ServerId serverId = Server.Id;
        return await Actions.RunAsync<IOperationStore, ConfigWriteView?>(async (store, ct) =>
            await store.FindAsync(operationId, ct) is { } op && op.ServerId == serverId
                && op.Kind is OperationKind.ConfigApply or OperationKind.ConfigApplyRaw
                ? new ConfigWriteView(op.Id, op.State, op.IsTerminal, op.StatusLine, op.FailureReason, op.EnqueuedAt)
                : null);
    }

    // ---- view state ----------------------------------------------------------------------------------------------

    private async Task ActAsync(Func<Task> action)
    {
        _acting = true;
        try
        {
            await action();
        }
        finally
        {
            _acting = false;
        }
    }

    private bool Searching => !string.IsNullOrWhiteSpace(_search);

    private bool Matches(ConfigSettingView setting) =>
        !Searching || $"{setting.Label} {setting.Path}".Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase);

    // While searching every section with a hit opens; otherwise a section follows its own toggle, then the remembered
    // collapse/expand-all.
    private bool IsOpen(string section) =>
        Searching || (_sectionOverrides.TryGetValue(section, out bool open) ? open : !_collapseAll);

    private void ToggleSection(string section) => _sectionOverrides[section] = !IsOpen(section);

    private async Task SetAllSectionsAsync(bool collapsed)
    {
        _collapseAll = collapsed;
        _sectionOverrides.Clear();
        if (_prefs is not null)
        {
            await _prefs.InvokeVoidAsync("set", SectionsPrefKey, collapsed ? "collapsed" : "expanded");
        }
    }

    private void SetConfigMessage(string message, bool ok)
    {
        _configMessage = message;
        _configAlert = ok ? AlertVariant.Success : AlertVariant.Warning;
    }

    public void Dispose()
    {
        _trackingCts?.Cancel();
        _trackingCts?.Dispose();
    }

    private static PzConfigFile ParseFile(string? value) =>
        Enum.TryParse(value, out PzConfigFile file) ? file : PzConfigFile.Ini;

    private static ConfigEditKind ParseKind(string? value) =>
        Enum.TryParse(value, out ConfigEditKind kind) ? kind : ConfigEditKind.Text;

    private static string FileLabel(PzConfigFile file) => file switch
    {
        PzConfigFile.Ini => "servertest.ini",
        PzConfigFile.SandboxVars => "SandboxVars.lua",
        PzConfigFile.SpawnRegions => "spawnregions.lua",
        PzConfigFile.SpawnPoints => "spawnpoints.lua",
        _ => file.ToString(),
    };

    // The four config files, in the tab order shown above the editor.
    private static readonly PzConfigFile[] ConfigFiles =
        [PzConfigFile.Ini, PzConfigFile.SandboxVars, PzConfigFile.SpawnRegions, PzConfigFile.SpawnPoints];

    private string ConfigFileHref(PzConfigFile file) => $"/servers/{Server.Id}?section=config&file={file}";

    // The config section tracking one enqueued write (#226): the page shows it applying, then its outcome.
    private string ConfigOperationHref(PzConfigFile file, OperationId operation) =>
        $"/servers/{Server.Id}?section=config&file={file}&op={operation}";

    private static string RestartHint(PzConfigFile file) => file == PzConfigFile.Ini
        ? "servertest.ini changes are reloaded live on a running server (RCON reloadoptions); if that is not possible they take effect on the next restart. Mods and ports always need a restart."
        : "Sandbox and spawn changes take effect on the next server restart.";

    private static IEnumerable<string> ExtraChoices(ConfigSettingView setting, ConfigEditorRow row) =>
        new[] { row.Original ?? string.Empty, row.Value ?? string.Empty }
            .Distinct(StringComparer.Ordinal)
            .Where(v => !setting.Options.Any(o => string.Equals(o.Value, v, StringComparison.Ordinal)));

    private static bool HasHelp(ConfigSettingView setting) =>
        !string.IsNullOrWhiteSpace(setting.Tooltip) || setting.Options.Count > 0
        || MetaText(setting).Length > 0 || !setting.KnownToSchema;

    // The range/default line shown under a tooltip, e.g. "Range 1–6 · Default 4".
    private static string MetaText(ConfigSettingView setting)
    {
        List<string> parts = [];
        if (setting.Min is { } min && setting.Max is { } max)
        {
            parts.Add($"Range {Trim(min)}–{Trim(max)}");
        }
        else if (setting.Min is { } lo)
        {
            parts.Add($"Min {Trim(lo)}");
        }
        else if (setting.Max is { } hi)
        {
            parts.Add($"Max {Trim(hi)}");
        }

        if (!string.IsNullOrWhiteSpace(setting.Default))
        {
            parts.Add($"Default {setting.Default}");
        }

        return string.Join(" · ", parts);

        static string Trim(double value) =>
            value.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
    }

    private static string ReadOutcomeText(ConfigDocumentView view) => view.Outcome switch
    {
        ConfigReadOutcome.AgentOffline =>
            "The host for this server is offline, so its current configuration can't be loaded. Use Advanced below to edit a setting by path, or bring the host online and reload.",
        ConfigReadOutcome.TimedOut =>
            "The host did not answer the configuration read in time. Try Reload from host; if it persists, check the host's connection.",
        ConfigReadOutcome.FileMissing =>
            "This file does not exist for this server yet — it is created when the server first runs.",
        ConfigReadOutcome.ParseFailed =>
            "The file is on the host but could not be parsed; its raw text is shown below. Fix it with Advanced or on the host, then reload.",
        ConfigReadOutcome.NotAuthorized => "You are not permitted to read this server's configuration.",
        ConfigReadOutcome.ServerNotFound => "That server is no longer available.",
        _ => "The configuration could not be loaded.",
    };

    private static string ChangeText(ConfigValueChange change) => change.Kind switch
    {
        ConfigChangeKind.Added => $"+ {change.Path} = {change.After}",
        ConfigChangeKind.Removed => $"− {change.Path} (was {change.Before})",
        _ => $"{change.Path}: {change.Before} → {change.After}",
    };

    private static string Recorded(DateTimeOffset at) =>
        at.UtcDateTime.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture);

    // #228: why a managed port row is read-only, naming the host port players actually dial. The file holds the
    // container's fixed port; the host side is the stride-allocated binding recorded on the Server.
    private string ManagedNote(string path) => path switch
    {
        "DefaultPort" when Server.GamePort is { } game => $"Managed by ZWarden · players connect on host port {game}",
        "UDPPort" when Server.QueryPort is { } query => $"Managed by ZWarden · published on host port {query}",
        "RCONPort" => "Managed by ZWarden · used by ZWarden's RCON connection, not published on the host",
        _ => "Managed by ZWarden · the server's container depends on it",
    };

    // A tracked configuration write as the section shows it (a plain record: the entity dies with its scope).
    private sealed record ConfigWriteView(
        OperationId Id, OperationState State, bool IsTerminal, string? StatusLine, string? FailureReason, DateTimeOffset EnqueuedAt);

    private sealed class ConfigFormModel
    {
        // The PzConfigFile to edit by path.
        public string? File { get; set; } = nameof(PzConfigFile.Ini);

        // The dotted path of the scalar to change.
        public string? Path { get; set; }

        // The ConfigEditKind name (Bool/Number/Text) interpreting Value.
        public string? Kind { get; set; } = nameof(ConfigEditKind.Bool);

        // The new value in wire form.
        public string? Value { get; set; }
    }
}
