@inherits ServerSectionBase
@using ZWarden.Application.Configuration
@using ZWarden.Application.Operations
@using ZWarden.Domain.Configuration
@using ZWarden.Domain.Operations
@using ZWarden.Web.Hosting
@inject IOperationStore OperationStore
@inject NavigationManager Navigation
@inject IServerConfigurationEditor ConfigEditor
@inject IServerConfigurationReader ConfigReader
@inject IServerConfigurationHistory ConfigHistory

@* The Config rail section (F20/F20c): the live schema editor, the gated raw edit, the scalar apply and the revision
   history, all static-SSR forms gated on the per-server Server.Configuration.Edit by the page and re-checked in the
   services. Values read from the host are untrusted Agent text, rendered as data. *@

<BbCard Class="p-5" data-config-card>
    <h2 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">Configuration</h2>
    <p class="mt-1 text-xs text-muted-foreground">
        The current values of this server's configuration files, read live from the host and grouped for
        editing. Change as many settings as you like, then <span class="font-medium">Apply changes</span> —
        each changed value is re-checked against the live file and refused if it changed outside ZWarden
        (fail-closed), then written byte-for-byte and recorded as a revision. Adding or removing keys is not
        supported — the game owns the key set. <span class="font-mono">.ini</span> changes are reloaded live on a running server (mods and ports still need a restart);
        sandbox and spawn changes take effect on the next restart.
    </p>

    @if (_configDrift)
    {
        <div class="mt-3" data-config-drift>
            <BbAlert Variant="AlertVariant.Warning" AccentBorder>
                <BbAlertDescription>
                    This file changed on the host since you loaded it — another operator or the in-game admin
                    panel wrote it, or the server rewrote it on start. Nothing was applied. The editor below now
                    shows the <span class="font-medium">current</span> values with your changes kept on top
                    (highlighted); review them and <span class="font-medium">Apply changes</span> again to write them.
                </BbAlertDescription>
            </BbAlert>
        </div>
    }

    @if (_configOperation is { } configOp && _configMessage is null)
    {
        @if (!configOp.IsTerminal)
        {
            <div class="mt-3" data-config-applying data-cfg-refresh="@(_configAutoRefresh ? "2" : null)">
                <BbAlert Variant="AlertVariant.Info" AccentBorder>
                    <BbAlertDescription>
                        @if (_configAutoRefresh)
                        {
                            <span>Applying your changes… This page refreshes when the host has written them.</span>
                        }
                        else
                        {
                            <span>This change is still waiting to be applied — the host may be offline or busy.
                                <a class="underline hover:no-underline" href="@ConfigOperationHref(_selectedFile, configOp.Id)">Check again</a>.</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(configOp.StatusLine))
                        {
                            <span class="block text-xs">@configOp.StatusLine</span>
                        }
                        <span class="block font-mono text-xs text-muted-foreground">operation @configOp.Id</span>
                    </BbAlertDescription>
                </BbAlert>
                @if (_configAutoRefresh)
                {
                    <noscript><meta http-equiv="refresh" content="2" /></noscript>
                }
            </div>
        }
        else if (configOp.State == OperationState.Succeeded)
        {
            <div class="mt-3" data-config-applied>
                <BbAlert Variant="AlertVariant.Success" AccentBorder>
                    <BbAlertDescription>
                        @(string.IsNullOrWhiteSpace(configOp.StatusLine) ? "Applied." : configOp.StatusLine)
                        The editor shows the values now on the host.
                    </BbAlertDescription>
                </BbAlert>
            </div>
        }
        else
        {
            <div class="mt-3" data-config-apply-failed>
                <BbAlert Variant="AlertVariant.Warning" AccentBorder>
                    <BbAlertDescription>
                        The change was not applied:
                        @(configOp.State == OperationState.Cancelled
                            ? "the operation was cancelled."
                            : configOp.FailureReason ?? "the host reported a failure.")
                        The editor shows the values currently on the host.
                    </BbAlertDescription>
                </BbAlert>
            </div>
        }
    }

    @if (!string.IsNullOrEmpty(FormRejected) && _configMessage is null)
    {
        <div class="mt-3" data-config-form-rejected>
            <BbAlert Variant="AlertVariant.Warning" AccentBorder>
                <BbAlertDescription>
                    That submission was too large for the server to accept, so nothing was applied. Reload
                    from host and apply your changes again — with scripts enabled only the changed settings
                    are sent.
                </BbAlertDescription>
            </BbAlert>
        </div>
    }

    @if (_configMessage is not null)
    {
        <div class="mt-3" data-config-message>
            <BbAlert Variant="_configAlert" AccentBorder>
                <BbAlertDescription>@_configMessage</BbAlertDescription>
            </BbAlert>
        </div>
    }

    @* File tabs — bookmarkable GET switching (?file=), like the section rail. Switching files discards
       unsaved edits, which is why it is a navigation, not a form control. *@
    <div class="zw-cfg-tabs" data-config-tabs>
        @foreach (PzConfigFile file in ConfigFiles)
        {
            <a class="zw-cfg-tab @(file == _selectedFile ? "active" : string.Empty)"
               href="@ConfigFileHref(file)" data-config-tab="@file">@FileLabel(file)</a>
        }
    </div>

    @if (_configView is { IsRead: true } view && view.Sections.Count > 0)
    {
        <EditForm Model="_editorForm" FormName="config-editor" OnValidSubmit="ConfigEditorAsync"
                  class="mt-2" data-cfg-form>
            <input type="hidden" name="_editorForm.File" value="@_selectedFile" />
            <input type="hidden" name="_editorForm.BaselineHash" value="@_editorForm.BaselineHash" />

            <div class="zw-cfg-toolbar">
                <label class="zw-cfg-searchbox">
                    <ShellIcon Name="search" />
                    <input type="search" placeholder="Search settings…" autocomplete="off"
                           spellcheck="false" aria-label="Search settings" data-cfg-search />
                </label>
                @* #243: collapse/expand every section, remembered per browser. JS-only, so hidden until
                   config-editor.js reveals it; without JS every section simply stays open. *@
                <span class="zw-cfg-sections" data-cfg-sections-controls hidden>
                    @* Outline in the brand accent (style guide: primary marks controls, never status), a step
                       below the filled Apply button. *@
                    <BbButton Type="ButtonType.Button" Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                              Class="zw-cfg-sections-btn" data-cfg-sections="collapse">
                        <ShellIcon Name="chevrons-down-up" />Collapse all
                    </BbButton>
                    <BbButton Type="ButtonType.Button" Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                              Class="zw-cfg-sections-btn" data-cfg-sections="expand">
                        <ShellIcon Name="chevrons-up-down" />Expand all
                    </BbButton>
                </span>
                <span class="zw-spacer"></span>
                <a class="text-xs text-muted-foreground hover:text-foreground" href="@ConfigFileHref(_selectedFile)"
                   data-action="config-reload">Reload from host</a>
                <BbButton Type="ButtonType.Submit" Size="ButtonSize.Small"
                          name="_editorForm.Target" value="apply" data-action="config-apply-batch">Apply changes</BbButton>
            </div>

            <p class="mt-2 text-xs text-muted-foreground">@RestartHint(_selectedFile)</p>

            @{ int rowIndex = 0; }
            @foreach (ConfigSection section in view.Sections)
            {
                <details class="zw-cfg-sec" open data-cfg-sec>
                    <summary>
                        <span>@section.Name</span>
                        <span class="zw-cfg-count">@section.Settings.Count</span>
                    </summary>
                    @foreach (ConfigSettingView setting in section.Settings)
                    {
                        int i = rowIndex++;
                        ConfigEditorRow row = _editorForm.Rows.Count > i ? _editorForm.Rows[i] : new ConfigEditorRow();
                        <div class="zw-cfg-row" data-cfg-row data-cfg-terms="@Terms(setting)"
                             data-cfg-original="@row.Original">
                            <input type="hidden" name="_editorForm.Rows[@i].Path" value="@row.Path" />
                            <input type="hidden" name="_editorForm.Rows[@i].Kind" value="@row.Kind" />
                            <input type="hidden" name="_editorForm.Rows[@i].Original" value="@row.Original" />
                            @if (row.Toggle)
                            {
                                <input type="hidden" name="_editorForm.Rows[@i].Toggle" value="true" />
                            }

                            <div class="zw-cfg-name">
                                <span class="zw-cfg-changed-dot" aria-hidden="true">•</span>
                                <div class="min-w-0">
                                    <span class="zw-cfg-labeltext">@setting.Label</span>
                                    @if (!string.Equals(setting.Label, setting.Path, StringComparison.Ordinal))
                                    {
                                        <span class="zw-cfg-path">@setting.Path</span>
                                    }
                                    @if (setting.Managed)
                                    {
                                        <span class="zw-cfg-path" data-cfg-managed>@ManagedNote(setting.Path)</span>
                                    }
                                </div>
                                @if (HasHelp(setting))
                                {
                                    <span class="zw-cfg-info" tabindex="0" role="button"
                                          aria-label="About @setting.Label">i<span class="zw-cfg-pop" role="tooltip">
                                        @if (!string.IsNullOrWhiteSpace(setting.Tooltip))
                                        {
                                            <div>@setting.Tooltip</div>
                                        }
                                        @if (setting.Options.Count > 0)
                                        {
                                            <div class="zw-cfg-pop-meta">
                                                @foreach (ConfigOption opt in setting.Options)
                                                {
                                                    <div>@opt.Value = @opt.Label</div>
                                                }
                                            </div>
                                        }
                                        @if (MetaText(setting) is { Length: > 0 } meta)
                                        {
                                            <div class="zw-cfg-pop-meta">@meta</div>
                                        }
                                        @if (!setting.KnownToSchema)
                                        {
                                            <div class="zw-cfg-pop-src">Not in ZWarden's schema — applied as-is, unvalidated.</div>
                                        }
                                    </span></span>
                                }
                            </div>

                            <div class="zw-cfg-control">
                                @if (setting.Managed)
                                {
                                    @* #228: ZWarden-managed (the INI ports). Read-only, so it posts its unchanged value and
                                       never becomes an edit; every apply path refuses a change regardless. *@
                                    <input type="text" class="zw-cfg-input" name="_editorForm.Rows[@i].Value"
                                           value="@row.Value" readonly aria-readonly="true" data-cfg-value />
                                }
                                else if (setting.Options.Count > 0)
                                {
                                    <select class="zw-cfg-input" name="_editorForm.Rows[@i].Value" data-cfg-value>
                                        @foreach (ConfigOption opt in setting.Options)
                                        {
                                            <option value="@opt.Value" selected="@(string.Equals(opt.Value, row.Value, StringComparison.Ordinal))">@opt.Label</option>
                                        }
                                        @if (!setting.Options.Any(o => string.Equals(o.Value, row.Value, StringComparison.Ordinal)))
                                        {
                                            <option value="@row.Value" selected>@(string.IsNullOrEmpty(row.Value) ? "(empty)" : row.Value)</option>
                                        }
                                    </select>
                                }
                                else if (setting.Shape == ConfigValueShape.Boolean)
                                {
                                    <label class="zw-cfg-toggle">
                                        <input type="checkbox" class="zw-cfg-switch" name="_editorForm.Rows[@i].Flag"
                                               value="true" checked="@row.Flag" data-cfg-value />
                                        <span class="zw-cfg-state">@(row.Flag ? "On" : "Off")</span>
                                    </label>
                                }
                                else if (setting.Shape is ConfigValueShape.Whole or ConfigValueShape.Fractional)
                                {
                                    <input type="number" class="zw-cfg-input" name="_editorForm.Rows[@i].Value"
                                           value="@row.Value" data-cfg-value
                                           step="@(setting.Shape == ConfigValueShape.Whole ? "1" : "any")"
                                           min="@(setting.Min?.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                           max="@(setting.Max?.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
                                }
                                else
                                {
                                    <input type="text" class="zw-cfg-input" name="_editorForm.Rows[@i].Value"
                                           value="@row.Value" autocomplete="off" spellcheck="false" data-cfg-value />
                                }
                            </div>
                        </div>
                    }
                </details>
            }

            <div class="mt-4 flex flex-wrap gap-2">
                <BbButton Type="ButtonType.Submit" Size="ButtonSize.Small"
                          name="_editorForm.Target" value="apply" data-action="config-apply-batch-bottom">Apply changes</BbButton>
            </div>
        </EditForm>
    }
    else if (_configView is not null && !_configView.IsRead)
    {
        <div class="zw-cfg-empty" data-config-unavailable="@_configView.Outcome">
            @ReadOutcomeText(_configView)
        </div>
    }
    else if (_configView is { IsRead: true })
    {
        <div class="zw-cfg-empty" data-config-empty>No editable settings were found in this file.</div>
    }

    @if (_configView?.RawText is { Length: > 0 } rawText)
    {
        <details class="zw-cfg-raw" data-config-raw>
            <summary><ShellIcon Name="scroll-text" /> Raw file — @FileLabel(_selectedFile)</summary>
            @if (_configView is { IsRead: true })
            {
                @* Gated raw whole-file edit (F20c PR-D, ADR 0042). Arbitrary operator text bypasses the
                   surgical writer and can stop the server on start, so it is gated behind an explicit
                   acknowledgement; the Agent still parse-validates, drift-checks, and writes BOM-less. *@
                <EditForm Model="_rawForm" FormName="config-raw-edit" OnValidSubmit="RawEditAsync"
                          class="mt-2" data-config-raweditform>
                    <input type="hidden" name="_rawForm.File" value="@_selectedFile" />
                    <input type="hidden" name="_rawForm.BaselineHash" value="@_rawForm.BaselineHash" />
                    <p class="mb-2 text-xs text-muted-foreground">
                        Editing the whole file replaces every byte the game reads. A typo can stop the server
                        from starting. The text is re-parsed and re-checked against the live file before it is
                        written; a syntax error or a drift is refused. Prefer the structured editor above unless
                        you need a setting it does not surface (for example the spawn files).
                    </p>
                    <textarea class="zw-cfg-rawedit" name="_rawForm.Content" rows="16" spellcheck="false"
                              autocomplete="off" aria-label="Raw file contents">@(_rawForm.Content ?? rawText)</textarea>
                    <label class="mt-2 flex items-start gap-2 text-xs text-muted-foreground">
                        <input type="checkbox" name="_rawForm.Confirmed" value="true" checked="@_rawForm.Confirmed"
                               data-config-rawconfirm />
                        <span>I understand this replaces the whole file and can prevent the server from starting.</span>
                    </label>
                    <div class="mt-2 flex flex-wrap items-center gap-2">
                        <BbButton Type="ButtonType.Submit" Size="ButtonSize.Small"
                                  data-action="config-raw-apply">Apply raw edit</BbButton>
                        <a class="text-xs text-muted-foreground hover:text-foreground" href="@ConfigFileHref(_selectedFile)"
                           data-action="config-raw-reload">Reload from host</a>
                    </div>
                </EditForm>
            }
            else
            {
                <pre>@rawText</pre>
            }
        </details>
    }

    @* Advanced: the by-path single-edit form. It needs no live read, so it stays available when the host is
       offline, and covers a key the structured editor does not surface (e.g. a spawn-file value). *@
    <details class="mt-6 border-t border-border pt-4" data-config-advanced>
        <summary class="cursor-pointer text-sm font-medium">Advanced — edit a single setting by path</summary>
        <EditForm Model="_configForm" FormName="server-config" OnValidSubmit="ConfigAsync" class="mt-3">
            <DataAnnotationsValidator />
            <div class="grid gap-3 sm:grid-cols-4">
                <div class="flex flex-col text-sm">
                    <BbLabel For="config-file" Class="mb-1 text-muted-foreground">File</BbLabel>
                    @* BbNativeSelect auto-derives only the leaf name under static SSR; set the full model path (#84). *@
                    <BbNativeSelect TValue="string" Id="config-file" Name="_configForm.File" @bind-Value="_configForm!.File">
                        <option value="Ini" selected="@(_configForm!.File is null or "Ini")">servertest.ini</option>
                        <option value="SandboxVars" selected="@(_configForm!.File == "SandboxVars")">SandboxVars.lua</option>
                        <option value="SpawnRegions" selected="@(_configForm!.File == "SpawnRegions")">spawnregions.lua</option>
                        <option value="SpawnPoints" selected="@(_configForm!.File == "SpawnPoints")">spawnpoints.lua</option>
                    </BbNativeSelect>
                </div>
                <div class="flex flex-col text-sm">
                    <BbLabel For="config-path" Class="mb-1 text-muted-foreground">Setting path</BbLabel>
                    <BbInput Id="config-path" @bind-Value="_configForm!.Path" autocomplete="off" Placeholder="e.g. Map.AllowMiniMap" />
                </div>
                <div class="flex flex-col text-sm">
                    <BbLabel For="config-kind" Class="mb-1 text-muted-foreground">Type</BbLabel>
                    <BbNativeSelect TValue="string" Id="config-kind" Name="_configForm.Kind" @bind-Value="_configForm!.Kind">
                        <option value="Bool" selected="@(_configForm!.Kind is null or "Bool")">true / false</option>
                        <option value="Number" selected="@(_configForm!.Kind == "Number")">number</option>
                        <option value="Text" selected="@(_configForm!.Kind == "Text")">text</option>
                    </BbNativeSelect>
                </div>
                <div class="flex flex-col text-sm">
                    <BbLabel For="config-value" Class="mb-1 text-muted-foreground">New value</BbLabel>
                    <BbInput Id="config-value" @bind-Value="_configForm!.Value" autocomplete="off" />
                </div>
            </div>
            <div class="mt-3 flex flex-wrap gap-2">
                <BbButton Type="ButtonType.Submit" Size="ButtonSize.Small"
                          name="_configForm.Target" value="apply" data-action="config-apply">Apply edit</BbButton>
                <BbButton Variant="ButtonVariant.Outline" Type="ButtonType.Submit" Size="ButtonSize.Small"
                          name="_configForm.Target" value="load" data-action="config-load">Load history</BbButton>
            </div>
        </EditForm>
    </details>

    <div class="mt-6 border-t border-border pt-4">
        <h3 class="text-sm font-medium">Revision history — @FileLabel(_selectedFile)</h3>
        <p class="mt-1 text-xs text-muted-foreground">
            Each recorded change to this file, newest first, shown as the parsed values that changed —
            not a text diff (the game rewrites these files on every start). Restoring re-applies a prior
            revision's values as a fresh, drift-checked edit.
        </p>

        @if (_revisions.Count == 0)
        {
            <p class="mt-3 text-sm text-muted-foreground" data-revisions-empty>
                No revisions recorded for this file yet. A revision is recorded the first time a change is applied.
            </p>
        }
        else
        {
            <EditForm Model="_restoreForm" FormName="config-restore" OnValidSubmit="RestoreAsync" class="mt-3 block overflow-x-auto">
                <table class="w-full border-collapse text-left text-sm" data-revisions-table>
                    <thead>
                        <tr class="border-b border-border text-muted-foreground">
                            <th class="py-2 pr-4 font-medium">Recorded (UTC)</th>
                            <th class="py-2 pr-4 font-medium">Changes</th>
                            <th class="py-2 pr-4 font-medium">Snapshot</th>
                            <th class="py-2 font-medium"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (ConfigRevisionView rev in _revisions)
                        {
                            <tr class="border-b border-border/60 align-top" data-revision-row>
                                <td class="py-2 pr-4 tabular-nums">
                                    @Recorded(rev.RecordedAt)
                                    @if (rev.IsCurrent)
                                    {
                                        <span class="ml-1 text-xs text-muted-foreground">(current)</span>
                                    }
                                </td>
                                <td class="py-2 pr-4">
                                    @if (rev.Changes.Count == 0)
                                    {
                                        <span class="text-muted-foreground">baseline</span>
                                    }
                                    else
                                    {
                                        foreach (ConfigValueChange change in rev.Changes)
                                        {
                                            <div class="font-mono text-xs" data-change>@ChangeText(change)</div>
                                        }
                                    }
                                </td>
                                <td class="py-2 pr-4 font-mono text-xs">@rev.ShortHash</td>
                                <td class="py-2">
                                    @if (!rev.IsCurrent)
                                    {
                                        <BbButton Variant="ButtonVariant.Outline" Type="ButtonType.Submit" Size="ButtonSize.Small"
                                                  name="_restoreForm.Target" value="@($"{rev.File}|{rev.Id}")" data-action="config-restore">Restore</BbButton>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </EditForm>
        }
    </div>
</BbCard>

@code {
    // Which config file the live editor shows (F20c). Bookmarkable, GET-switched like ?section=; Ini by default.
    [SupplyParameterFromQuery(Name = "file")]
    public string? FileParam { get; set; }

    // Set by the form-limit guard (#224) when a post was refused before it reached this page; any value shows the
    // "nothing was applied" notice.
    [SupplyParameterFromQuery(Name = FormLimitGuardMiddleware.RejectedQueryKey)]
    public string? FormRejected { get; set; }

    // The configuration write this page is tracking (#226), set by the post-apply redirect. Only a config write for
    // this Server, visible in the tenant, is honoured; anything else is ignored (fail-closed).
    [SupplyParameterFromQuery(Name = "op")]
    public string? OperationParam { get; set; }

    [SupplyParameterFromForm(FormName = "server-config")]
    private ConfigFormModel _configForm { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "config-editor")]
    private ConfigEditorModel _editorForm { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "config-restore")]
    private ConfigRestoreModel _restoreForm { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "config-raw-edit")]
    private ConfigRawEditModel _rawForm { get; set; } = default!;

    private PzConfigFile _selectedFile = PzConfigFile.Ini;
    private IReadOnlyList<ConfigRevisionView> _revisions = [];
    private ConfigDocumentView? _configView;
    private string? _configMessage;
    private AlertVariant _configAlert = AlertVariant.Warning;
    private bool _configDrift;

    // The tracked configuration write (#226) and whether the page should keep refreshing while it runs.
    private Operation? _configOperation;
    private bool _configAutoRefresh;

    // How long the page keeps auto-refreshing a write that has not finished (e.g. a queued write to an offline host).
    private static readonly TimeSpan ConfigRefreshWindow = TimeSpan.FromMinutes(2);

    protected override async Task OnInitializedAsync()
    {
        _configForm ??= new ConfigFormModel();
        _editorForm ??= new ConfigEditorModel();
        _restoreForm ??= new ConfigRestoreModel();
        _rawForm ??= new ConfigRawEditModel();
        _configForm.File ??= nameof(PzConfigFile.Ini);
        _configForm.Kind ??= nameof(ConfigEditKind.Bool);

        // Only this section reads the host, and the page renders it only for a permitted operator. The file is
        // chosen by the ?file= query param (bookmarkable tab switching, GET); Ini by default. On a GET — or a post
        // from another form — the editor's row list is empty, so load the current values from the host now. A
        // config-editor POST arrives with its rows already bound and its submit handler applies them and then
        // re-reads, so we must not clobber those posted rows here.
        UserId user = await CurrentUserAsync();
        ServerId serverId = Server.Id;
        _selectedFile = ParseFile(FileParam ?? _editorForm.File ?? _configForm.File);
        await LoadHistoryAsync(user, serverId);
        await LoadConfigOperationAsync(serverId);
        // Always read so the editor form is present in this render — static SSR dispatches a form's submit handler
        // only to a form that is actually rendered. Rebuild the editable row list from the read on a GET (or a post
        // from another form); on a config-editor post the rows are already bound with the operator's edits, so
        // preserve them for the submit handler to diff. While a tracked write is still running (#226) the host
        // still holds the old values, so the editor is withheld rather than shown stale; the page refreshes and
        // reads once the Agent is done.
        if (!_configAutoRefresh)
        {
            await ReadConfigViewAsync(user, serverId, rebuildRows: _editorForm.Rows.Count == 0);
        }
    }

    private async Task ConfigAsync()
    {
        ServerId serverId = Server.Id;

        UserId user = await CurrentUserAsync();
        ConfigFormModel form = _configForm ?? new ConfigFormModel();
        _selectedFile = ParseFile(form.File);

        if (string.Equals(form.Target, "apply", StringComparison.Ordinal))
        {
            string path = form.Path?.Trim() ?? string.Empty;
            if (path.Length == 0)
            {
                SetConfigMessage("Enter the setting path to change (e.g. Map.AllowMiniMap).", ok: false);
            }
            else
            {
                // Drift-check against the file as it is now (#226), not ZWarden's last recorded revision — PZ or an
                // in-game editor may have changed values since, which would refuse every by-path edit. Reuse this
                // request's read when it is of the same file; otherwise read that file. No read ⇒ the recorded
                // revision (the enqueuer's fallback), so an edit to an offline host still queues.
                ConfigDocumentView live = _configView is { IsRead: true } && string.Equals(
                        _editorForm.File, _selectedFile.ToString(), StringComparison.Ordinal)
                    ? _configView
                    : await ConfigReader.ReadAsync(user, serverId, _selectedFile);
                ConfigApplyEdit edit = new(path, ParseKind(form.Kind), form.Value ?? string.Empty);
                ServerConfigurationResult result = await ConfigEditor.ApplyAsync(
                    user, serverId, _selectedFile, [edit], expectedBaselineHash: live.IsRead ? live.BaselineHash : null);
                SetConfigResult(result, $"Edit to {path} enqueued");
            }
        }

        await LoadHistoryAsync(user, serverId);
    }

    private async Task RestoreAsync()
    {
        ServerId serverId = Server.Id;

        // The restore button carries "{file}|{revisionId}" so the right file's history reloads after the post.
        string token = _restoreForm?.Target ?? string.Empty;
        string[] parts = token.Split('|', 2);
        if (parts.Length == 2 && Enum.TryParse(parts[0], out PzConfigFile file)
            && ConfigurationRevisionId.TryParse(parts[1], out ConfigurationRevisionId revisionId))
        {
            _selectedFile = file;
            UserId user = await CurrentUserAsync();
            ServerConfigurationResult result = await ConfigEditor.RestoreAsync(user, serverId, revisionId);
            SetConfigResult(result, "Restore enqueued");
            await LoadHistoryAsync(user, serverId);
        }
    }

    // Resolves the ?op= write this page is tracking (#226): a ConfigApply/ConfigApplyRaw for this Server, visible
    // through the tenant filter; anything else is ignored. While it runs the page refreshes itself (for a bounded
    // window), so the editor is re-read — showing the written values and a fresh baseline — once the Agent is done.
    private async Task LoadConfigOperationAsync(ServerId serverId)
    {
        if (!OperationId.TryParse(OperationParam, out OperationId operationId))
        {
            return;
        }

        Operation? operation = await OperationStore.FindAsync(operationId);
        if (operation is null || operation.ServerId != serverId
            || operation.Kind is not (OperationKind.ConfigApply or OperationKind.ConfigApplyRaw))
        {
            return;
        }

        _configOperation = operation;
        _configAutoRefresh = !operation.IsTerminal
            && TimeProvider.System.GetUtcNow() - operation.EnqueuedAt < ConfigRefreshWindow;
    }

    // Reads the live Configuration View of the selected file from the host and rebuilds the editor's row list
    // from it (F20c). Fail-closed and non-throwing: every unavailable/denied case is an outcome on _configView
    // that the markup renders as an operator message. Nothing is persisted (ADR 0011).
    private async Task ReadConfigViewAsync(UserId user, ServerId serverId, bool rebuildRows)
    {
        _configView = await ConfigReader.ReadAsync(user, serverId, _selectedFile);
        _editorForm.File = _selectedFile.ToString();
        if (rebuildRows)
        {
            _editorForm.Rows = BuildRows(_configView);
            // Carry the baseline the operator is about to see, so a later apply drift-checks against it (ADR 0042).
            _editorForm.BaselineHash = _configView.IsRead ? _configView.BaselineHash : null;
        }

        // Prime the raw-edit form's file + baseline from this read too — but only when it is not itself being
        // submitted (Content bound), so a raw-edit post keeps the baseline the operator saw for its drift check.
        if (_rawForm.Content is null)
        {
            _rawForm.File = _selectedFile.ToString();
            _rawForm.BaselineHash = _configView.IsRead ? _configView.BaselineHash : null;
        }
    }

    // Flattens the view's sections into the editor's row list, in render order, so a row's index matches the
    // markup's running index and the posted _editorForm.Rows[i] binds back to the same setting.
    private static List<ConfigEditorRow> BuildRows(ConfigDocumentView view)
    {
        List<ConfigEditorRow> rows = [];
        if (!view.IsRead)
        {
            return rows;
        }

        foreach (ConfigSection section in view.Sections)
        {
            foreach (ConfigSettingView setting in section.Settings)
            {
                // Mirrors the markup: a choice list wins over the toggle, so only a Boolean with no options renders
                // (and posts) the switch.
                bool toggle = setting.Shape == ConfigValueShape.Boolean && setting.Options.Count == 0;
                rows.Add(new ConfigEditorRow
                {
                    Path = setting.Path,
                    Kind = setting.Kind.ToString(),
                    Original = setting.Value,
                    Value = setting.Value,
                    Toggle = toggle,
                    Flag = toggle && string.Equals(setting.Value, "true", StringComparison.Ordinal),
                });
            }
        }

        return rows;
    }

    // The batch-apply submit handler (F20c): diff each posted row against the value it was rendered with and
    // enqueue only the changed ones as a single surgical apply, then re-read to refresh the editor and history.
    private async Task ConfigEditorAsync()
    {
        ServerId serverId = Server.Id;

        UserId user = await CurrentUserAsync();
        _selectedFile = ParseFile(_editorForm.File);

        List<ConfigApplyEdit> edits = [];
        foreach (ConfigEditorRow row in _editorForm.Rows)
        {
            if (string.IsNullOrEmpty(row.Path))
            {
                continue;
            }

            // The posted value comes from the control the row rendered, not its Kind (#223): a toggle posts Flag, every
            // other control (including a boolean offered as a choice list) posts Value.
            ConfigEditKind kind = ParseKind(row.Kind);
            string current = row.Toggle ? (row.Flag ? "true" : "false") : row.Value ?? string.Empty;
            if (!string.Equals(current, row.Original ?? string.Empty, StringComparison.Ordinal))
            {
                edits.Add(new ConfigApplyEdit(row.Path!, kind, current));
            }
        }

        // OnInitializedAsync already re-read the live file for this POST (so the form could render), so the drift
        // pre-check is free: compare the baseline the operator was shown (the posted hidden field) against the
        // fresh read. A mismatch — or a read that could not confirm the current state — refuses to enqueue and
        // shows the confirm-and-override banner over the current values; the Agent's own fail-closed check (ADR
        // 0011) still guards the residual race between this read and the write (F20c, ADR 0042).
        string? liveBaseline = _configView is { IsRead: true } ? _configView.BaselineHash : null;
        bool inSync = liveBaseline is not null
            && !string.IsNullOrEmpty(_editorForm.BaselineHash)
            && string.Equals(_editorForm.BaselineHash, liveBaseline, StringComparison.Ordinal);

        if (edits.Count == 0)
        {
            SetConfigMessage("No changes to apply — every setting still holds its loaded value.", ok: false);
        }
        else if (_configView is not { IsRead: true })
        {
            // The live re-read failed (host offline/timeout/parse), so the current state cannot be confirmed —
            // refuse rather than write against an unknown baseline.
            SetConfigMessage(
                "Could not read the current configuration from the host, so nothing was applied. "
                + "Try Reload from host, then apply again.",
                ok: false);
        }
        else if (!inSync)
        {
            // Drift: the file changed since the operator loaded it (or the baseline could not be matched). Show the
            // current values and the confirm-and-override banner; do not enqueue.
            _configDrift = true;
        }
        else
        {
            ServerConfigurationResult result = await ConfigEditor.ApplyAsync(
                user, serverId, _selectedFile, edits, expectedBaselineHash: _editorForm.BaselineHash);
            SetConfigResult(result, $"{edits.Count} change{(edits.Count == 1 ? string.Empty : "s")} enqueued");
        }

        // Nothing was enqueued (a successful apply redirects, #226): refresh the editor from the view already read for
        // this request (OnInitializedAsync read it so the form could render). Refreshing the baseline too means a
        // reapply after drift carries the current hash (the operator is now writing on top of the live state).
        ConfigDocumentView refreshed = _configView ?? ConfigDocumentView.OfOutcome(ConfigReadOutcome.Read);
        _editorForm.Rows = BuildRows(refreshed);
        _editorForm.BaselineHash = refreshed.IsRead ? refreshed.BaselineHash : null;
        if (_configDrift)
        {
            // Keep the operator's edits across a drift refusal (#226): carry each onto the fresh row, whose Original
            // is now the current host value, so it shows as changed and a second Apply writes it on top.
            CarryEdits(_editorForm.Rows, edits);
        }

        await LoadHistoryAsync(user, serverId);
    }

    private static void CarryEdits(List<ConfigEditorRow> rows, List<ConfigApplyEdit> edits)
    {
        Dictionary<string, string> byPath = edits
            .GroupBy(e => e.Path, StringComparer.Ordinal)
            .ToDictionary(g => g.Key, g => g.Last().Value, StringComparer.Ordinal);
        foreach (ConfigEditorRow row in rows)
        {
            if (row.Path is null || !byPath.TryGetValue(row.Path, out string? value))
            {
                continue;
            }

            if (row.Toggle)
            {
                row.Flag = string.Equals(value, "true", StringComparison.Ordinal);
            }
            else
            {
                row.Value = value;
            }
        }
    }

    // The gated raw whole-file edit submit handler (F20c PR-D, ADR 0042). Requires the explicit acknowledgement,
    // drift-pre-checks against the fresh read exactly like the structured editor, then stages the text and enqueues
    // a ConfigApplyRaw Operation. The Agent still parse-validates and drift-checks before it writes.
    private async Task RawEditAsync()
    {
        ServerId serverId = Server.Id;

        UserId user = await CurrentUserAsync();
        _selectedFile = ParseFile(_rawForm.File);
        string content = _rawForm.Content ?? string.Empty;

        string? liveBaseline = _configView is { IsRead: true } ? _configView.BaselineHash : null;
        bool inSync = liveBaseline is not null
            && !string.IsNullOrEmpty(_rawForm.BaselineHash)
            && string.Equals(_rawForm.BaselineHash, liveBaseline, StringComparison.Ordinal);

        if (!_rawForm.Confirmed)
        {
            SetConfigMessage("Confirm you understand a raw edit replaces the whole file before applying it.", ok: false);
        }
        else if (string.IsNullOrWhiteSpace(content))
        {
            SetConfigMessage("The edited file text is empty, so nothing was applied.", ok: false);
        }
        else if (_configView is not { IsRead: true })
        {
            SetConfigMessage(
                "Could not read the current configuration from the host, so the raw edit was not applied. "
                + "Try Reload from host, then apply again.",
                ok: false);
        }
        else if (!inSync)
        {
            // Drift: the file changed since the operator loaded it. A raw edit cannot be auto-merged, so keep their
            // text, do not enqueue, and show the banner — they Reload from host to pick up the current text and
            // re-make their change. The stale baseline is left in place so a blind re-submit re-drifts (fail closed).
            _configDrift = true;
        }
        else
        {
            ServerConfigurationResult result = await ConfigEditor.ApplyRawAsync(
                user, serverId, _selectedFile, content, expectedBaselineHash: _rawForm.BaselineHash);
            SetConfigResult(result, "raw whole-file edit enqueued");
        }

        await LoadHistoryAsync(user, serverId);
    }

    private async Task LoadHistoryAsync(UserId user, ServerId serverId) =>
        _revisions = await ConfigHistory.GetHistoryAsync(user, serverId, _selectedFile);

    private void SetConfigResult(ServerConfigurationResult result, string success)
    {
        if (result.Succeeded)
        {
            if (result.Operation is { } operation)
            {
                // Post/Redirect/Get onto the config section tracking this write (#226): it shows "Applying…" until
                // the Agent finishes, then re-reads the host, so the operator sees the written values and a fresh
                // baseline, never the pre-write read this POST rendered from.
                Navigation.NavigateTo(ConfigOperationHref(_selectedFile, operation));
                return;
            }

            SetConfigMessage($"{success}. The outcome appears on that operation shortly.", ok: true);
            return;
        }

        string message = result.Failure switch
        {
            ServerConfigurationFailure.NotAuthorized => "You are not permitted to edit this server's configuration.",
            ServerConfigurationFailure.ServerNotFound => "That server is no longer available.",
            ServerConfigurationFailure.ServerBusy => "The server is busy with another operation; try again once it finishes.",
            ServerConfigurationFailure.InvalidInput => result.Message ?? "That configuration change is not valid.",
            ServerConfigurationFailure.AgentOffline => result.Message ?? "The server's host is offline; try again once it reconnects.",
            _ => "The configuration change could not be completed.",
        };
        SetConfigMessage(message, ok: false);
    }

    private void SetConfigMessage(string message, bool ok)
    {
        _configMessage = message;
        _configAlert = ok ? AlertVariant.Success : AlertVariant.Warning;
    }

    private static PzConfigFile ParseFile(string? value) =>
        Enum.TryParse(value, out PzConfigFile file) ? file : PzConfigFile.Ini;

    private static ConfigEditKind ParseKind(string? value) =>
        Enum.TryParse(value, out ConfigEditKind kind) ? kind : ConfigEditKind.Text;

    private static string FileLabel(PzConfigFile file) => file switch
    {
        PzConfigFile.Ini => "servertest.ini",
        PzConfigFile.SandboxVars => "SandboxVars.lua",
        PzConfigFile.SpawnRegions => "spawnregions.lua",
        PzConfigFile.SpawnPoints => "spawnpoints.lua",
        _ => file.ToString(),
    };

    // The four config files, in the tab order shown above the editor.
    private static readonly PzConfigFile[] ConfigFiles =
        [PzConfigFile.Ini, PzConfigFile.SandboxVars, PzConfigFile.SpawnRegions, PzConfigFile.SpawnPoints];

    private string ConfigFileHref(PzConfigFile file) => $"/servers/{Server.Id}?section=config&file={file}";

    // The config section tracking one enqueued write (#226): the page shows it applying, then its outcome.
    private string ConfigOperationHref(PzConfigFile file, OperationId operation) =>
        $"/servers/{Server.Id}?section=config&file={file}&op={operation}";

    private static string RestartHint(PzConfigFile file) => file == PzConfigFile.Ini
        ? "servertest.ini changes are reloaded live on a running server (RCON reloadoptions); if that is not possible they take effect on the next restart. Mods and ports always need a restart."
        : "Sandbox and spawn changes take effect on the next server restart.";

    // The lower-cased haystack the client-side search filters each row against (label + dotted path).
    private static string Terms(ConfigSettingView setting) =>
        $"{setting.Label} {setting.Path}".ToLowerInvariant();

    private static bool HasHelp(ConfigSettingView setting) =>
        !string.IsNullOrWhiteSpace(setting.Tooltip) || setting.Options.Count > 0
        || MetaText(setting).Length > 0 || !setting.KnownToSchema;

    // The range/default line shown under a tooltip, e.g. "Range 1–6 · Default 4".
    private static string MetaText(ConfigSettingView setting)
    {
        List<string> parts = [];
        if (setting.Min is { } min && setting.Max is { } max)
        {
            parts.Add($"Range {Trim(min)}–{Trim(max)}");
        }
        else if (setting.Min is { } lo)
        {
            parts.Add($"Min {Trim(lo)}");
        }
        else if (setting.Max is { } hi)
        {
            parts.Add($"Max {Trim(hi)}");
        }

        if (!string.IsNullOrWhiteSpace(setting.Default))
        {
            parts.Add($"Default {setting.Default}");
        }

        return string.Join(" · ", parts);

        static string Trim(double value) =>
            value.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
    }

    private static string ReadOutcomeText(ConfigDocumentView view) => view.Outcome switch
    {
        ConfigReadOutcome.AgentOffline =>
            "The host for this server is offline, so its current configuration can't be loaded. Use Advanced below to edit a setting by path, or bring the host online and reload.",
        ConfigReadOutcome.TimedOut =>
            "The host did not answer the configuration read in time. Try Reload from host; if it persists, check the host's connection.",
        ConfigReadOutcome.FileMissing =>
            "This file does not exist for this server yet — it is created when the server first runs.",
        ConfigReadOutcome.ParseFailed =>
            "The file is on the host but could not be parsed; its raw text is shown below. Fix it with Advanced or on the host, then reload.",
        ConfigReadOutcome.NotAuthorized => "You are not permitted to read this server's configuration.",
        ConfigReadOutcome.ServerNotFound => "That server is no longer available.",
        _ => "The configuration could not be loaded.",
    };

    private static string ChangeText(ConfigValueChange change) => change.Kind switch
    {
        ConfigChangeKind.Added => $"+ {change.Path} = {change.After}",
        ConfigChangeKind.Removed => $"− {change.Path} (was {change.Before})",
        _ => $"{change.Path}: {change.Before} → {change.After}",
    };

    private static string Recorded(DateTimeOffset at) =>
        at.UtcDateTime.ToString("yyyy-MM-dd HH:mm", System.Globalization.CultureInfo.InvariantCulture);

    // #228: why a managed port row is read-only, naming the host port players actually dial. The file holds the
    // container's fixed port; the host side is the stride-allocated binding recorded on the Server.
    private string ManagedNote(string path) => path switch
    {
        "DefaultPort" when Server.GamePort is { } game => $"Managed by ZWarden · players connect on host port {game}",
        "UDPPort" when Server.QueryPort is { } query => $"Managed by ZWarden · published on host port {query}",
        "RCONPort" => "Managed by ZWarden · used by ZWarden's RCON connection, not published on the host",
        _ => "Managed by ZWarden · the server's container depends on it",
    };

    private sealed class ConfigFormModel
    {
        // The PzConfigFile to edit and whose history is shown.
        public string? File { get; set; }

        // The dotted path of the scalar to change.
        public string? Path { get; set; }

        // The ConfigEditKind name (Bool/Number/Text) interpreting Value.
        public string? Kind { get; set; }

        // The new value in wire form.
        public string? Value { get; set; }

        // The submit button's verb ("apply"/"load").
        public string? Target { get; set; }
    }

    private sealed class ConfigRestoreModel
    {
        // The restore button's "{file}|{revisionId}" token.
        public string? Target { get; set; }
    }

    // The gated raw whole-file edit model (F20c PR-D, ADR 0042). Content is the operator-authored text; Confirmed is
    // the required acknowledgement (a raw edit replaces the whole file and can stop the server on start); File and
    // BaselineHash travel hidden so the apply targets the right file and drift-checks against what was loaded.
    private sealed class ConfigRawEditModel
    {
        public string? File { get; set; }

        public string? BaselineHash { get; set; }

        public string? Content { get; set; }

        public bool Confirmed { get; set; }
    }

    // The live schema editor's batch model (F20c): one row per rendered setting. The hidden Path/Kind/Original
    // travel with each row so the changed set can be computed from the post alone, without a re-read that could
    // race the host rewriting the file. Value carries text/number/enum controls; Flag carries the boolean toggle.
    private sealed class ConfigEditorModel
    {
        // Which PzConfigFile these rows belong to (hidden) — the file the apply targets.
        public string? File { get; set; }

        // The live-read baseline the operator was shown (hidden): the canonical value hash of the state these
        // rows were rendered from (F20c, ADR 0042). Sent back on apply so the Agent drift-checks against what the
        // operator saw, and compared on post against a fresh read to raise the confirm-and-override banner.
        public string? BaselineHash { get; set; }

        // The submit button's verb; only "apply" today (file switching and reload are GETs via ?file=).
        public string? Target { get; set; }

        public List<ConfigEditorRow> Rows { get; set; } = [];
    }

    private sealed class ConfigEditorRow
    {
        // The dotted path of the scalar (hidden).
        public string? Path { get; set; }

        // The ConfigEditKind name (Bool/Number/Text) interpreting the value (hidden).
        public string? Kind { get; set; }

        // The value this row was rendered with, so a change can be detected on post (hidden).
        public string? Original { get; set; }

        // The edited value for text/number/enum controls.
        public string? Value { get; set; }

        // The edited value for a boolean toggle (a checkbox posts nothing when off, binding to false).
        public bool Flag { get; set; }

        // Whether this row rendered the boolean toggle (hidden), so the post reads Flag rather than Value (#223).
        public bool Toggle { get; set; }
    }
}
