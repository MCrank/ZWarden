@using ZWarden.Domain.Servers
@using ZWarden.Web.Components.Ui
@using ZWarden.Web.Components.Servers
@inject NavigationManager Nav

@* The Fleet board table (#158) — the one interactive island on the otherwise static-SSR /servers page. The
   parent does the authorized, tenant-filtered load and hands the already-projected rows in (a static snapshot;
   this island adds sort + row-click, not live refresh). It touches no tenant-scoped service — safe in a circuit,
   which has no HttpContext (ADR 0040 posture) — it only renders the rows it was given. Row-click navigates to
   Server Detail; the Server cell is also a real <a> so it works without JS and the URL is in the prerendered
   HTML. Bb-over-raw-HTML (ADR 0003): BbDataGrid is the sanctioned fleet table. All row text is untrusted
   Agent-reported data, rendered as data (trust-boundaries §3/§8). The rows are the first render; the live parts
   are the Status badge (#253) and the fleet facts (#257): the static parent names the batched status endpoint and
   live-status.js updates each [data-fleet-server] cell (players, CPU, memory, uptime, version) in place by Server
   id — no tenant work in this circuit. A meter cell renders both the MeterBar and its — so the script can show
   whichever applies; Tick was dropped (#257: no data source). *@

<div data-fleet-board>
    <BbDataGrid TData="FleetRow"
                Items="Rows"
                ShowPagination="false"
                StickyHeader="true"
                OnRowClick="Navigate"
                AriaLabel="Fleet servers"
                Class="text-sm">
        <EmptyTemplate>
            <div class="py-10 text-center text-sm text-muted-foreground" data-servers-empty>
                No servers yet. Deploy one with Deploy server above, or import a discovered container below to bring one
                under management.
            </div>
        </EmptyTemplate>
        <Columns>
            <BbDataGridTemplateColumn TData="FleetRow" Title="Server" Sortable="true" SortBy="@(r => (object)r.Name)">
                <ChildContent Context="r">
                    <a href="@($"/servers/{r.Id}")" class="font-medium text-foreground hover:underline" data-server-link>@r.Name</a>
                    <span class="block font-mono text-xs text-muted-foreground" data-fleet-host>@r.Host</span>
                    @if (!string.IsNullOrWhiteSpace(r.Description))
                    {
                        <span class="block text-xs text-muted-foreground">@r.Description</span>
                    }
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="FleetRow" Title="Status" Sortable="true" SortBy="@(r => (object)(int)r.RunState)">
                @* #253: data-live-row keys the badge by Server id so live-status.js re-tones this row in place. *@
                <ChildContent Context="r">
                    <span data-live-row="@r.Id"><StatusBadge State="r.StatusTone" Text="@r.StatusLabel" /></span>
                    @* #275: Workshop updates the running server doesn't have yet; outside the live-rewritten badge. *@
                    @if (r.ModUpdates > 0)
                    {
                        <a href="@($"/servers/{r.Id}?section=mods")" class="mt-1 block text-xs text-status-busy hover:underline"
                           data-fleet-mod-updates>@r.ModUpdates mod update@(r.ModUpdates == 1 ? "" : "s")</a>
                    }
                </ChildContent>
            </BbDataGridTemplateColumn>

            @* #257: players from the Agent's slow RCON sample; the tooltip says how old it is. #337: over the ini's MaxPlayers. *@
            <BbDataGridTemplateColumn TData="FleetRow" Title="Players" Sortable="true" SortBy="@(r => (object)(r.Players ?? -1))">
                <ChildContent Context="r">
                    <span class="font-mono text-xs tabular-nums @(r.Players is null ? "text-muted-foreground" : "text-foreground")"
                          data-fleet-server="@r.Id" data-fleet-cell="players" title="@r.PlayersAge">@FleetFacts.FormatPlayers(r.Players, r.MaxPlayers)</span>
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="FleetRow" Title="CPU">
                <ChildContent Context="r">
                    <span data-fleet-server="@r.Id" data-fleet-cell="cpu">
                        <span data-meter-slot hidden="@(r.CpuPercent is null)"><MeterBar Value="@(r.CpuPercent ?? 0)" Max="100" Label="CPU" /></span>
                        <span data-meter-empty hidden="@(r.CpuPercent is not null)" class="font-mono text-xs text-muted-foreground">—</span>
                    </span>
                </ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="FleetRow" Title="Memory">
                <ChildContent Context="r">
                    @{ bool hasMemory = r.MemoryUsedBytes is not null && r.MemoryLimitBytes is > 0; }
                    <span data-fleet-server="@r.Id" data-fleet-cell="memory">
                        <span data-meter-slot hidden="@(!hasMemory)"><MeterBar Value="@(r.MemoryUsedBytes ?? 0)" Max="@(r.MemoryLimitBytes ?? 0)" Label="Memory" /></span>
                        <span data-meter-empty hidden="@hasMemory" class="font-mono text-xs text-muted-foreground">—</span>
                    </span>
                </ChildContent>
            </BbDataGridTemplateColumn>

            @* #257: container uptime (Docker StartedAt), so it includes PZ boot time and resets on a restart. *@
            <BbDataGridTemplateColumn TData="FleetRow" Title="Uptime">
                <ChildContent Context="r"><span class="font-mono text-xs tabular-nums text-muted-foreground" data-fleet-server="@r.Id" data-fleet-cell="uptime">@r.Uptime</span></ChildContent>
            </BbDataGridTemplateColumn>

            <BbDataGridTemplateColumn TData="FleetRow" Title="Version" Sortable="true" SortBy="@(r => (object)r.Version)">
                @* #258: the Build 42 branch is a second muted line, like the host under the Server name. It sits outside the
                   version span, which live-status.js rewrites. *@
                <ChildContent Context="r">
                    <span class="font-mono text-xs tabular-nums text-muted-foreground" data-fleet-server="@r.Id" data-fleet-cell="version" title="@r.VersionTitle">@r.Version</span>
                    <span class="block font-mono text-xs text-muted-foreground" title="@ServerBranchView.Note(r.Branch)" data-fleet-branch>@ServerBranchView.Label(r.Branch)</span>
                </ChildContent>
            </BbDataGridTemplateColumn>
        </Columns>
    </BbDataGrid>
</div>

@code {
    /// <summary>The projected rows to show — the caller has already authorized and tenant-filtered them.</summary>
    [Parameter]
    [EditorRequired]
    public IReadOnlyList<FleetRow> Rows { get; set; } = [];

    private void Navigate(FleetRow row) => Nav.NavigateTo($"/servers/{row.Id}");
}
