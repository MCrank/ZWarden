@page "/servers/{Id}"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IAsyncDisposable
@using System.Security.Claims
@using Microsoft.Extensions.Logging
@using ZWarden.Application.Operations
@using ZWarden.Domain.Ids
@using ZWarden.Infrastructure.Tenancy
@using ZWarden.Web.Time
@using ZWarden.Web.Components.Servers
@using ZWarden.Web.Components.Pages.Servers.Sections
@inject ActionScopeRunner Actions
@inject IOperatorTimeZoneProvider OperatorTz
@inject UserManager<ApplicationUser> Users
@inject IJSRuntime JS
@inject ILogger<ServerDetail> Logger

@* The server-detail page (F16/F19). Interactive (#299, ADR 0046): it runs in a circuit, so forms and buttons are
   circuit handlers and the header updates in place. The first paint is prerendered on the request, and the load it
   did (the Server, every permission flag, the header) reaches the circuit through [PersistentState] instead of being
   loaded again. Every service call goes through ActionScopeRunner, a DI scope (and DbContext) per call carrying the
   circuit's tenant (#297). Authorization is the fail-closed per-Server Server.View inside the inventory load; each
   control gates on its per-server permission, and every service re-checks it on every action (ADR 0018). All
   Agent-reported text (including usernames) is untrusted and rendered as data (§8).
   #298: the page owns the route, the Server load, every per-server permission gate, the header (lifecycle,
   countdown restart, last failure) and the rail; each rail section is its own component under Sections/ and owns
   its forms, handlers and data. *@

<PageTitle>@(_server?.Name ?? "Server") — ZWarden</PageTitle>

<p class="text-sm"><a href="/servers" class="text-muted-foreground hover:text-foreground">← Servers</a></p>
@* "on" once the circuit has rendered the page, so a browser test knows the buttons are live (a click on the
   prerendered markup before then does nothing). The instance id changes when a new circuit (a resume after a pause
   or eviction) renders the page afresh. *@
<span hidden data-circuit="@(_circuitReady ? "on" : "off")" data-circuit-instance="@_instance"></span>

@if (_server is null || _perm is null)
{
    @if (_loaded)
    {
        <div class="mt-6" data-server-missing>
            <BbAlert Variant="AlertVariant.Warning" AccentBorder>
                <BbAlertDescription>That server does not exist, or you do not have permission to view it.</BbAlertDescription>
            </BbAlert>
        </div>
    }
}
else
{
    @* Sticky server header (name + status + lifecycle), above the rail and content. The lifecycle controls
       (F15) render for whoever holds the matching Server.Start/Stop/Restart and are disabled by the last
       observed run-state; the service re-checks fail-closed on every action. The circuit re-reads the status
       (#249) every few seconds, faster while an Operation is in flight. *@
    <div class="zw-srvhead mt-2" data-live-status-circuit data-status-busy="@(_status.Busy ? "true" : "false")">
        <h1 class="text-2xl font-semibold tracking-tight">@_server.Name</h1>
        <StatusBadge State="_status.Tone" Text="@_status.Label" />
        @* #254: what the in-flight Operation is doing (e.g. the restart countdown). Untrusted Agent text, always
           rendered as text; hidden when there is none. *@
        <span class="text-xs text-muted-foreground" data-status-detail hidden="@(_status.Detail is null)">@_status.Detail</span>
        <span class="zw-spacer"></span>
        @if (_perm.CanStart || _perm.CanStop || _perm.CanRestart || _perm.CanUpdate)
        {
            <div class="zw-lifebtns">
                @if (_perm.CanStart)
                {
                    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                              Disabled="@(!_status.CanStart || _acting)" OnClick="@(() => LifecycleAsync("start"))" data-action="server-start">
                        <ShellIcon Name="play" /><span class="ml-1">Start</span>
                    </BbButton>
                }
                @if (_perm.CanStop)
                {
                    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                              Disabled="@(!_status.CanStop || _acting)" OnClick="@(() => LifecycleAsync("stop"))" data-action="server-stop">
                        <ShellIcon Name="square" /><span class="ml-1">Stop</span>
                    </BbButton>
                }
                @if (_perm.CanRestart)
                {
                    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                              Disabled="@(!_status.CanRestart || _acting)" OnClick="@(() => LifecycleAsync("restart"))" data-action="server-restart">
                        <ShellIcon Name="rotate-cw" /><span class="ml-1">Restart</span>
                    </BbButton>
                }
                @* #273: the F17 game update (warn → safe stop → SteamCMD on the server's branch → boot), gated on
                   Server.Update. The note says which branch it pulls from; a pinned server stays on its version. *@
                @if (_perm.CanUpdate)
                {
                    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                              Disabled="@(!_status.CanUpdate || _acting)" OnClick="@(() => LifecycleAsync("update"))" data-action="server-update"
                              title="@ServerBranchView.UpdateNote(_server.Branch)">
                        <ShellIcon Name="download" /><span class="ml-1">Update game</span>
                    </BbButton>
                    <span class="text-xs text-muted-foreground" data-update-branch>@ServerBranchView.UpdateNote(_server.Branch)</span>
                }
            </div>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(_server.Description))
    {
        <p class="mt-1 text-sm text-muted-foreground">@_server.Description</p>
    }
    @if (_lifecycleMessage is not null)
    {
        <div class="mt-3" data-lifecycle-message>
            <BbAlert Variant="_lifecycleAlert" AccentBorder>
                <BbAlertDescription>@_lifecycleMessage</BbAlertDescription>
            </BbAlert>
        </div>
    }

    @* #266: the last action's failure and why — a refused Recreate used to look like a silent no-op. Shown until a
       later action succeeds; the reason is untrusted Agent text, rendered as text. Dismissal is a per-viewer
       convenience remembered by operation id in this browser (dismissed-failures.js). *@
    @if (VisibleFailure is { } failure)
    {
        <div class="mt-3" data-last-failure data-last-failure-id="@failure.OperationId">
            <BbAlert Variant="AlertVariant.Danger" AccentBorder>
                <BbAlertDescription>
                    <div class="flex items-start gap-3">
                        <div class="flex-1">
                            <p>
                                <span class="font-semibold"><span data-last-failure-action>@failure.Action</span> failed</span>
                                <span class="text-xs text-muted-foreground">· <span data-last-failure-at>@failure.At</span></span>
                            </p>
                            <p class="mt-1 wrap-break-word" data-last-failure-reason>@failure.Reason</p>
                        </div>
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="@(() => DismissFailureAsync(failure.OperationId))"
                                  data-last-failure-dismiss aria-label="Dismiss this failure">Dismiss</BbButton>
                    </div>
                </BbAlertDescription>
            </BbAlert>
        </div>
    }

    @* Graceful restart (#114, #213): warn connected players with a countdown before the restart. Surfaced as an
       always-visible panel (not a collapsed disclosure) so it is discoverable, and the operator picks how long to
       warn. Gated on the same server-scoped Server.Restart the service re-checks. *@
    @if (_perm.CanRestart)
    {
        <div class="mt-3 rounded-md border border-border bg-card p-4" data-graceful-restart>
            <h2 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">Restart with a countdown</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Warn connected players in-game, then safely restart. Choose how long to warn before the restart —
                mods and sandbox changes take effect on the next start.
            </p>
            <EditForm Model="_gracefulForm" OnValidSubmit="GracefulRestartAsync" class="mt-3">
                <DataAnnotationsValidator />
                <div class="flex flex-col gap-3 sm:flex-row sm:items-end">
                    <div class="flex flex-col text-sm">
                        <BbLabel For="graceful-countdown" Class="mb-1 text-muted-foreground">Countdown</BbLabel>
                        <BbNativeSelect TValue="string" Id="graceful-countdown" @bind-Value="_gracefulForm.Countdown">
                            <option value="5m">5 minutes</option>
                            <option value="15m">15 minutes</option>
                            <option value="1m">1 minute</option>
                            <option value="immediate">Immediately (no warning)</option>
                        </BbNativeSelect>
                    </div>
                    <div class="flex flex-1 flex-col text-sm">
                        <BbLabel For="graceful-message" Class="mb-1 text-muted-foreground">Message to players (optional)</BbLabel>
                        <BbInput Id="graceful-message" UpdateTiming="UpdateTiming.Immediate" @bind-Value="_gracefulForm.Message" autocomplete="off"
                                 Placeholder="Scheduled maintenance." />
                    </div>
                    <BbButton Variant="ButtonVariant.Secondary" Type="ButtonType.Submit" Size="ButtonSize.Small"
                              Disabled="@(!_status.CanRestart || _acting)" data-action="graceful-restart">Restart</BbButton>
                </div>
            </EditForm>
        </div>
    }

    <div class="zw-srvlayout mt-6">
        @* Grouped vertical rail (#162). Each item links to its ?section= (bookmarkable), so only the selected
           section — and its one live panel — renders. A section appears only where the operator holds its
           per-server permission. *@
        <nav class="zw-rail" aria-label="Server sections" data-server-rail>
            <a class="zw-railitem @Active("overview")" href="@SectionHref("overview")" data-rail-item="overview">
                <ShellIcon Name="layout-dashboard" /><span>Overview</span>
            </a>

            @if (_perm.Players.CanAny || _perm.CanExecuteConsole || _perm.CanViewLogs)
            {
                <div class="zw-railgrp">Operate</div>
                @if (_perm.Players.CanAny)
                {
                    <a class="zw-railitem @Active("players")" href="@SectionHref("players")" data-rail-item="players">
                        <ShellIcon Name="users" /><span>Players</span>
                    </a>
                }
                @if (_perm.CanExecuteConsole)
                {
                    <a class="zw-railitem @Active("console")" href="@SectionHref("console")" data-rail-item="console">
                        <ShellIcon Name="terminal" /><span>Console</span>
                    </a>
                }
                @if (_perm.CanViewLogs)
                {
                    <a class="zw-railitem @Active("logs")" href="@SectionHref("logs")" data-rail-item="logs">
                        <ShellIcon Name="scroll-text" /><span>Logs</span>
                    </a>
                }
            }

            @if (_perm.Players.CanConfigEdit || _perm.CanViewMods)
            {
                <div class="zw-railgrp">Configure</div>
                @if (_perm.Players.CanConfigEdit)
                {
                    <a class="zw-railitem @Active("config")" href="@SectionHref("config")" data-rail-item="config">
                        <ShellIcon Name="sliders" /><span>Config</span>
                    </a>
                }
                @if (_perm.CanViewMods)
                {
                    <a class="zw-railitem @Active("mods")" href="@SectionHref("mods")" data-rail-item="mods">
                        <ShellIcon Name="package" /><span>Mods</span>
                    </a>
                }
                @* Mod Browser (#110): preview/search Workshop content before installing. Gated on Mod.View, the same
                   read permission the service re-checks fail-closed on resolve. *@
                @if (_perm.CanViewMods)
                {
                    <a class="zw-railitem @Active("modbrowser")" href="@SectionHref("modbrowser")" data-rail-item="modbrowser">
                        <ShellIcon Name="search" /><span>Mod Browser</span>
                    </a>
                }
            }

            @if (_perm.Backups.CanView || _perm.CanViewDiagnostics)
            {
                <div class="zw-railgrp">Maintain</div>
                @if (_perm.Backups.CanView)
                {
                    <a class="zw-railitem @Active("backups")" href="@SectionHref("backups")" data-rail-item="backups">
                        <ShellIcon Name="archive" /><span>Backups</span>
                    </a>
                }
                @if (_perm.CanViewDiagnostics)
                {
                    <a class="zw-railitem @Active("diagnostics")" href="@SectionHref("diagnostics")" data-rail-item="diagnostics">
                        <ShellIcon Name="activity" /><span>Diagnostics</span>
                    </a>
                }
            }
        </nav>

        <div class="zw-secbody" data-section="@_activeSection">
            @* Only the selected section renders (and so only its data loads); ResolveSection has already failed an
               unauthorized ?section= closed to the overview. *@
            <CascadingValue Name="@ServerDetailCascade.OperatorZone" Value="_zone" IsFixed="true">
                @switch (_activeSection)
                {
                    case "logs":
                        <LogsSection Server="_server" />
                        break;
                    case "console":
                        <ConsoleSection Server="_server" />
                        break;
                    case "diagnostics":
                        <DiagnosticsSection Server="_server" CanExport="_perm.CanExportDiagnostics" />
                        break;
                    case "players":
                        <PlayersSection Server="_server" Perm="_perm.Players" />
                        break;
                    case "mods":
                        <ModsSection Server="_server" Perm="_perm.Mods" />
                        break;
                    case "modbrowser":
                        <ModBrowserSection Server="_server" Perm="_perm.Mods" />
                        break;
                    case "config":
                        <ConfigurationSection Server="_server" />
                        break;
                    case "backups":
                        <BackupsSection Server="_server" Perm="_perm.Backups" />
                        break;
                    default:
                        <OverviewSection Server="_server" Status="_status" LastUpdate="LastUpdate"
                                         CanRecreate="_perm.CanRecreate" CanDelete="_perm.CanDelete"
                                         OnLifecycleResult="OnLifecycleResultAsync" OnLifecycleWarning="OnLifecycleWarning" />
                        break;
                }
            </CascadingValue>
        </div>
    </div>
}

@* Overlays (BbAlertDialog and friends) render into this page's own portal host: the shell is static, so a host
   there would be inert (ADR 0046). *@
<BbPortalHost />

@code {
    // Header re-read cadence (#249): faster while a mutating Operation holds the Server, slower when idle.
    private static readonly TimeSpan BusyPoll = TimeSpan.FromSeconds(2);
    private static readonly TimeSpan IdlePoll = TimeSpan.FromSeconds(5);

    [Parameter]
    public string Id { get; set; } = string.Empty;

    // Which rail section to render (#162). Absent, unknown, or unauthorized falls back to overview (fail-closed).
    [SupplyParameterFromQuery]
    public string? Section { get; set; }

    /// <summary>The prerender's load, handed to the circuit (#299).</summary>
    [PersistentState]
    public ServerDetailState? State { get; set; }

    /// <summary>The operator's display zone, read from the request cookie while prerendering: a circuit has no
    /// request to read it from.</summary>
    [PersistentState]
    public string? ZoneId { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private readonly GracefulRestartFormModel _gracefulForm = new();
    private readonly HashSet<string> _dismissedFailures = new(StringComparer.Ordinal);
    private CancellationTokenSource? _polling;
    private IJSObjectReference? _failures;
    private string? _checkedFailureId;
    private bool _loaded;
    private bool _circuitReady;
    private readonly string _instance = Guid.NewGuid().ToString("N");
    private bool _acting;
    private string _activeSection = "overview";
    private TimeZoneInfo _zone = TimeZoneInfo.Utc;
    private string? _lifecycleMessage;
    private AlertVariant _lifecycleAlert = AlertVariant.Warning;

    private ServerSummary? _server => State?.Header.Server;
    private ServerDetailPermissions? _perm => State?.Permissions;
    private ServerStatusView _status => State?.Header.Status ?? ServerLiveStatus.Resolve(ServerRunState.Unknown, activeOperation: null);

    private (string Summary, string At)? LastUpdate =>
        State?.Header.LastUpdate is { } update ? (update.Summary, update.At) : null;

    private ServerFailureView? VisibleFailure =>
        State?.Header.LastFailure is { } failure && !_dismissedFailures.Contains(failure.OperationId) ? failure : null;

    protected override async Task OnParametersSetAsync()
    {
        ZoneId ??= OperatorTz.Zone.Id;
        _zone = OperatorTimeZone.Resolve(ZoneId);

        if (!ServerId.TryParse(Id, out ServerId serverId))
        {
            State = null;
            _loaded = true;
            return;
        }

        // The prerender's load arrives through [PersistentState]; load only when there is none, or when an enhanced
        // navigation moved this page to another Server.
        if (State is null || State.Header.Server.Id != serverId)
        {
            UserId user = await CurrentUserAsync();
            State = await Actions.RunAsync<ServerDetailQuery, ServerDetailState?>(
                (query, ct) => query.LoadAsync(user, serverId, _zone, ct));
        }

        _loaded = true;

        // Resolve the active section only after the per-section gates are known, so an unknown or unauthorized
        // ?section= fails closed to the always-available overview.
        _activeSection = ResolveSection(Section);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _polling = new CancellationTokenSource();
            _ = PollHeaderAsync(_polling.Token);
            _circuitReady = true;
            StateHasChanged();
        }

        // Hide a failure this viewer dismissed before (checked once per failure, in the browser's storage).
        if (State?.Header.LastFailure is { } failure && failure.OperationId != _checkedFailureId)
        {
            _checkedFailureId = failure.OperationId;
            _failures ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/dismissed-failures.js");
            if (await _failures.InvokeAsync<bool>("isDismissed", failure.OperationId))
            {
                _dismissedFailures.Add(failure.OperationId);
                StateHasChanged();
            }
        }
    }

    // The fail-closed rail: a section is selectable only where the operator holds its per-server permission.
    private string ResolveSection(string? requested) => _perm is not { } p ? "overview" : requested switch
    {
        "players" when p.Players.CanAny => "players",
        "console" when p.CanExecuteConsole => "console",
        "logs" when p.CanViewLogs => "logs",
        "config" when p.Players.CanConfigEdit => "config",
        "mods" when p.CanViewMods => "mods",
        "modbrowser" when p.CanViewMods => "modbrowser",
        "backups" when p.Backups.CanView => "backups",
        "diagnostics" when p.CanViewDiagnostics => "diagnostics",
        _ => "overview",
    };

    private string Active(string section) => _activeSection == section ? "active" : string.Empty;

    private string SectionHref(string section) => section == "overview"
        ? $"/servers/{Id}"
        : $"/servers/{Id}?section={section}";

    // Re-reads the header in this circuit (#249), replacing live-status.js on this page. A failed read is logged and
    // retried on the next tick: the header just stays as it was.
    private async Task PollHeaderAsync(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(_status.Busy ? BusyPoll : IdlePoll, ct);
                try
                {
                    await RefreshHeaderAsync(ct);
                }
                catch (Exception ex) when (ex is not OperationCanceledException)
                {
                    Logger.LogWarning(ex, "Server Detail header refresh failed for {ServerId}; retrying.", Id);
                }
            }
        }
        catch (OperationCanceledException)
        {
            // The page closed.
        }
    }

    private async Task RefreshHeaderAsync(CancellationToken ct = default)
    {
        if (State is not { } state)
        {
            return;
        }

        UserId user = await CurrentUserAsync();
        ServerId serverId = state.Header.Server.Id;
        ServerDetailHeader? header = await Actions.RunAsync<ServerDetailQuery, ServerDetailHeader?>(
            (query, token) => query.ReadHeaderAsync(user, serverId, _zone, token), ct);
        if (header is null)
        {
            return;
        }

        await InvokeAsync(() =>
        {
            if (State is { } current && current.Header.Server.Id == serverId)
            {
                State = current with { Header = header };
                StateHasChanged();
            }
        });
    }

    private async Task LifecycleAsync(string command)
    {
        if (_server is not { } server)
        {
            return;
        }

        _acting = true;
        try
        {
            UserId user = await CurrentUserAsync();
            ServerId serverId = server.Id;
            ServerLifecycleResult? result = await Actions.RunAsync<IServerLifecycle, ServerLifecycleResult?>(
                async (lifecycle, ct) => command switch
                {
                    "start" => await lifecycle.StartAsync(user, serverId, ct),
                    "stop" => await lifecycle.StopAsync(user, serverId, ct),
                    "restart" => await lifecycle.RestartAsync(user, serverId, cancellationToken: ct),
                    "update" => await lifecycle.UpdateAsync(user, serverId, ct),
                    _ => null,
                });

            SetLifecycleResult(command, result);
            await RefreshHeaderAsync();
        }
        finally
        {
            _acting = false;
        }
    }

    private async Task GracefulRestartAsync()
    {
        if (_server is not { } server)
        {
            return;
        }

        string? message = string.IsNullOrWhiteSpace(_gracefulForm.Message) ? null : _gracefulForm.Message.Trim();
        if (message is not null && BroadcastMessageRules.ValidateMessage(message) is { } invalid)
        {
            _lifecycleAlert = AlertVariant.Warning;
            _lifecycleMessage = invalid;
            return;
        }

        var plan = new GracefulRestartPayload(ServerDetailFormat.CountdownLeads(_gracefulForm.Countdown), message);

        _acting = true;
        try
        {
            UserId user = await CurrentUserAsync();
            ServerId serverId = server.Id;
            SetLifecycleResult("restart", await Actions.RunAsync<IServerLifecycle, ServerLifecycleResult>(
                (lifecycle, ct) => lifecycle.RestartAsync(user, serverId, plan, ct)));
            await RefreshHeaderAsync();
        }
        finally
        {
            _acting = false;
        }
    }

    private async Task DismissFailureAsync(string operationId)
    {
        _dismissedFailures.Add(operationId);
        _failures ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/dismissed-failures.js");
        await _failures.InvokeVoidAsync("dismiss", operationId);
    }

    // Overview's Recreate / Delete (#229, #271) answered by the lifecycle service: shown in the header like the header's
    // own actions, with the status re-read so the page already says RECREATING / DELETING.
    private async Task OnLifecycleResultAsync(LifecycleOutcome outcome)
    {
        SetLifecycleResult(outcome.Command, outcome.Result);
        await RefreshHeaderAsync();
    }

    // Overview's Recreate refused before it was sent (an invalid port or heap).
    private void OnLifecycleWarning(string message)
    {
        _lifecycleAlert = AlertVariant.Warning;
        _lifecycleMessage = message;
    }

    private void SetLifecycleResult(string command, ServerLifecycleResult? result)
    {
        if (result is null)
        {
            _lifecycleAlert = AlertVariant.Warning;
            _lifecycleMessage = "Choose a lifecycle action.";
            return;
        }

        if (result.Succeeded)
        {
            string what = command switch
            {
                "start" => "Start",
                "stop" => "Stop",
                "restart" => "Restart",
                "recreate" => "Recreate",
                "update" => "Game update",
                _ => "Action",
            };
            _lifecycleAlert = AlertVariant.Success;
            _lifecycleMessage = $"{what} enqueued (operation {result.Operation}). The run-state updates once the server reports it.";
            return;
        }

        _lifecycleAlert = AlertVariant.Warning;
        _lifecycleMessage = result.Failure switch
        {
            ServerLifecycleFailure.NotAuthorized => "You are not permitted to perform that action on this server.",
            ServerLifecycleFailure.ServerNotFound => "That server is no longer available.",
            ServerLifecycleFailure.ServerBusy => "The server is busy with another operation; try again once it finishes.",
            ServerLifecycleFailure.InvalidPort => "That game port is not allowed.",
            ServerLifecycleFailure.PortInUse => "That game port (or the one above it) is already used by another server on this host.",
            ServerLifecycleFailure.InvalidHeap => "That heap is not allowed.",
            ServerLifecycleFailure.OverCapacity => "That heap does not fit the host's free memory; confirm to recreate it anyway.",
            ServerLifecycleFailure.ConfirmationMismatch => "The name you typed did not match the server's name, so nothing was deleted.",
            _ => "The action could not be started.",
        };
    }

    private async Task<UserId> CurrentUserAsync()
    {
        ClaimsPrincipal principal = (await AuthState!).User;
        return Guid.TryParse(Users.GetUserId(principal), out Guid id)
            ? UserId.FromGuid(id)
            : throw new InvalidOperationException("Authenticated request carries no user id claim.");
    }

    public async ValueTask DisposeAsync()
    {
        if (_polling is not null)
        {
            await _polling.CancelAsync();
            _polling.Dispose();
        }

        if (_failures is not null)
        {
            try
            {
                await _failures.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone; the module goes with it.
            }
        }
    }

    private sealed class GracefulRestartFormModel
    {
        // An optional message broadcast to players during the restart countdown (#114).
        public string? Message { get; set; }

        // The chosen countdown preset (#213): "15m" / "5m" / "1m" / "immediate". Defaults to the five-minute
        // warning; mapped to a descending schedule in GracefulRestartAsync.
        public string Countdown { get; set; } = "5m";
    }
}
