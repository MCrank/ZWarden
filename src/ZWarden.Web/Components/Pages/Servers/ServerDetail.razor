@page "/servers/{Id}"
@attribute [Authorize]
@* #224: the config editor posts ~5 values per setting, so a full B42 SandboxVars (~280 settings) posted whole (the
   no-JS path) exceeds the form reader's default 1024-value limit. Raised for this page only and bounded to Blazor's
   1024-element form-collection limit (~5 values x 1024 rows); a larger post is refused by FormLimitGuardMiddleware with
   an operator message. config-editor.js normally posts just the changed rows. *@
@attribute [Microsoft.AspNetCore.Mvc.RequestFormLimits(ValueCountLimit = 6144)]
@using System.Security.Claims
@using ZWarden.Application.Authorization
@using ZWarden.Application.Backups
@using ZWarden.Application.Configuration
@using ZWarden.Application.Console
@using ZWarden.Application.Diagnostics
@using ZWarden.Application.Mods
@using ZWarden.Application.Operations
@using ZWarden.Application.Players
@using ZWarden.Application.Servers
@using ZWarden.Application.Workshop
@using ZWarden.Domain.Authorization
@using ZWarden.Domain.Backups
@using ZWarden.Domain.Configuration
@using ZWarden.Domain.Ids
@using ZWarden.Domain.Operations
@using ZWarden.Web.Hosting
@using ZWarden.Web.Time
@inject IServerInventory Inventory
@inject IServerBackup ServerBackups
@inject IServerRestore ServerRestores
@inject IBackupQuery BackupQuery
@inject IPlayerManagement Players
@inject IBanQuery Bans
@inject IConsoleCommandService ConsoleService
@inject IOperationCoordinator Operations
@inject IOperationStore OperationStore
@inject NavigationManager Navigation
@inject IServerConfigurationEditor ConfigEditor
@inject IServerConfigurationReader ConfigReader
@inject IServerConfigurationHistory ConfigHistory
@inject IModDiscoveryService ModDiscovery
@inject IServerModManager ModManager
@inject IServerLifecycle Lifecycle
@inject IModInventoryCache ModInventories
@inject IWorkshopMetadataService WorkshopMetadata
@inject IWorkshopSearchService WorkshopSearch
@inject IWorkshopSettingsService WorkshopSettings
@inject IPermissionChecker PermissionChecker
@inject IOperatorTimeZoneProvider OperatorTz
@inject UserManager<ApplicationUser> Users

@* The server-detail page (F16/F19). Static server render like /servers: it runs per request with a live
   HttpContext, so the session-derived tenant resolves and the authorized load is tenant-filtered. Authorization
   is the fail-closed per-Server Server.View inside Inventory.GetVisibleAsync; the player controls gate on the
   per-server Player.* / Server.Configuration.Edit, re-checked in the service on submit (ADR 0018). The durable
   metadata + last-reported health render statically here; the LIVE meters/health and the LIVE roster ride
   interactive islands that read only the ownership-guarded in-memory caches (no tenant context, which a circuit
   lacks). All Agent-reported text (including usernames) is untrusted and rendered as data (§8). *@

<PageTitle>@(_server?.Name ?? "Server") — ZWarden</PageTitle>

<p class="text-sm"><a href="/servers" class="text-muted-foreground hover:text-foreground">← Servers</a></p>

@if (_server is null)
{
    <div class="mt-6" data-server-missing>
        <BbAlert Variant="AlertVariant.Warning" AccentBorder>
            <BbAlertDescription>That server does not exist, or you do not have permission to view it.</BbAlertDescription>
        </BbAlert>
    </div>
}
else
{
    @* Sticky server header (name + status + lifecycle), above the rail and content. The lifecycle controls
       (F15) render for whoever holds the matching Server.Start/Stop/Restart and are disabled by the last
       observed run-state; the service re-checks fail-closed on submit. *@
    <div class="zw-srvhead mt-2">
        <h1 class="text-2xl font-semibold tracking-tight">@_server.Name</h1>
        <StatusBadge State="_server.LastRunState" />
        <span class="zw-spacer"></span>
        @if (_canStart || _canStop || _canRestartServer)
        {
            <EditForm Model="_lifecycleForm" FormName="server-lifecycle" OnValidSubmit="LifecycleAsync" class="zw-lifebtns">
                @if (_canStart)
                {
                    <BbButton Variant="ButtonVariant.Outline" Type="ButtonType.Submit" Size="ButtonSize.Small"
                              Disabled="@(!StartEnabled)" name="_lifecycleForm.Command" value="start" data-action="server-start">
                        <ShellIcon Name="play" /><span class="ml-1">Start</span>
                    </BbButton>
                }
                @if (_canStop)
                {
                    <BbButton Variant="ButtonVariant.Outline" Type="ButtonType.Submit" Size="ButtonSize.Small"
                              Disabled="@(!StopEnabled)" name="_lifecycleForm.Command" value="stop" data-action="server-stop">
                        <ShellIcon Name="square" /><span class="ml-1">Stop</span>
                    </BbButton>
                }
                @if (_canRestartServer)
                {
                    <BbButton Variant="ButtonVariant.Outline" Type="ButtonType.Submit" Size="ButtonSize.Small"
                              Disabled="@(!RestartEnabled)" name="_lifecycleForm.Command" value="restart" data-action="server-restart">
                        <ShellIcon Name="rotate-cw" /><span class="ml-1">Restart</span>
                    </BbButton>
                }
            </EditForm>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(_server.Description))
    {
        <p class="mt-1 text-sm text-muted-foreground">@_server.Description</p>
    }
    @if (_lifecycleMessage is not null)
    {
        <div class="mt-3" data-lifecycle-message>
            <BbAlert Variant="_lifecycleAlert" AccentBorder>
                <BbAlertDescription>@_lifecycleMessage</BbAlertDescription>
            </BbAlert>
        </div>
    }

    @* Graceful restart (#114, #213): warn connected players with a countdown before the restart. Surfaced as an
       always-visible panel (not a collapsed disclosure) so it is discoverable, and the operator picks how long to
       warn. Static-SSR form, gated on the same server-scoped Server.Restart the service re-checks on submit. *@
    @if (_canRestartServer)
    {
        <div class="mt-3 rounded-md border border-border bg-card p-4" data-graceful-restart>
            <h2 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">Restart with a countdown</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Warn connected players in-game, then safely restart. Choose how long to warn before the restart —
                mods and sandbox changes take effect on the next start.
            </p>
            <EditForm Model="_gracefulForm" FormName="server-graceful-restart" OnValidSubmit="GracefulRestartAsync" class="mt-3">
                <DataAnnotationsValidator />
                <div class="flex flex-col gap-3 sm:flex-row sm:items-end">
                    <div class="flex flex-col text-sm">
                        <BbLabel For="graceful-countdown" Class="mb-1 text-muted-foreground">Countdown</BbLabel>
                        @* Explicit Name for static-SSR binding on BbNativeSelect (#84). *@
                        @* Default (5 minutes) first: under static SSR BbNativeSelect shows the first option, so the
                           default option leads to keep the shown value and the model default in agreement (#84). *@
                        <BbNativeSelect TValue="string" Id="graceful-countdown" Name="_gracefulForm.Countdown" @bind-Value="_gracefulForm.Countdown">
                            <option value="5m">5 minutes</option>
                            <option value="15m">15 minutes</option>
                            <option value="1m">1 minute</option>
                            <option value="immediate">Immediately (no warning)</option>
                        </BbNativeSelect>
                    </div>
                    <div class="flex flex-1 flex-col text-sm">
                        <BbLabel For="graceful-message" Class="mb-1 text-muted-foreground">Message to players (optional)</BbLabel>
                        @* BbInput auto-derives the model-path Name (_gracefulForm.Message) under the EditForm (#121). *@
                        <BbInput Id="graceful-message" @bind-Value="_gracefulForm.Message" autocomplete="off"
                                 Placeholder="Scheduled maintenance." />
                    </div>
                    <BbButton Variant="ButtonVariant.Secondary" Type="ButtonType.Submit" Size="ButtonSize.Small"
                              Disabled="@(!RestartEnabled)" data-action="graceful-restart">Restart</BbButton>
                </div>
            </EditForm>
        </div>
    }

    <div class="zw-srvlayout mt-6">
        @* Grouped vertical rail (#162). Each item links to its ?section= (static SSR, bookmarkable), so only
           the selected section — and its one Live* island — renders. A section appears only where the operator
           holds its per-server permission; the reserved Mod Browser slot is a disabled placeholder. *@
        <nav class="zw-rail" aria-label="Server sections" data-server-rail>
            <a class="zw-railitem @Active("overview")" href="@SectionHref("overview")" data-rail-item="overview">
                <ShellIcon Name="layout-dashboard" /><span>Overview</span>
            </a>

            @if (_perm.CanAny || _canExecuteConsole || _canViewLogs)
            {
                <div class="zw-railgrp">Operate</div>
                @if (_perm.CanAny)
                {
                    <a class="zw-railitem @Active("players")" href="@SectionHref("players")" data-rail-item="players">
                        <ShellIcon Name="users" /><span>Players</span>
                    </a>
                }
                @if (_canExecuteConsole)
                {
                    <a class="zw-railitem @Active("console")" href="@SectionHref("console")" data-rail-item="console">
                        <ShellIcon Name="terminal" /><span>Console</span>
                    </a>
                }
                @if (_canViewLogs)
                {
                    <a class="zw-railitem @Active("logs")" href="@SectionHref("logs")" data-rail-item="logs">
                        <ShellIcon Name="scroll-text" /><span>Logs</span>
                    </a>
                }
            }

            @if (_perm.CanConfigEdit || _canViewMods)
            {
                <div class="zw-railgrp">Configure</div>
                @if (_perm.CanConfigEdit)
                {
                    <a class="zw-railitem @Active("config")" href="@SectionHref("config")" data-rail-item="config">
                        <ShellIcon Name="sliders" /><span>Config</span>
                    </a>
                }
                @if (_canViewMods)
                {
                    <a class="zw-railitem @Active("mods")" href="@SectionHref("mods")" data-rail-item="mods">
                        <ShellIcon Name="package" /><span>Mods</span>
                    </a>
                }
                @* Mod Browser (#110): preview/search Workshop content before installing. Gated on Mod.View, the same
                   read permission the service re-checks fail-closed on resolve. *@
                @if (_canViewMods)
                {
                    <a class="zw-railitem @Active("modbrowser")" href="@SectionHref("modbrowser")" data-rail-item="modbrowser">
                        <ShellIcon Name="search" /><span>Mod Browser</span>
                    </a>
                }
            }

            @if (_backupPerm.CanView || _canViewDiagnostics)
            {
                <div class="zw-railgrp">Maintain</div>
                @if (_backupPerm.CanView)
                {
                    <a class="zw-railitem @Active("backups")" href="@SectionHref("backups")" data-rail-item="backups">
                        <ShellIcon Name="archive" /><span>Backups</span>
                    </a>
                }
                @if (_canViewDiagnostics)
                {
                    <a class="zw-railitem @Active("diagnostics")" href="@SectionHref("diagnostics")" data-rail-item="diagnostics">
                        <ShellIcon Name="activity" /><span>Diagnostics</span>
                    </a>
                }
            }
        </nav>

        <div class="zw-secbody" data-section="@_activeSection">
    @if (_activeSection == "overview")
    {
        <div class="grid gap-6 sm:grid-cols-2" data-overview>
            <BbCard Class="p-5">
                <h2 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">Details</h2>
                <dl class="mt-3 space-y-2 text-sm">
                    <div class="flex justify-between gap-4">
                        <dt class="text-muted-foreground">Host</dt>
                        <dd class="font-mono text-xs">@_server.AgentId</dd>
                    </div>
                    <div class="flex justify-between gap-4">
                        <dt class="text-muted-foreground">Ports</dt>
                        <dd class="font-mono tabular-nums text-xs">@Ports()</dd>
                    </div>
                    <div class="flex justify-between gap-4">
                        <dt class="text-muted-foreground">Last-reported health</dt>
                        <dd data-last-health>@(_server.LastHealth?.ToString() ?? "—")</dd>
                    </div>
                    <div class="flex justify-between gap-4">
                        <dt class="text-muted-foreground">Health reported (UTC)</dt>
                        <dd class="tabular-nums">@Reported(_server.LastHealthReportedAt)</dd>
                    </div>
                </dl>
            </BbCard>

            <BbCard Class="p-5">
                <h2 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">Live telemetry</h2>
                <div class="mt-3">
                    <LiveServerPanel @rendermode="InteractiveServer"
                                     ServerId="@_server.Id.ToString()"
                                     AgentId="@_server.AgentId.ToString()"
                                     InitialHealth="@(_server.LastHealth?.ToString())" />
                </div>
            </BbCard>
        </div>
    }

    @if (_activeSection == "logs")
    {
        <BbCard Class="p-5" data-logs-card>
            <h2 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">Live logs</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                The server's live console output (stdout and stderr), streamed from the host only while this panel is
                open. Lines are shown as-is and are not stored — a live tail, not a searchable history.
            </p>
            <div class="mt-4">
                <LiveServerLogPanel @rendermode="InteractiveServer"
                                    ServerId="@_server.Id.ToString()"
                                    AgentId="@_server.AgentId.ToString()"
                                    TimeZoneId="@OperatorTz.Zone.Id" />
            </div>
        </BbCard>
    }

    @if (_activeSection == "console")
    {
        <BbCard Class="p-5" data-console-card>
            <h2 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">Console</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Run an admin RCON command against the running server. Quote multi-word arguments
                (e.g. <span class="font-mono">servermsg "Hello all"</span>). Credential commands
                (<span class="font-mono">adduser</span>, <span class="font-mono">setpassword</span>, …) and
                <span class="font-mono">quit</span> are blocked; stop the server from its lifecycle controls instead.
                Every command is recorded in the audit log.
            </p>

            @if (_consoleMessage is not null)
            {
                <div class="mt-3" data-console-message>
                    <BbAlert Variant="@_consoleAlert" AccentBorder>
                        <BbAlertDescription>@_consoleMessage</BbAlertDescription>
                    </BbAlert>
                </div>
            }

            <EditForm Model="_consoleForm" FormName="console-command" OnValidSubmit="ConsoleAsync" class="mt-4">
                <DataAnnotationsValidator />
                <div class="flex flex-col gap-2 sm:flex-row sm:items-end">
                    <div class="flex flex-1 flex-col text-sm">
                        <BbLabel For="console-input" Class="mb-1 text-muted-foreground">Command</BbLabel>
                        @* BbInput auto-derives the model-path Name (_consoleForm.Input) under the EditForm (#121). *@
                        <BbInput Id="console-input" @bind-Value="_consoleForm.Input" autocomplete="off"
                                 spellcheck="false" Class="font-mono" Placeholder="players" />
                    </div>
                    <BbButton Variant="ButtonVariant.Secondary" Type="ButtonType.Submit" Size="ButtonSize.Small"
                              data-action="run-console">Run</BbButton>
                </div>
            </EditForm>

            <div class="mt-4">
                <h3 class="text-sm font-medium">Output</h3>
                <p class="mt-1 text-xs text-muted-foreground">
                    The server's reply to the last command, shown as-is and not stored — each command replaces it.
                    The audit log keeps the history of commands run.
                </p>
                <div class="mt-3">
                    <LiveConsoleOutputPanel @rendermode="InteractiveServer"
                                            ServerId="@_server.Id.ToString()"
                                            AgentId="@_server.AgentId.ToString()"
                                            OperationId="@_consoleOperationId"
                                            Command="@_consoleCommand"
                                            TimeZoneId="@OperatorTz.Zone.Id" />
                </div>
            </div>
        </BbCard>
    }

    @if (_activeSection == "diagnostics")
    {
        <BbCard Class="p-5" data-diagnostics-card>
            <h2 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">Diagnostics</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Run a read-only diagnostics gather for this server — RCON, game port, filesystem, SteamCMD, mods,
                configuration, and compatibility, plus the host's Docker and disk. Nothing is changed; results
                appear below as they are gathered.
            </p>

            @if (_diagnosticsMessage is not null)
            {
                <div class="mt-3" data-diagnostics-message>
                    <BbAlert Variant="@_diagnosticsAlert" AccentBorder>
                        <BbAlertDescription>@_diagnosticsMessage</BbAlertDescription>
                    </BbAlert>
                </div>
            }

            <div class="mt-4 flex flex-wrap items-center gap-2">
                <EditForm Model="_diagnosticsForm" FormName="diagnostics-gather" OnValidSubmit="DiagnosticsGatherAsync">
                    <BbButton Variant="ButtonVariant.Secondary" Type="ButtonType.Submit" Size="ButtonSize.Small"
                              data-action="run-diagnostics">Run diagnostics</BbButton>
                </EditForm>

                @if (_canExportDiagnostics)
                {
                    @* A native POST to the export endpoint so the browser downloads the returned ZIP; the endpoint
                       authorizes Diagnostics.Export fail-closed and refuses (without emitting) if a secret is found. *@
                    <form method="post" action="@($"/api/servers/{_server.Id}/diagnostics/support-package")"
                          data-diagnostics-export>
                        <BbButton Variant="ButtonVariant.Outline" Type="ButtonType.Submit" Size="ButtonSize.Small"
                                  data-action="export-support-package">Export support package</BbButton>
                    </form>
                }
            </div>

            <div class="mt-4">
                <LiveServerDiagnosticsPanel @rendermode="InteractiveServer"
                                            ServerId="@_server.Id.ToString()"
                                            AgentId="@_server.AgentId.ToString()" />
            </div>
        </BbCard>
    }

    @if (_activeSection == "players")
    {
        <BbCard Class="p-5" data-players-card>
            <h2 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">Players</h2>

            @if (_playerMessage is not null)
            {
                <div class="mt-3" data-player-message>
                    <BbAlert Variant="AlertVariant.Warning" AccentBorder>
                        <BbAlertDescription>@_playerMessage</BbAlertDescription>
                    </BbAlert>
                </div>
            }

            <EditForm Model="_actionForm" FormName="player-action" OnValidSubmit="ActionAsync" class="mt-4">
                <DataAnnotationsValidator />

                @if (_perm.CanView)
                {
                    <div class="flex items-center justify-between gap-3">
                        <h3 class="text-sm font-medium">Connected players</h3>
                        <BbButton Variant="ButtonVariant.Outline" Type="ButtonType.Submit" Size="ButtonSize.Small"
                                  name="_actionForm.Target" value="refresh" data-action="refresh">Refresh</BbButton>
                    </div>
                    <div class="mt-3">
                        <LivePlayerRosterPanel @rendermode="InteractiveServer"
                                               ServerId="@_server.Id.ToString()"
                                               AgentId="@_server.AgentId.ToString()" />
                    </div>
                }

                @if (_perm.CanKick || _perm.CanBan || _perm.CanUnban)
                {
                    <div class="mt-6 border-t border-border pt-4">
                        <h3 class="text-sm font-medium">Act on a player</h3>
                        <p class="mt-1 text-xs text-muted-foreground">Enter the player's account username exactly (case-sensitive).</p>
                        <div class="mt-3 grid gap-3 sm:grid-cols-2">
                            @* BbInput auto-derives the full model-path Name (_actionForm.Username) under the EditForm — matches the Configuration/Mods sections below (#121). *@
                            <div class="flex flex-col text-sm">
                                <BbLabel For="player-username" Class="mb-1 text-muted-foreground">Username</BbLabel>
                                <BbInput Id="player-username" @bind-Value="_actionForm.Username" autocomplete="off" />
                            </div>
                            <div class="flex flex-col text-sm">
                                <BbLabel For="player-reason" Class="mb-1 text-muted-foreground">Reason (optional, kick/ban)</BbLabel>
                                <BbInput Id="player-reason" @bind-Value="_actionForm.Reason" autocomplete="off" />
                            </div>
                        </div>
                        <div class="mt-3 flex flex-wrap gap-2">
                            @if (_perm.CanKick)
                            {
                                <BbButton Variant="ButtonVariant.Secondary" Type="ButtonType.Submit" Size="ButtonSize.Small"
                                          name="_actionForm.Target" value="kick" data-action="kick">Kick</BbButton>
                            }
                            @if (_perm.CanBan)
                            {
                                <BbButton Variant="ButtonVariant.Destructive" Type="ButtonType.Submit" Size="ButtonSize.Small"
                                          name="_actionForm.Target" value="ban" data-action="ban">Ban</BbButton>
                            }
                            @if (_perm.CanUnban)
                            {
                                <BbButton Variant="ButtonVariant.Outline" Type="ButtonType.Submit" Size="ButtonSize.Small"
                                          name="_actionForm.Target" value="unban" data-action="unban">Unban</BbButton>
                            }
                            @if (_perm.CanBan)
                            {
                                <BbButton Variant="ButtonVariant.Outline" Type="ButtonType.Submit" Size="ButtonSize.Small"
                                          name="_actionForm.Target" value="remove" data-action="remove-from-whitelist">Remove from whitelist</BbButton>
                            }
                        </div>
                    </div>
                }

                @if (_perm.CanConfigEdit)
                {
                    <div class="mt-6 border-t border-border pt-4">
                        <h3 class="text-sm font-medium">Whitelist mode</h3>
                        <p class="mt-1 text-xs text-muted-foreground">
                            Open lets clients join without a whitelist account; closing it admits only whitelisted
                            players. Applied at runtime over RCON.
                        </p>
                        <div class="mt-3 flex flex-wrap gap-2">
                            <BbButton Variant="ButtonVariant.Outline" Type="ButtonType.Submit" Size="ButtonSize.Small"
                                      name="_actionForm.Target" value="whitelist-open" data-action="whitelist-open">Open to all</BbButton>
                            <BbButton Variant="ButtonVariant.Outline" Type="ButtonType.Submit" Size="ButtonSize.Small"
                                      name="_actionForm.Target" value="whitelist-close" data-action="whitelist-close">Whitelist only</BbButton>
                        </div>
                    </div>
                }
            </EditForm>

            @if (_perm.CanView || _perm.CanUnban)
            {
                <div class="mt-6 border-t border-border pt-4">
                    <h3 class="text-sm font-medium">Bans issued through ZWarden</h3>
                    <p class="mt-1 text-xs text-muted-foreground">
                        Bans this control plane issued — not a mirror of the server's full ban list (bans made
                        in-game or from the console do not appear).
                    </p>
                    @if (_bans.Count == 0)
                    {
                        <p class="mt-3 text-sm text-muted-foreground" data-bans-empty>No bans on record.</p>
                    }
                    else
                    {
                        <EditForm Model="_unbanForm" FormName="ban-unban" OnValidSubmit="UnbanRowAsync" class="mt-3 block overflow-x-auto">
                            <table class="w-full border-collapse text-left text-sm" data-bans-table>
                                <thead>
                                    <tr class="border-b border-border text-muted-foreground">
                                        <th class="py-2 pr-4 font-medium">Username</th>
                                        <th class="py-2 pr-4 font-medium">Reason</th>
                                        <th class="py-2 pr-4 font-medium">Status</th>
                                        <th class="py-2 pr-4 font-medium">Issued (UTC)</th>
                                        <th class="py-2 font-medium"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (BanView ban in _bans)
                                    {
                                        <tr class="border-b border-border/60" data-ban-row>
                                            <td class="py-2 pr-4 font-mono">@ban.Username</td>
                                            <td class="py-2 pr-4 text-muted-foreground">@(string.IsNullOrWhiteSpace(ban.Reason) ? "—" : ban.Reason)</td>
                                            <td class="py-2 pr-4">@(ban.IsActive ? "Active" : "Lifted")</td>
                                            <td class="py-2 pr-4 tabular-nums">@BanIssued(ban.IssuedAt)</td>
                                            <td class="py-2">
                                                @if (ban.IsActive && _perm.CanUnban)
                                                {
                                                    <BbButton Variant="ButtonVariant.Outline" Type="ButtonType.Submit" Size="ButtonSize.Small"
                                                              name="_unbanForm.Target" value="@ban.Username" data-action="unban-row">Unban</BbButton>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </EditForm>
                    }
                </div>
            }
        </BbCard>
    }

    @if (_activeSection == "mods")
    {
        <BbCard Class="p-5" data-mods-card>
            <h2 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">Mods</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                The Workshop content this server has on disk and the mods each item provides, reconciled against the
                server's <span class="font-mono">WorkshopItems=</span>/<span class="font-mono">Mods=</span> config.
                Discovery reads the host only — it installs nothing (that is coming later).
            </p>

            @if (_modMessage is not null)
            {
                <div class="mt-3" data-mod-message>
                    <BbAlert Variant="AlertVariant.Warning" AccentBorder>
                        <BbAlertDescription>@_modMessage</BbAlertDescription>
                    </BbAlert>
                </div>
            }

            <EditForm Model="_modForm" FormName="mod-discovery" OnValidSubmit="DiscoverModsAsync" class="mt-4">
                <div class="flex items-center justify-between gap-3">
                    <h3 class="text-sm font-medium">Installed Workshop content</h3>
                    <BbButton Variant="ButtonVariant.Outline" Type="ButtonType.Submit" Size="ButtonSize.Small"
                              data-action="mod-refresh">Refresh</BbButton>
                </div>
                <div class="mt-3">
                    <LiveModInventoryPanel @rendermode="InteractiveServer"
                                           ServerId="@_server.Id.ToString()"
                                           AgentId="@_server.AgentId.ToString()" />
                </div>
            </EditForm>

            @if (_modPerm.CanAny)
            {
                <div class="mt-6 border-t border-border pt-4" data-mod-manage>
                    <h3 class="text-sm font-medium">Manage mods</h3>
                    <p class="mt-1 text-xs text-muted-foreground">
                        Changes are written to <span class="font-mono">WorkshopItems=</span>/<span class="font-mono">Mods=</span>
                        as drift-checked, recorded config edits. Mods load only when the server boots — use
                        <span class="font-medium">Restart to apply</span> once you are done. The lists below reflect the last
                        discovery; refresh above after a change to see it.
                    </p>

                    @if (_modManageMessage is not null)
                    {
                        <div class="mt-3" data-mod-manage-message>
                            <BbAlert Variant="_modManageAlert" AccentBorder>
                                <BbAlertDescription>@_modManageMessage</BbAlertDescription>
                            </BbAlert>
                        </div>
                    }

                    @if (_modInventory is null)
                    {
                        <p class="mt-3 text-sm text-muted-foreground" data-mod-manage-awaiting>
                            Refresh discovery above to load this server's mods before making changes.
                        </p>
                    }
                    else
                    {
                        <EditForm Model="_modManageForm" FormName="mod-manage" OnValidSubmit="ModManageAsync" class="mt-4 space-y-5">
                            @if (_modPerm.CanInstall)
                            {
                                <div class="flex flex-wrap items-end gap-2" data-mod-add>
                                    <div class="flex flex-col text-sm">
                                        <BbLabel For="mod-workshop-id" Class="mb-1 text-muted-foreground">Add Workshop item</BbLabel>
                                        <BbInput Id="mod-workshop-id" @bind-Value="_modManageForm!.WorkshopId" autocomplete="off"
                                                 inputmode="numeric" Placeholder="Workshop id, e.g. 2392709985" />
                                    </div>
                                    <BbButton Type="ButtonType.Submit" Size="ButtonSize.Small"
                                              name="_modManageForm.Command" value="add" data-action="mod-add">Add &amp; download</BbButton>
                                </div>
                            }

                            <div data-mod-enabled>
                                <h4 class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Enabled mods — load order</h4>
                                @if (_modInventory.EnabledModIds.Count == 0)
                                {
                                    <p class="mt-2 text-sm text-muted-foreground" data-mod-enabled-empty>
                                        No mods enabled in <span class="font-mono">Mods=</span>.
                                    </p>
                                }
                                else
                                {
                                    <BbItemGroup Class="mt-2">
                                        @for (int i = 0; i < _modInventory.EnabledModIds.Count; i++)
                                        {
                                            string modId = _modInventory.EnabledModIds[i];
                                            bool isFirst = i == 0;
                                            bool isLast = i == _modInventory.EnabledModIds.Count - 1;
                                            <BbItem Variant="ItemVariant.Outline" Size="ItemSize.Sm" data-mod-enabled-row data-mod-id="@modId">
                                                <BbItemContent>
                                                    <BbItemTitle><span class="font-mono text-sm">@modId</span></BbItemTitle>
                                                </BbItemContent>
                                                <BbItemActions>
                                                    @if (_modPerm.CanInstall && !isFirst)
                                                    {
                                                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Type="ButtonType.Submit"
                                                                  name="_modManageForm.Command" value="@($"moveup|{modId}")" data-action="mod-moveup">Up</BbButton>
                                                    }
                                                    @if (_modPerm.CanInstall && !isLast)
                                                    {
                                                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Type="ButtonType.Submit"
                                                                  name="_modManageForm.Command" value="@($"movedown|{modId}")" data-action="mod-movedown">Down</BbButton>
                                                    }
                                                    @if (_modPerm.CanRemove)
                                                    {
                                                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Type="ButtonType.Submit"
                                                                  name="_modManageForm.Command" value="@($"disable|{modId}")" data-action="mod-disable">Disable</BbButton>
                                                    }
                                                </BbItemActions>
                                            </BbItem>
                                        }
                                    </BbItemGroup>
                                }

                                @if (_modPerm.CanInstall && _enableCandidates.Count > 0)
                                {
                                    <div class="mt-3 flex flex-wrap items-end gap-2" data-mod-enable>
                                        <div class="flex flex-col text-sm">
                                            <BbLabel For="mod-enable-id" Class="mb-1 text-muted-foreground">Enable an installed mod</BbLabel>
                                            <BbNativeSelect TValue="string" Id="mod-enable-id" Name="_modManageForm.EnableModId" @bind-Value="_modManageForm!.EnableModId">
                                                @foreach (string candidate in _enableCandidates)
                                                {
                                                    <option value="@candidate">@candidate</option>
                                                }
                                            </BbNativeSelect>
                                        </div>
                                        <BbButton Type="ButtonType.Submit" Size="ButtonSize.Small"
                                                  name="_modManageForm.Command" value="enable" data-action="mod-enable">Enable</BbButton>
                                    </div>
                                }
                            </div>

                            <div data-mod-workshop>
                                <h4 class="text-xs font-semibold uppercase tracking-wide text-muted-foreground">Workshop items</h4>
                                @if (_modInventory.ConfiguredWorkshopIds.Count == 0)
                                {
                                    <p class="mt-2 text-sm text-muted-foreground" data-mod-workshop-empty>
                                        No items in <span class="font-mono">WorkshopItems=</span>.
                                    </p>
                                }
                                else
                                {
                                    <BbItemGroup Class="mt-2">
                                        @foreach (string workshopId in _modInventory.ConfiguredWorkshopIds)
                                        {
                                            bool onDisk = _installedWorkshopIds.Contains(workshopId);
                                            <BbItem Variant="ItemVariant.Outline" Size="ItemSize.Sm" data-mod-workshop-row data-workshop-id="@workshopId">
                                                <BbItemContent>
                                                    <BbItemTitle><span class="font-mono text-sm">@workshopId</span></BbItemTitle>
                                                    <BbItemDescription>@(onDisk ? "on disk" : "not installed on disk")</BbItemDescription>
                                                </BbItemContent>
                                                <BbItemActions>
                                                    @if (_modPerm.CanRemove)
                                                    {
                                                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Type="ButtonType.Submit"
                                                                  name="_modManageForm.Command" value="@($"remove|{workshopId}")" data-action="mod-remove">Remove</BbButton>
                                                    }
                                                </BbItemActions>
                                            </BbItem>
                                        }
                                    </BbItemGroup>
                                }
                            </div>

                            @if (_modPerm.CanUpdate || _modPerm.CanRestart)
                            {
                                <div class="flex flex-wrap gap-2 border-t border-border pt-4" data-mod-apply>
                                    @if (_modPerm.CanUpdate)
                                    {
                                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Type="ButtonType.Submit"
                                                  name="_modManageForm.Command" value="update" data-action="mod-update">Update Workshop content</BbButton>
                                    }
                                    @if (_modPerm.CanRestart)
                                    {
                                        <BbButton Variant="ButtonVariant.Destructive" Size="ButtonSize.Small" Type="ButtonType.Submit"
                                                  name="_modManageForm.Command" value="restart" data-action="mod-restart">Restart to apply</BbButton>
                                    }
                                </div>
                            }
                        </EditForm>
                    }
                </div>
            }
        </BbCard>
    }

    @if (_activeSection == "modbrowser")
    {
        <BbCard Class="p-5" data-modbrowser-card>
            <h2 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">Mod Browser</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                Preview a Workshop item or collection before installing it. Names, previews, size and — for content
                already on this server — version, dependencies and tags are shown for reference only; multiplayer
                support is not machine-readable, so any hint is best-effort. <span class="font-medium">Install</span>
                adds the item to <span class="font-mono">WorkshopItems=</span>; enable its mods from the
                <a class="underline hover:no-underline" href="@SectionHref("mods")">Mods</a> section after it downloads,
                then restart to load them.
            </p>

            @if (_browserMessage is not null)
            {
                <div class="mt-3" data-modbrowser-message>
                    <BbAlert Variant="_browserAlert" AccentBorder>
                        <BbAlertDescription>@_browserMessage</BbAlertDescription>
                    </BbAlert>
                </div>
            }

            @* Keyless lookup — always available: paste an item id or a collection URL and preview it. The Input field
               is re-posted with every button, so the preview persists across an Install post (static SSR). *@
            <EditForm Model="_browserForm" FormName="modbrowser-preview" OnValidSubmit="PreviewAsync" class="mt-4">
                <h3 class="text-sm font-medium">Preview by id or URL</h3>
                <div class="mt-2 flex flex-wrap items-end gap-2" data-modbrowser-lookup>
                    <div class="flex flex-1 flex-col text-sm">
                        <BbLabel For="modbrowser-input" Class="mb-1 text-muted-foreground">Workshop item id or collection URL</BbLabel>
                        <BbInput Id="modbrowser-input" @bind-Value="_browserForm!.Input" autocomplete="off"
                                 spellcheck="false" Placeholder="2392709985 or https://steamcommunity.com/…/?id=…" />
                    </div>
                    <BbButton Type="ButtonType.Submit" Size="ButtonSize.Small"
                              name="_browserForm.Command" value="resolve" data-action="modbrowser-resolve">Preview</BbButton>
                </div>

                @if (_preview is { Status: WorkshopPreviewStatus.Resolved } preview)
                {
                    @if (preview.IsCollection)
                    {
                        <p class="mt-3 text-xs text-muted-foreground" data-modbrowser-collection>
                            Collection — @preview.Items.Count item@(preview.Items.Count == 1 ? "" : "s"). Install each item you want.
                        </p>
                    }

                    @if (preview.Items.Count == 0)
                    {
                        <p class="mt-3 text-sm text-muted-foreground" data-modbrowser-empty>That collection has no items.</p>
                    }
                    else
                    {
                        <div class="zw-mb-grid" data-modbrowser-results>
                            @foreach (WorkshopItemMetadata item in preview.Items)
                            {
                                @ItemCard(item, "_browserForm.Command")
                            }
                        </div>
                    }
                }
                else if (_preview is { Status: WorkshopPreviewStatus.Unresolvable })
                {
                    <p class="mt-3 text-sm text-muted-foreground" data-modbrowser-unresolvable>
                        That is not a Workshop item id or link. Paste a numeric id, or a
                        <span class="font-mono">steamcommunity.com</span> item or collection URL.
                    </p>
                }
            </EditForm>

            @* Key-gated search: only when a Steam Web API key is configured for this tenant (F110 PR-B). *@
            @if (_searchAvailable)
            {
                <div class="mt-6 border-t border-border pt-4" data-modbrowser-search>
                    <EditForm Model="_searchForm" FormName="modbrowser-search" OnValidSubmit="SearchAsync">
                        <h3 class="text-sm font-medium">Search the Workshop</h3>
                        <div class="mt-2 flex flex-wrap items-end gap-2">
                            <div class="flex flex-1 flex-col text-sm">
                                <BbLabel For="modbrowser-query" Class="mb-1 text-muted-foreground">Search text</BbLabel>
                                <BbInput Id="modbrowser-query" @bind-Value="_searchForm!.Query" autocomplete="off"
                                         Placeholder="e.g. Brita, hydrocraft, map…" />
                            </div>
                            <BbButton Type="ButtonType.Submit" Size="ButtonSize.Small"
                                      name="_searchForm.Command" value="search" data-action="modbrowser-search">Search</BbButton>
                        </div>

                        @if (_searchResults is { SearchAvailable: true } results)
                        {
                            @if (results.Items.Count == 0)
                            {
                                <p class="mt-3 text-sm text-muted-foreground" data-modbrowser-search-empty>
                                    No Workshop items matched that search.
                                </p>
                            }
                            else
                            {
                                <div class="zw-mb-grid" data-modbrowser-search-results>
                                    @foreach (WorkshopSearchResult result in results.Items)
                                    {
                                        @SearchCard(result, "_searchForm.Command")
                                    }
                                </div>
                            }
                        }
                        else if (_searchResults is { SearchAvailable: false })
                        {
                            <p class="mt-3 text-sm text-muted-foreground" data-modbrowser-search-unavailable>
                                Workshop search is unavailable — the configured key was rejected. Check the key in
                                <a class="underline hover:no-underline" href="/settings">Settings</a>.
                            </p>
                        }
                    </EditForm>
                </div>
            }
            else
            {
                <p class="mt-6 border-t border-border pt-4 text-xs text-muted-foreground" data-modbrowser-search-off>
                    Add an optional Steam Web API key in <a class="underline hover:no-underline" href="/settings">Settings</a>
                    to search the Workshop by name. Preview-by-id and install work without one.
                </p>
            }
        </BbCard>
    }

    @if (_activeSection == "config")
    {
        <BbCard Class="p-5" data-config-card>
            <h2 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">Configuration</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                The current values of this server's configuration files, read live from the host and grouped for
                editing. Change as many settings as you like, then <span class="font-medium">Apply changes</span> —
                each changed value is re-checked against the live file and refused if it changed outside ZWarden
                (fail-closed), then written byte-for-byte and recorded as a revision. Adding or removing keys is not
                supported — the game owns the key set. <span class="font-mono">.ini</span> changes are reloaded live on a running server (mods and ports still need a restart);
                sandbox and spawn changes take effect on the next restart.
            </p>

            @if (_configDrift)
            {
                <div class="mt-3" data-config-drift>
                    <BbAlert Variant="AlertVariant.Warning" AccentBorder>
                        <BbAlertDescription>
                            This file changed on the host since you loaded it — another operator or the in-game admin
                            panel wrote it, or the server rewrote it on start. Nothing was applied. The editor below now
                            shows the <span class="font-medium">current</span> values with your changes kept on top
                            (highlighted); review them and <span class="font-medium">Apply changes</span> again to write them.
                        </BbAlertDescription>
                    </BbAlert>
                </div>
            }

            @if (_configOperation is { } configOp && _configMessage is null)
            {
                @if (!configOp.IsTerminal)
                {
                    <div class="mt-3" data-config-applying data-cfg-refresh="@(_configAutoRefresh ? "2" : null)">
                        <BbAlert Variant="AlertVariant.Info" AccentBorder>
                            <BbAlertDescription>
                                @if (_configAutoRefresh)
                                {
                                    <span>Applying your changes… This page refreshes when the host has written them.</span>
                                }
                                else
                                {
                                    <span>This change is still waiting to be applied — the host may be offline or busy.
                                        <a class="underline hover:no-underline" href="@ConfigOperationHref(_selectedFile, configOp.Id)">Check again</a>.</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(configOp.StatusLine))
                                {
                                    <span class="block text-xs">@configOp.StatusLine</span>
                                }
                                <span class="block font-mono text-xs text-muted-foreground">operation @configOp.Id</span>
                            </BbAlertDescription>
                        </BbAlert>
                        @if (_configAutoRefresh)
                        {
                            <noscript><meta http-equiv="refresh" content="2" /></noscript>
                        }
                    </div>
                }
                else if (configOp.State == OperationState.Succeeded)
                {
                    <div class="mt-3" data-config-applied>
                        <BbAlert Variant="AlertVariant.Success" AccentBorder>
                            <BbAlertDescription>
                                @(string.IsNullOrWhiteSpace(configOp.StatusLine) ? "Applied." : configOp.StatusLine)
                                The editor shows the values now on the host.
                            </BbAlertDescription>
                        </BbAlert>
                    </div>
                }
                else
                {
                    <div class="mt-3" data-config-apply-failed>
                        <BbAlert Variant="AlertVariant.Warning" AccentBorder>
                            <BbAlertDescription>
                                The change was not applied:
                                @(configOp.State == OperationState.Cancelled
                                    ? "the operation was cancelled."
                                    : configOp.FailureReason ?? "the host reported a failure.")
                                The editor shows the values currently on the host.
                            </BbAlertDescription>
                        </BbAlert>
                    </div>
                }
            }

            @if (!string.IsNullOrEmpty(FormRejected) && _configMessage is null)
            {
                <div class="mt-3" data-config-form-rejected>
                    <BbAlert Variant="AlertVariant.Warning" AccentBorder>
                        <BbAlertDescription>
                            That submission was too large for the server to accept, so nothing was applied. Reload
                            from host and apply your changes again — with scripts enabled only the changed settings
                            are sent.
                        </BbAlertDescription>
                    </BbAlert>
                </div>
            }

            @if (_configMessage is not null)
            {
                <div class="mt-3" data-config-message>
                    <BbAlert Variant="_configAlert" AccentBorder>
                        <BbAlertDescription>@_configMessage</BbAlertDescription>
                    </BbAlert>
                </div>
            }

            @* File tabs — bookmarkable GET switching (?file=), like the section rail. Switching files discards
               unsaved edits, which is why it is a navigation, not a form control. *@
            <div class="zw-cfg-tabs" data-config-tabs>
                @foreach (PzConfigFile file in ConfigFiles)
                {
                    <a class="zw-cfg-tab @(file == _selectedFile ? "active" : string.Empty)"
                       href="@ConfigFileHref(file)" data-config-tab="@file">@FileLabel(file)</a>
                }
            </div>

            @if (_configView is { IsRead: true } view && view.Sections.Count > 0)
            {
                <EditForm Model="_editorForm" FormName="config-editor" OnValidSubmit="ConfigEditorAsync"
                          class="mt-2" data-cfg-form>
                    <input type="hidden" name="_editorForm.File" value="@_selectedFile" />
                    <input type="hidden" name="_editorForm.BaselineHash" value="@_editorForm.BaselineHash" />

                    <div class="zw-cfg-toolbar">
                        <label class="zw-cfg-searchbox">
                            <ShellIcon Name="search" />
                            <input type="search" placeholder="Search settings…" autocomplete="off"
                                   spellcheck="false" aria-label="Search settings" data-cfg-search />
                        </label>
                        @* #243: collapse/expand every section, remembered per browser. JS-only, so hidden until
                           config-editor.js reveals it; without JS every section simply stays open. *@
                        <span class="zw-cfg-sections" data-cfg-sections-controls hidden>
                            @* Outline in the brand accent (style guide: primary marks controls, never status), a step
                               below the filled Apply button. *@
                            <BbButton Type="ButtonType.Button" Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                                      Class="zw-cfg-sections-btn" data-cfg-sections="collapse">
                                <ShellIcon Name="chevrons-down-up" />Collapse all
                            </BbButton>
                            <BbButton Type="ButtonType.Button" Variant="ButtonVariant.Outline" Size="ButtonSize.Small"
                                      Class="zw-cfg-sections-btn" data-cfg-sections="expand">
                                <ShellIcon Name="chevrons-up-down" />Expand all
                            </BbButton>
                        </span>
                        <span class="zw-spacer"></span>
                        <a class="text-xs text-muted-foreground hover:text-foreground" href="@ConfigFileHref(_selectedFile)"
                           data-action="config-reload">Reload from host</a>
                        <BbButton Type="ButtonType.Submit" Size="ButtonSize.Small"
                                  name="_editorForm.Target" value="apply" data-action="config-apply-batch">Apply changes</BbButton>
                    </div>

                    <p class="mt-2 text-xs text-muted-foreground">@RestartHint(_selectedFile)</p>

                    @{ int rowIndex = 0; }
                    @foreach (ConfigSection section in view.Sections)
                    {
                        <details class="zw-cfg-sec" open data-cfg-sec>
                            <summary>
                                <span>@section.Name</span>
                                <span class="zw-cfg-count">@section.Settings.Count</span>
                            </summary>
                            @foreach (ConfigSettingView setting in section.Settings)
                            {
                                int i = rowIndex++;
                                ConfigEditorRow row = _editorForm.Rows.Count > i ? _editorForm.Rows[i] : new ConfigEditorRow();
                                <div class="zw-cfg-row" data-cfg-row data-cfg-terms="@Terms(setting)"
                                     data-cfg-original="@row.Original">
                                    <input type="hidden" name="_editorForm.Rows[@i].Path" value="@row.Path" />
                                    <input type="hidden" name="_editorForm.Rows[@i].Kind" value="@row.Kind" />
                                    <input type="hidden" name="_editorForm.Rows[@i].Original" value="@row.Original" />
                                    @if (row.Toggle)
                                    {
                                        <input type="hidden" name="_editorForm.Rows[@i].Toggle" value="true" />
                                    }

                                    <div class="zw-cfg-name">
                                        <span class="zw-cfg-changed-dot" aria-hidden="true">•</span>
                                        <div class="min-w-0">
                                            <span class="zw-cfg-labeltext">@setting.Label</span>
                                            @if (!string.Equals(setting.Label, setting.Path, StringComparison.Ordinal))
                                            {
                                                <span class="zw-cfg-path">@setting.Path</span>
                                            }
                                            @if (setting.Managed)
                                            {
                                                <span class="zw-cfg-path" data-cfg-managed>@ManagedNote(setting.Path)</span>
                                            }
                                        </div>
                                        @if (HasHelp(setting))
                                        {
                                            <span class="zw-cfg-info" tabindex="0" role="button"
                                                  aria-label="About @setting.Label">i<span class="zw-cfg-pop" role="tooltip">
                                                @if (!string.IsNullOrWhiteSpace(setting.Tooltip))
                                                {
                                                    <div>@setting.Tooltip</div>
                                                }
                                                @if (setting.Options.Count > 0)
                                                {
                                                    <div class="zw-cfg-pop-meta">
                                                        @foreach (ConfigOption opt in setting.Options)
                                                        {
                                                            <div>@opt.Value = @opt.Label</div>
                                                        }
                                                    </div>
                                                }
                                                @if (MetaText(setting) is { Length: > 0 } meta)
                                                {
                                                    <div class="zw-cfg-pop-meta">@meta</div>
                                                }
                                                @if (!setting.KnownToSchema)
                                                {
                                                    <div class="zw-cfg-pop-src">Not in ZWarden's schema — applied as-is, unvalidated.</div>
                                                }
                                            </span></span>
                                        }
                                    </div>

                                    <div class="zw-cfg-control">
                                        @if (setting.Managed)
                                        {
                                            @* #228: ZWarden-managed (the INI ports). Read-only, so it posts its unchanged value and
                                               never becomes an edit; every apply path refuses a change regardless. *@
                                            <input type="text" class="zw-cfg-input" name="_editorForm.Rows[@i].Value"
                                                   value="@row.Value" readonly aria-readonly="true" data-cfg-value />
                                        }
                                        else if (setting.Options.Count > 0)
                                        {
                                            <select class="zw-cfg-input" name="_editorForm.Rows[@i].Value" data-cfg-value>
                                                @foreach (ConfigOption opt in setting.Options)
                                                {
                                                    <option value="@opt.Value" selected="@(string.Equals(opt.Value, row.Value, StringComparison.Ordinal))">@opt.Label</option>
                                                }
                                                @if (!setting.Options.Any(o => string.Equals(o.Value, row.Value, StringComparison.Ordinal)))
                                                {
                                                    <option value="@row.Value" selected>@(string.IsNullOrEmpty(row.Value) ? "(empty)" : row.Value)</option>
                                                }
                                            </select>
                                        }
                                        else if (setting.Shape == ConfigValueShape.Boolean)
                                        {
                                            <label class="zw-cfg-toggle">
                                                <input type="checkbox" class="zw-cfg-switch" name="_editorForm.Rows[@i].Flag"
                                                       value="true" checked="@row.Flag" data-cfg-value />
                                                <span class="zw-cfg-state">@(row.Flag ? "On" : "Off")</span>
                                            </label>
                                        }
                                        else if (setting.Shape is ConfigValueShape.Whole or ConfigValueShape.Fractional)
                                        {
                                            <input type="number" class="zw-cfg-input" name="_editorForm.Rows[@i].Value"
                                                   value="@row.Value" data-cfg-value
                                                   step="@(setting.Shape == ConfigValueShape.Whole ? "1" : "any")"
                                                   min="@(setting.Min?.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                                   max="@(setting.Max?.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
                                        }
                                        else
                                        {
                                            <input type="text" class="zw-cfg-input" name="_editorForm.Rows[@i].Value"
                                                   value="@row.Value" autocomplete="off" spellcheck="false" data-cfg-value />
                                        }
                                    </div>
                                </div>
                            }
                        </details>
                    }

                    <div class="mt-4 flex flex-wrap gap-2">
                        <BbButton Type="ButtonType.Submit" Size="ButtonSize.Small"
                                  name="_editorForm.Target" value="apply" data-action="config-apply-batch-bottom">Apply changes</BbButton>
                    </div>
                </EditForm>
            }
            else if (_configView is not null && !_configView.IsRead)
            {
                <div class="zw-cfg-empty" data-config-unavailable="@_configView.Outcome">
                    @ReadOutcomeText(_configView)
                </div>
            }
            else if (_configView is { IsRead: true })
            {
                <div class="zw-cfg-empty" data-config-empty>No editable settings were found in this file.</div>
            }

            @if (_configView?.RawText is { Length: > 0 } rawText)
            {
                <details class="zw-cfg-raw" data-config-raw>
                    <summary><ShellIcon Name="scroll-text" /> Raw file — @FileLabel(_selectedFile)</summary>
                    @if (_perm.CanConfigEdit && _configView is { IsRead: true })
                    {
                        @* Gated raw whole-file edit (F20c PR-D, ADR 0042). Arbitrary operator text bypasses the
                           surgical writer and can stop the server on start, so it is gated behind an explicit
                           acknowledgement; the Agent still parse-validates, drift-checks, and writes BOM-less. *@
                        <EditForm Model="_rawForm" FormName="config-raw-edit" OnValidSubmit="RawEditAsync"
                                  class="mt-2" data-config-raweditform>
                            <input type="hidden" name="_rawForm.File" value="@_selectedFile" />
                            <input type="hidden" name="_rawForm.BaselineHash" value="@_rawForm.BaselineHash" />
                            <p class="mb-2 text-xs text-muted-foreground">
                                Editing the whole file replaces every byte the game reads. A typo can stop the server
                                from starting. The text is re-parsed and re-checked against the live file before it is
                                written; a syntax error or a drift is refused. Prefer the structured editor above unless
                                you need a setting it does not surface (for example the spawn files).
                            </p>
                            <textarea class="zw-cfg-rawedit" name="_rawForm.Content" rows="16" spellcheck="false"
                                      autocomplete="off" aria-label="Raw file contents">@(_rawForm.Content ?? rawText)</textarea>
                            <label class="mt-2 flex items-start gap-2 text-xs text-muted-foreground">
                                <input type="checkbox" name="_rawForm.Confirmed" value="true" checked="@_rawForm.Confirmed"
                                       data-config-rawconfirm />
                                <span>I understand this replaces the whole file and can prevent the server from starting.</span>
                            </label>
                            <div class="mt-2 flex flex-wrap items-center gap-2">
                                <BbButton Type="ButtonType.Submit" Size="ButtonSize.Small"
                                          data-action="config-raw-apply">Apply raw edit</BbButton>
                                <a class="text-xs text-muted-foreground hover:text-foreground" href="@ConfigFileHref(_selectedFile)"
                                   data-action="config-raw-reload">Reload from host</a>
                            </div>
                        </EditForm>
                    }
                    else
                    {
                        <pre>@rawText</pre>
                    }
                </details>
            }

            @* Advanced: the by-path single-edit form. It needs no live read, so it stays available when the host is
               offline, and covers a key the structured editor does not surface (e.g. a spawn-file value). *@
            <details class="mt-6 border-t border-border pt-4" data-config-advanced>
                <summary class="cursor-pointer text-sm font-medium">Advanced — edit a single setting by path</summary>
                <EditForm Model="_configForm" FormName="server-config" OnValidSubmit="ConfigAsync" class="mt-3">
                    <DataAnnotationsValidator />
                    <div class="grid gap-3 sm:grid-cols-4">
                        <div class="flex flex-col text-sm">
                            <BbLabel For="config-file" Class="mb-1 text-muted-foreground">File</BbLabel>
                            @* BbNativeSelect auto-derives only the leaf name under static SSR; set the full model path (#84). *@
                            <BbNativeSelect TValue="string" Id="config-file" Name="_configForm.File" @bind-Value="_configForm!.File">
                                <option value="Ini">servertest.ini</option>
                                <option value="SandboxVars">SandboxVars.lua</option>
                                <option value="SpawnRegions">spawnregions.lua</option>
                                <option value="SpawnPoints">spawnpoints.lua</option>
                            </BbNativeSelect>
                        </div>
                        <div class="flex flex-col text-sm">
                            <BbLabel For="config-path" Class="mb-1 text-muted-foreground">Setting path</BbLabel>
                            <BbInput Id="config-path" @bind-Value="_configForm!.Path" autocomplete="off" Placeholder="e.g. Map.AllowMiniMap" />
                        </div>
                        <div class="flex flex-col text-sm">
                            <BbLabel For="config-kind" Class="mb-1 text-muted-foreground">Type</BbLabel>
                            <BbNativeSelect TValue="string" Id="config-kind" Name="_configForm.Kind" @bind-Value="_configForm!.Kind">
                                <option value="Bool">true / false</option>
                                <option value="Number">number</option>
                                <option value="Text">text</option>
                            </BbNativeSelect>
                        </div>
                        <div class="flex flex-col text-sm">
                            <BbLabel For="config-value" Class="mb-1 text-muted-foreground">New value</BbLabel>
                            <BbInput Id="config-value" @bind-Value="_configForm!.Value" autocomplete="off" />
                        </div>
                    </div>
                    <div class="mt-3 flex flex-wrap gap-2">
                        <BbButton Type="ButtonType.Submit" Size="ButtonSize.Small"
                                  name="_configForm.Target" value="apply" data-action="config-apply">Apply edit</BbButton>
                        <BbButton Variant="ButtonVariant.Outline" Type="ButtonType.Submit" Size="ButtonSize.Small"
                                  name="_configForm.Target" value="load" data-action="config-load">Load history</BbButton>
                    </div>
                </EditForm>
            </details>

            <div class="mt-6 border-t border-border pt-4">
                <h3 class="text-sm font-medium">Revision history — @FileLabel(_selectedFile)</h3>
                <p class="mt-1 text-xs text-muted-foreground">
                    Each recorded change to this file, newest first, shown as the parsed values that changed —
                    not a text diff (the game rewrites these files on every start). Restoring re-applies a prior
                    revision's values as a fresh, drift-checked edit.
                </p>

                @if (_revisions.Count == 0)
                {
                    <p class="mt-3 text-sm text-muted-foreground" data-revisions-empty>
                        No revisions recorded for this file yet. A revision is recorded the first time a change is applied.
                    </p>
                }
                else
                {
                    <EditForm Model="_restoreForm" FormName="config-restore" OnValidSubmit="RestoreAsync" class="mt-3 block overflow-x-auto">
                        <table class="w-full border-collapse text-left text-sm" data-revisions-table>
                            <thead>
                                <tr class="border-b border-border text-muted-foreground">
                                    <th class="py-2 pr-4 font-medium">Recorded (UTC)</th>
                                    <th class="py-2 pr-4 font-medium">Changes</th>
                                    <th class="py-2 pr-4 font-medium">Snapshot</th>
                                    <th class="py-2 font-medium"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (ConfigRevisionView rev in _revisions)
                                {
                                    <tr class="border-b border-border/60 align-top" data-revision-row>
                                        <td class="py-2 pr-4 tabular-nums">
                                            @Recorded(rev.RecordedAt)
                                            @if (rev.IsCurrent)
                                            {
                                                <span class="ml-1 text-xs text-muted-foreground">(current)</span>
                                            }
                                        </td>
                                        <td class="py-2 pr-4">
                                            @if (rev.Changes.Count == 0)
                                            {
                                                <span class="text-muted-foreground">baseline</span>
                                            }
                                            else
                                            {
                                                foreach (ConfigValueChange change in rev.Changes)
                                                {
                                                    <div class="font-mono text-xs" data-change>@ChangeText(change)</div>
                                                }
                                            }
                                        </td>
                                        <td class="py-2 pr-4 font-mono text-xs">@rev.ShortHash</td>
                                        <td class="py-2">
                                            @if (!rev.IsCurrent)
                                            {
                                                <BbButton Variant="ButtonVariant.Outline" Type="ButtonType.Submit" Size="ButtonSize.Small"
                                                          name="_restoreForm.Target" value="@($"{rev.File}|{rev.Id}")" data-action="config-restore">Restore</BbButton>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </EditForm>
                }
            </div>
        </BbCard>
    }

    @if (_activeSection == "backups")
    {
        <BbCard Class="p-5" data-backups-card>
            <h2 class="text-sm font-semibold uppercase tracking-wide text-muted-foreground">Backups</h2>
            <p class="mt-1 text-xs text-muted-foreground">
                A backup is a verifiable <span class="font-mono">.tar.gz</span> copy of this server's world data,
                taken on the host and checksummed (SHA-256). Taking one is a durable operation that briefly locks
                the server against other changes; deleting one removes the archive from the host. Restoring overwrites
                the live world — <strong>stop the server first</strong>, and a protective backup of the current world
                is taken automatically before the swap.
            </p>

            @if (_backupMessage is not null)
            {
                <div class="mt-3" data-backup-message>
                    <BbAlert Variant="_backupAlert" AccentBorder>
                        <BbAlertDescription>@_backupMessage</BbAlertDescription>
                    </BbAlert>
                </div>
            }

            <EditForm Model="_backupForm" FormName="backup-manage" OnValidSubmit="BackupManageAsync" class="mt-4">
                @if (_backupPerm.CanCreate)
                {
                    <BbButton Type="ButtonType.Submit" Size="ButtonSize.Small"
                              name="_backupForm.Command" value="create" data-action="backup-create">Take backup</BbButton>
                }

                @if (_backups.Count == 0)
                {
                    <p class="mt-3 text-sm text-muted-foreground" data-backups-empty>No backups yet.</p>
                }
                else
                {
                    <div class="mt-4 block overflow-x-auto">
                        <table class="w-full border-collapse text-left text-sm" data-backups-table>
                            <thead>
                                <tr class="border-b border-border text-muted-foreground">
                                    <th class="py-2 pr-4 font-medium">Created (UTC)</th>
                                    <th class="py-2 pr-4 font-medium">Reason</th>
                                    <th class="py-2 pr-4 font-medium">Size</th>
                                    <th class="py-2 pr-4 font-medium">Checksum</th>
                                    <th class="py-2 font-medium"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (BackupSummary backup in _backups)
                                {
                                    <tr class="border-b border-border/60" data-backup-row>
                                        <td class="py-2 pr-4 tabular-nums">@BackupCreated(backup.CreatedAt)</td>
                                        <td class="py-2 pr-4">@(backup.Reason == BackupReason.PreOperation ? "Pre-operation" : "Manual")</td>
                                        <td class="py-2 pr-4 tabular-nums">@FormatSize(backup.SizeBytes)</td>
                                        <td class="py-2 pr-4 font-mono text-xs">@ShortChecksum(backup.Sha256)</td>
                                        <td class="py-2">
                                            <div class="flex gap-2">
                                                @if (_backupPerm.CanRestore)
                                                {
                                                    <BbButton Type="ButtonType.Submit" Size="ButtonSize.Small"
                                                              name="_backupForm.Command" value="@($"restore|{backup.Id}")" data-action="backup-restore">Restore</BbButton>
                                                }
                                                @if (_backupPerm.CanDelete)
                                                {
                                                    <BbButton Variant="ButtonVariant.Destructive" Type="ButtonType.Submit" Size="ButtonSize.Small"
                                                              name="_backupForm.Command" value="@($"delete|{backup.Id}")" data-action="backup-delete">Delete</BbButton>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </EditForm>
        </BbCard>
    }
        </div>
    </div>
}

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    // Which rail section to render (#162). Absent, unknown, or unauthorized falls back to overview (fail-closed).
    [SupplyParameterFromQuery]
    public string? Section { get; set; }

    // Which config file the live editor shows (F20c). Bookmarkable, GET-switched like ?section=; Ini by default.
    [SupplyParameterFromQuery(Name = "file")]
    public string? FileParam { get; set; }

    // Set by the form-limit guard (#224) when a post was refused before it reached this page; any value shows the
    // "nothing was applied" notice.
    [SupplyParameterFromQuery(Name = FormLimitGuardMiddleware.RejectedQueryKey)]
    public string? FormRejected { get; set; }

    // The configuration write this page is tracking (#226), set by the post-apply redirect. Only a config write for
    // this Server, visible in the tenant, is honoured; anything else is ignored (fail-closed).
    [SupplyParameterFromQuery(Name = "op")]
    public string? OperationParam { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    [SupplyParameterFromForm(FormName = "server-lifecycle")]
    private LifecycleModel _lifecycleForm { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "server-graceful-restart")]
    private GracefulRestartFormModel _gracefulForm { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "player-action")]
    private PlayerActionModel _actionForm { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "ban-unban")]
    private UnbanModel _unbanForm { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "console-command")]
    private ConsoleFormModel _consoleForm { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "diagnostics-gather")]
    private DiagnosticsFormModel _diagnosticsForm { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "server-config")]
    private ConfigFormModel _configForm { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "config-editor")]
    private ConfigEditorModel _editorForm { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "config-restore")]
    private ConfigRestoreModel _restoreForm { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "config-raw-edit")]
    private ConfigRawEditModel _rawForm { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "mod-discovery")]
    private ModDiscoveryModel _modForm { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "mod-manage")]
    private ModManageModel _modManageForm { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "backup-manage")]
    private BackupManageModel _backupForm { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "modbrowser-preview")]
    private ModBrowserPreviewModel _browserForm { get; set; } = default!;

    [SupplyParameterFromForm(FormName = "modbrowser-search")]
    private ModBrowserSearchModel _searchForm { get; set; } = default!;

    private ServerSummary? _server;
    private string _activeSection = "overview";
    private bool _canStart;
    private bool _canStop;
    private bool _canRestartServer;
    private string? _lifecycleMessage;
    private AlertVariant _lifecycleAlert = AlertVariant.Warning;
    private PlayerPermissions _perm;
    private bool _canViewLogs;
    private bool _canExecuteConsole;
    private string? _consoleMessage;

    // The console Operation just enqueued and its command line, handed to the output pane so it shows that reply
    // alone (#242).
    private string? _consoleOperationId;
    private string? _consoleCommand;
    private AlertVariant _consoleAlert = AlertVariant.Warning;
    private bool _canViewDiagnostics;
    private bool _canExportDiagnostics;
    private string? _diagnosticsMessage;
    private AlertVariant _diagnosticsAlert = AlertVariant.Info;
    private bool _canViewMods;
    private string? _modMessage;

    private ModManagePermissions _modPerm;
    private ModInventory? _modInventory;
    private IReadOnlyList<string> _enableCandidates = [];
    private HashSet<string> _installedWorkshopIds = [];
    private string? _modManageMessage;
    private AlertVariant _modManageAlert = AlertVariant.Warning;
    private IReadOnlyList<BanView> _bans = [];
    private string? _playerMessage;

    // Mod Browser (#110): keyless preview + key-gated search, both feeding F22's install verb.
    private bool _searchAvailable;
    private WorkshopPreview? _preview;
    private WorkshopSearchResults? _searchResults;
    private string? _browserMessage;
    private AlertVariant _browserAlert = AlertVariant.Warning;

    private PzConfigFile _selectedFile = PzConfigFile.Ini;
    private IReadOnlyList<ConfigRevisionView> _revisions = [];
    private ConfigDocumentView? _configView;
    private string? _configMessage;
    private AlertVariant _configAlert = AlertVariant.Warning;
    private bool _configDrift;

    // The tracked configuration write (#226) and whether the page should keep refreshing while it runs.
    private Operation? _configOperation;
    private bool _configAutoRefresh;

    // How long the page keeps auto-refreshing a write that has not finished (e.g. a queued write to an offline host).
    private static readonly TimeSpan ConfigRefreshWindow = TimeSpan.FromMinutes(2);

    private BackupPermissions _backupPerm;
    private IReadOnlyList<BackupSummary> _backups = [];
    private string? _backupMessage;
    private AlertVariant _backupAlert = AlertVariant.Warning;

    protected override async Task OnInitializedAsync()
    {
        _actionForm ??= new PlayerActionModel();
        _unbanForm ??= new UnbanModel();
        _consoleForm ??= new ConsoleFormModel();
        _configForm ??= new ConfigFormModel();
        _editorForm ??= new ConfigEditorModel();
        _restoreForm ??= new ConfigRestoreModel();
        _rawForm ??= new ConfigRawEditModel();
        _modForm ??= new ModDiscoveryModel();
        _modManageForm ??= new ModManageModel();
        _browserForm ??= new ModBrowserPreviewModel();
        _searchForm ??= new ModBrowserSearchModel();
        _backupForm ??= new BackupManageModel();
        _diagnosticsForm ??= new DiagnosticsFormModel();
        _lifecycleForm ??= new LifecycleModel();
        _gracefulForm ??= new GracefulRestartFormModel();
        _configForm.File ??= nameof(PzConfigFile.Ini);
        _configForm.Kind ??= nameof(ConfigEditKind.Bool);
        _selectedFile = ParseFile(_configForm.File);

        if (!ServerId.TryParse(Id, out ServerId serverId))
        {
            return;
        }

        UserId user = await CurrentUserAsync();
        _server = await Inventory.GetVisibleAsync(user, serverId);
        if (_server is not null)
        {
            await LoadPlayersAsync(user, serverId);
            _canViewLogs = (await PermissionChecker.EvaluateAsync(user, Permissions.ConsoleView, serverId)).IsAllowed;
            _canExecuteConsole = (await PermissionChecker.EvaluateAsync(user, Permissions.ConsoleExecute, serverId)).IsAllowed;
            // Diagnostics.View / .Export are tenant-wide (not server-scoped), so they evaluate without a Server.
            _canViewDiagnostics = (await PermissionChecker.EvaluateAsync(user, Permissions.DiagnosticsView)).IsAllowed;
            _canExportDiagnostics = (await PermissionChecker.EvaluateAsync(user, Permissions.DiagnosticsExport)).IsAllowed;
            _canViewMods = (await PermissionChecker.EvaluateAsync(user, Permissions.ModView, serverId)).IsAllowed;
            _canStart = (await PermissionChecker.EvaluateAsync(user, Permissions.ServerStart, serverId)).IsAllowed;
            _canStop = (await PermissionChecker.EvaluateAsync(user, Permissions.ServerStop, serverId)).IsAllowed;
            _canRestartServer = (await PermissionChecker.EvaluateAsync(user, Permissions.ServerRestart, serverId)).IsAllowed;
            await LoadModManagementAsync(user, serverId);
            await LoadBackupsAsync(user, serverId);

            // Resolve the active section only after the per-section gates are known, so an unknown or
            // unauthorized ?section= fails closed to the always-available overview.
            _activeSection = ResolveSection(Section);

            // Mod Browser (#110): the search box lights up only when this tenant has a Steam Web API key configured
            // (F110 PR-B). Read the non-secret capability flag; keyless preview/install work regardless.
            if (_activeSection == "modbrowser" && _canViewMods)
            {
                _searchAvailable = await WorkshopSettings.IsSearchAvailableAsync();
            }

            // The live config editor (F20c): only the Config section reads the host, and only for a permitted
            // operator. The file is chosen by the ?file= query param (bookmarkable tab switching, GET); Ini by
            // default. On a GET — or a post from another form — the editor's row list is empty, so load the
            // current values from the host now. A config-editor POST arrives with its rows already bound and its
            // submit handler applies them and then re-reads, so we must not clobber those posted rows here.
            if (_activeSection == "config" && _perm.CanConfigEdit)
            {
                _selectedFile = ParseFile(FileParam ?? _editorForm.File ?? _configForm.File);
                await LoadHistoryAsync(user, serverId);
                await LoadConfigOperationAsync(serverId);
                // Always read so the editor form is present in this render — static SSR dispatches a form's
                // submit handler only to a form that is actually rendered. Rebuild the editable row list from
                // the read on a GET (or a post from another form); on a config-editor post the rows are already
                // bound with the operator's edits, so preserve them for the submit handler to diff.
                // While a tracked write is still running (#226) the host still holds the old values, so the editor is
                // withheld rather than shown stale; the page refreshes and reads once the Agent is done.
                if (!_configAutoRefresh)
                {
                    await ReadConfigViewAsync(user, serverId, rebuildRows: _editorForm.Rows.Count == 0);
                }
            }
        }
    }

    // The rail is fail-closed: a section is selectable only where the operator holds its per-server permission.
    private string ResolveSection(string? requested) => requested switch
    {
        "players" when _perm.CanAny => "players",
        "console" when _canExecuteConsole => "console",
        "logs" when _canViewLogs => "logs",
        "config" when _perm.CanConfigEdit => "config",
        "mods" when _canViewMods => "mods",
        "modbrowser" when _canViewMods => "modbrowser",
        "backups" when _backupPerm.CanView => "backups",
        "diagnostics" when _canViewDiagnostics => "diagnostics",
        _ => "overview",
    };

    private string Active(string section) => _activeSection == section ? "active" : string.Empty;

    private string SectionHref(string section) => section == "overview"
        ? $"/servers/{Id}"
        : $"/servers/{Id}?section={section}";

    // Lifecycle buttons are enabled by the last observed run-state; the service still re-checks on submit.
    private bool StartEnabled => _server is { LastRunState: ServerRunState.Stopped or ServerRunState.Failed or ServerRunState.Unknown };
    private bool StopEnabled => _server is { LastRunState: ServerRunState.Running or ServerRunState.Starting };
    private bool RestartEnabled => _server is { LastRunState: ServerRunState.Running };

    private async Task LifecycleAsync()
    {
        if (_server is null || !ServerId.TryParse(Id, out ServerId serverId))
        {
            return;
        }

        UserId user = await CurrentUserAsync();
        string command = _lifecycleForm?.Command ?? string.Empty;
        ServerLifecycleResult? result = command switch
        {
            "start" => await Lifecycle.StartAsync(user, serverId),
            "stop" => await Lifecycle.StopAsync(user, serverId),
            "restart" => await Lifecycle.RestartAsync(user, serverId),
            _ => null,
        };

        SetLifecycleResult(command, result);
    }

    // #114: the default warning schedule the operator control uses when "warn players" is left on. The Agent holds
    // the authoritative default for a plain (header-button) restart; this is the schedule the configure form sends.
    private static readonly int[] DefaultRestartWarning = [300, 60, 30, 10];

    private async Task GracefulRestartAsync()
    {
        if (_server is null || !ServerId.TryParse(Id, out ServerId serverId))
        {
            return;
        }

        string? message = string.IsNullOrWhiteSpace(_gracefulForm?.Message) ? null : _gracefulForm!.Message!.Trim();
        if (message is not null && BroadcastMessageRules.ValidateMessage(message) is { } invalid)
        {
            _lifecycleAlert = AlertVariant.Warning;
            _lifecycleMessage = invalid;
            return;
        }

        // Map the operator's chosen preset to a descending countdown schedule (#213). "immediate" ⇒ an empty
        // schedule (restart now, no broadcast); anything else warns players for that long before the stop.
        IReadOnlyList<int> leads = _gracefulForm?.Countdown switch
        {
            "immediate" => [],
            "1m" => [60, 30, 10],
            "15m" => [900, 300, 60, 30, 10],
            _ => DefaultRestartWarning, // "5m" and any unexpected value ⇒ the default five-minute schedule.
        };
        var plan = new GracefulRestartPayload(leads, message);

        UserId user = await CurrentUserAsync();
        SetLifecycleResult("restart", await Lifecycle.RestartAsync(user, serverId, plan));
    }

    private void SetLifecycleResult(string command, ServerLifecycleResult? result)
    {
        if (result is null)
        {
            _lifecycleAlert = AlertVariant.Warning;
            _lifecycleMessage = "Choose a lifecycle action.";
            return;
        }

        if (result.Succeeded)
        {
            string what = command switch
            {
                "start" => "Start",
                "stop" => "Stop",
                "restart" => "Restart",
                _ => "Action",
            };
            _lifecycleAlert = AlertVariant.Success;
            _lifecycleMessage = $"{what} enqueued (operation {result.Operation}). The run-state updates once the server reports it.";
            return;
        }

        _lifecycleAlert = AlertVariant.Warning;
        _lifecycleMessage = result.Failure switch
        {
            ServerLifecycleFailure.NotAuthorized => "You are not permitted to perform that action on this server.",
            ServerLifecycleFailure.ServerNotFound => "That server is no longer available.",
            ServerLifecycleFailure.ServerBusy => "The server is busy with another operation; try again once it finishes.",
            _ => "The action could not be started.",
        };
    }

    private async Task LoadModManagementAsync(UserId user, ServerId serverId)
    {
        // Per-server mod permissions (fail-closed, re-checked in the service on submit): a control shows only where
        // the caller holds the matching Mod.* / Server.Restart grant.
        _modPerm = new ModManagePermissions(
            CanInstall: (await PermissionChecker.EvaluateAsync(user, Permissions.ModInstall, serverId)).IsAllowed,
            CanRemove: (await PermissionChecker.EvaluateAsync(user, Permissions.ModRemove, serverId)).IsAllowed,
            CanUpdate: (await PermissionChecker.EvaluateAsync(user, Permissions.ModUpdate, serverId)).IsAllowed,
            CanRestart: (await PermissionChecker.EvaluateAsync(user, Permissions.ServerRestart, serverId)).IsAllowed);

        // The last observed inventory (ownership-guarded by the Server's owning Agent) drives the actionable lists.
        // The mod manager re-reads it on submit, so a stale snapshot here only affects which controls are offered.
        _modInventory = _server is null ? null : ModInventories.GetLatest(serverId, _server.AgentId);
        if (_modInventory is null)
        {
            _enableCandidates = [];
            _installedWorkshopIds = [];
            return;
        }

        _installedWorkshopIds = new HashSet<string>(_modInventory.InstalledItems.Select(i => i.WorkshopId), StringComparer.Ordinal);
        HashSet<string> enabled = new(_modInventory.EnabledModIds, StringComparer.Ordinal);
        // Installed mods not already enabled — the candidates the operator can enable in one click.
        _enableCandidates = _modInventory.InstalledItems
            .SelectMany(i => i.Mods.Select(m => m.ModId))
            .Where(id => !enabled.Contains(id))
            .Distinct(StringComparer.Ordinal)
            .ToList();
    }

    private async Task DiscoverModsAsync()
    {
        if (_server is null || !ServerId.TryParse(Id, out ServerId serverId))
        {
            return;
        }

        UserId user = await CurrentUserAsync();
        ModDiscoveryDispatch result = await ModDiscovery.RequestAsync(user, serverId);
        _modMessage = result.Succeeded
            ? $"Discovery started (operation {result.Operation}). The inventory below refreshes when it completes."
            : result.Failure switch
            {
                ModDiscoveryFailure.NotAuthorized => "You are not permitted to view this server's mods.",
                ModDiscoveryFailure.ServerNotFound => "That server is no longer available.",
                _ => "Discovery could not be started.",
            };
    }

    private async Task ModManageAsync()
    {
        if (_server is null || !ServerId.TryParse(Id, out ServerId serverId))
        {
            return;
        }

        UserId user = await CurrentUserAsync();
        string[] parts = (_modManageForm?.Command ?? string.Empty).Split('|', 2);
        string verb = parts[0];
        string arg = parts.Length == 2 ? parts[1] : string.Empty;

        switch (verb)
        {
            case "add":
                SetModResult("Add & download", await ModManager.AddWorkshopItemAsync(user, serverId, (_modManageForm?.WorkshopId ?? string.Empty).Trim()));
                break;
            case "enable":
                string enableId = (_modManageForm?.EnableModId ?? string.Empty).Trim();
                if (enableId.Length == 0)
                {
                    SetModMessage("Choose a mod to enable.", ok: false);
                }
                else
                {
                    SetModResult("Enable", await ModManager.EnableModsAsync(user, serverId, [enableId]));
                }

                break;
            case "disable":
                SetModResult("Disable", await ModManager.DisableModsAsync(user, serverId, [arg]));
                break;
            case "remove":
                SetModResult("Remove", await ModManager.RemoveWorkshopItemsAsync(user, serverId, [arg]));
                break;
            case "moveup":
            case "movedown":
                await ReorderAsync(user, serverId, verb, arg);
                break;
            case "update":
                SetModResult("Update", await ModManager.UpdateModsAsync(user, serverId));
                break;
            case "restart":
                SetRestartResult(await Lifecycle.RestartAsync(user, serverId));
                break;
            default:
                SetModMessage("Choose an action.", ok: false);
                break;
        }

        await LoadModManagementAsync(user, serverId);
    }

    private async Task ReorderAsync(UserId user, ServerId serverId, string verb, string modId)
    {
        if (_modInventory is null)
        {
            SetModMessage("Refresh mod discovery before reordering.", ok: false);
            return;
        }

        List<string> order = [.. _modInventory.EnabledModIds];
        int index = order.FindIndex(id => string.Equals(id, modId, StringComparison.Ordinal));
        if (index < 0)
        {
            SetModMessage("That mod is no longer enabled; refresh discovery.", ok: false);
            return;
        }

        int target = string.Equals(verb, "moveup", StringComparison.Ordinal) ? index - 1 : index + 1;
        if (target < 0 || target >= order.Count)
        {
            return; // Already at the edge — nothing to do.
        }

        (order[index], order[target]) = (order[target], order[index]);
        SetModResult("Reorder", await ModManager.ReorderModsAsync(user, serverId, order));
    }

    private void SetModResult(string action, ModManagementResult result)
    {
        if (result.Succeeded)
        {
            SetModMessage($"{action} enqueued (operation {result.Operation}). Restart to load the change once it completes.", ok: true);
            return;
        }

        string message = result.Failure switch
        {
            ModManagementFailure.NotAuthorized => "You are not permitted to manage this server's mods.",
            ModManagementFailure.ServerNotFound => "That server is no longer available.",
            ModManagementFailure.ServerBusy => "The server is busy with another operation; try again once it finishes.",
            ModManagementFailure.SnapshotUnavailable => "Refresh mod discovery for this server before making changes.",
            ModManagementFailure.NoChange => "That did not change the mod list.",
            ModManagementFailure.InvalidReorder => "A reorder must keep exactly the currently enabled mods.",
            ModManagementFailure.InvalidInput => result.Message ?? "That mod change is not valid.",
            _ => "The mod change could not be completed.",
        };
        SetModMessage(message, ok: false);
    }

    private void SetRestartResult(ServerLifecycleResult result)
    {
        if (result.Succeeded)
        {
            SetModMessage($"Restart enqueued (operation {result.Operation}). Mods load as the server boots.", ok: true);
            return;
        }

        string message = result.Failure switch
        {
            ServerLifecycleFailure.NotAuthorized => "You are not permitted to restart this server.",
            ServerLifecycleFailure.ServerNotFound => "That server is no longer available.",
            ServerLifecycleFailure.ServerBusy => "The server is busy with another operation; try again once it finishes.",
            _ => "The restart could not be started.",
        };
        SetModMessage(message, ok: false);
    }

    private void SetModMessage(string message, bool ok)
    {
        _modManageMessage = message;
        _modManageAlert = ok ? AlertVariant.Success : AlertVariant.Warning;
    }

    // ---- Mod Browser (#110 PR-C) --------------------------------------------------------------------------------

    // Keyless preview: resolve a pasted id/collection URL (or, on an Install button, add the chosen item then
    // re-resolve so the preview persists across the post — static SSR re-renders the whole page).
    private async Task PreviewAsync()
    {
        if (_server is null || !ServerId.TryParse(Id, out ServerId serverId))
        {
            return;
        }

        UserId user = await CurrentUserAsync();
        string command = _browserForm?.Command ?? string.Empty;
        string input = _browserForm?.Input?.Trim() ?? string.Empty;

        if (command.StartsWith("install|", StringComparison.Ordinal))
        {
            await InstallFromBrowserAsync(user, serverId, command["install|".Length..]);
        }
        else if (input.Length == 0)
        {
            _browserAlert = AlertVariant.Warning;
            _browserMessage = "Paste a Workshop item id or a collection URL to preview it.";
        }

        // Re-resolve whenever the lookup box still carries a reference, so the preview cards survive an Install post.
        if (input.Length > 0)
        {
            _preview = await WorkshopMetadata.ResolveAsync(user, serverId, input);
        }
    }

    // Key-gated search: run the query (or, on an Install button, add the chosen item then re-run so results persist).
    private async Task SearchAsync()
    {
        if (_server is null || !ServerId.TryParse(Id, out ServerId serverId))
        {
            return;
        }

        UserId user = await CurrentUserAsync();
        string command = _searchForm?.Command ?? string.Empty;
        string query = _searchForm?.Query?.Trim() ?? string.Empty;

        if (command.StartsWith("install|", StringComparison.Ordinal))
        {
            await InstallFromBrowserAsync(user, serverId, command["install|".Length..]);
        }

        if (query.Length > 0)
        {
            _searchResults = await WorkshopSearch.SearchAsync(query);
        }
    }

    private async Task InstallFromBrowserAsync(UserId user, ServerId serverId, string workshopId)
    {
        ModManagementResult result = await ModManager.AddWorkshopItemAsync(user, serverId, workshopId.Trim());
        if (result.Succeeded)
        {
            _browserAlert = AlertVariant.Success;
            _browserMessage = $"Added Workshop item {workshopId} (operation {result.Operation}). Enable its mods from the Mods section once it downloads, then restart to load them.";
        }
        else
        {
            _browserAlert = AlertVariant.Warning;
            _browserMessage = result.Failure switch
            {
                ModManagementFailure.NotAuthorized => "You are not permitted to install mods on this server.",
                ModManagementFailure.ServerNotFound => "That server is no longer available.",
                ModManagementFailure.ServerBusy => "The server is busy with another operation; try again once it finishes.",
                ModManagementFailure.SnapshotUnavailable => "Refresh mod discovery for this server (in the Mods section) before installing.",
                ModManagementFailure.NoChange => "That Workshop item is already in this server's list.",
                ModManagementFailure.InvalidInput => result.Message ?? "That Workshop id is not valid.",
                _ => "The item could not be installed.",
            };
        }

        // Reflect the just-added item in the installed/configured sets that drive the card state.
        await LoadModManagementAsync(user, serverId);
    }

    // A preview item card: thumbnail, title, id/size/updated, description, compat chips, and Install.
