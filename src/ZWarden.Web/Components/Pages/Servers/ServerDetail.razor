        @<div class="zw-mb-card" data-modbrowser-item data-workshop-id="@item.WorkshopId">
            @ThumbFragment(item.PreviewUrl)
            <div class="zw-mb-body">
                <div class="zw-mb-title" data-item-title>@TitleOf(item)</div>
                <div class="zw-mb-meta">
                    <span class="font-mono">@item.WorkshopId</span>
                    @if (item.SizeBytes is { } size)
                    {
                        <span> · @FormatSize(size)</span>
                    }
                    @if (item.UpdatedAt is { } updated)
                    {
                        <span> · updated @ShortDate(updated)</span>
                    }
