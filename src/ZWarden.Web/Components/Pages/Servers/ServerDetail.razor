    private async Task LoadBackupsAsync(UserId user, ServerId serverId)
    {
        // Per-server permissions (fail-closed): the panel shows only where the caller holds Backup.View; the take
        // and delete controls show only with their own permission; the service re-checks server-side on submit.
        _backupPerm = new BackupPermissions(
            CanView: (await PermissionChecker.EvaluateAsync(user, Permissions.BackupView, serverId)).IsAllowed,
            CanCreate: (await PermissionChecker.EvaluateAsync(user, Permissions.BackupCreate, serverId)).IsAllowed,
            CanRestore: (await PermissionChecker.EvaluateAsync(user, Permissions.BackupRestore, serverId)).IsAllowed,
            CanDelete: (await PermissionChecker.EvaluateAsync(user, Permissions.BackupDelete, serverId)).IsAllowed);

        _backups = _backupPerm.CanView
            ? await BackupQuery.ListForServerAsync(serverId)
            : [];
    }

    private async Task BackupManageAsync()
    {
        if (_server is null || !ServerId.TryParse(Id, out ServerId serverId))
        {
            return;
        }

        UserId user = await CurrentUserAsync();
        string command = _backupForm?.Command ?? string.Empty;

        if (command == "create")
        {
            SetBackupCreateResult(await ServerBackups.CreateAsync(user, serverId, BackupReason.Manual));
        }
        else if (command.StartsWith("restore|", StringComparison.Ordinal)
                 && BackupId.TryParse(command["restore|".Length..], out BackupId restoreId))
        {
            SetBackupRestoreResult(await ServerRestores.RestoreAsync(user, restoreId));
        }
        else if (command.StartsWith("delete|", StringComparison.Ordinal)
                 && BackupId.TryParse(command["delete|".Length..], out BackupId backupId))
        {
            SetBackupDeleteResult(await ServerBackups.DeleteAsync(user, backupId));
        }

        await LoadBackupsAsync(user, serverId);
    }

    private void SetBackupCreateResult(BackupRequestResult result)
    {
        if (result.Succeeded)
        {
            SetBackupMessage($"Backup enqueued (operation {result.Operation}). It appears in the list once the archive is written.", ok: true);
            return;
        }

        SetBackupMessage(result.Failure switch
        {
            BackupRequestFailure.NotAuthorized => "You are not permitted to back up this server.",
            BackupRequestFailure.ServerNotFound => "That server is no longer available.",
            BackupRequestFailure.ServerBusy => "The server is busy with another operation; try again once it finishes.",
            _ => "The backup could not be started.",
        }, ok: false);
    }

    private void SetBackupDeleteResult(BackupDeletionOutcome result)
    {
        if (result.Succeeded)
        {
            SetBackupMessage($"Deletion enqueued (operation {result.Operation}). The backup is removed once it completes.", ok: true);
            return;
        }

        SetBackupMessage(result.Failure switch
        {
            BackupDeletionFailure.NotAuthorized => "You are not permitted to delete this server's backups.",
            BackupDeletionFailure.BackupNotFound => "That backup is no longer available.",
            _ => "The backup could not be deleted.",
        }, ok: false);
    }

    private void SetBackupRestoreResult(RestoreRequestResult result)
    {
        if (result.Succeeded)
        {
            SetBackupMessage(
                $"Restore enqueued (operation {result.Operation}). A protective backup of the current world is taken first, then the world is swapped in.",
                ok: true);
            return;
        }

        SetBackupMessage(result.Failure switch
        {
            RestoreRequestFailure.NotAuthorized => "You are not permitted to restore this server.",
            RestoreRequestFailure.BackupNotFound => "That backup is no longer available.",
            RestoreRequestFailure.ServerBusy => "The server is busy with another operation; try again once it finishes.",
            RestoreRequestFailure.ServerRunning => "Stop the server before restoring — a restore overwrites the live world.",
            _ => "The restore could not be started.",
        }, ok: false);
    }

    private void SetBackupMessage(string message, bool ok)
    {
        _backupMessage = message;
        _backupAlert = ok ? AlertVariant.Success : AlertVariant.Warning;
    }

    private static string BackupCreated(DateTimeOffset at) => at.UtcDateTime.ToString("yyyy-MM-dd HH:mm");

    private static string ShortChecksum(string sha256) => sha256.Length <= 12 ? sha256 : sha256[..12];

    private static string FormatSize(long bytes)
    {
        string[] units = ["B", "KiB", "MiB", "GiB", "TiB"];
        double size = bytes;
        int unit = 0;
        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }

        return unit == 0 ? $"{bytes} {units[unit]}" : $"{size:0.0} {units[unit]}";
    }

    private async Task<UserId> CurrentUserAsync()
    {
        ClaimsPrincipal principal = (await AuthState!).User;
        return Guid.TryParse(Users.GetUserId(principal), out Guid id)
            ? UserId.FromGuid(id)
            : throw new InvalidOperationException("Authenticated request carries no user id claim.");
    }

