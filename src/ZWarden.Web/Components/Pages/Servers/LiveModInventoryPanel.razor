@using ZWarden.Application.Mods
@using ZWarden.Application.Workshop
@using ZWarden.Domain.Ids
@implements IDisposable
@inject IModInventoryCache Inventories
@inject IWorkshopMetadataClient Metadata

@* The live mod-inventory island (F21): an interactive island embedded in the static server-detail page, mirroring
   LivePlayerRosterPanel. The parent does the authorized, tenant-filtered work (it has an HttpContext); this child
   only reads the process-local, ownership-guarded inventory cache (keyed by ServerId + owning AgentId), so it needs
   no tenant context — which a circuit lacks. It refreshes once per second and shows the newest inventory a
   DiscoverMods Operation observed. Ids arrive as strings so they cross the static→interactive boundary cleanly.
   All Workshop/mod ids and names are untrusted PZ output and rendered as data (trust-boundaries.md §8). *@

<div data-live-mods>
    @if (_inventory is { } inv)
    {
        <div class="flex items-baseline justify-between gap-3">
            <span class="text-sm font-medium" data-mods-summary>@Summary(inv)</span>
            <span class="text-xs text-muted-foreground tabular-nums">as of @Observed(inv.ObservedAt)</span>
        </div>

        @* BbItemGroup/BbItemDescription do not splat attributes, so the group hooks ride wrapper divs and the
           per-mod data-mod-id rides an inner span; BbItem splats (data-mod-issue/data-issue-kind/data-workshop-item).
           Matches the mod-manage BbItem lists on the parent page (#121). *@
        @if (inv.Issues.Count > 0)
        {
            <div data-mod-issues>
                <BbItemGroup Class="mt-3">
                    @foreach (ModCompatIssue issue in inv.Issues)
                    {
                        <BbItem Variant="ItemVariant.Outline" Size="ItemSize.Sm" data-mod-issue data-issue-kind="@issue.Kind">
                            <BbItemContent>
                                <BbItemTitle>
                                    <span class="font-medium @IssueClass(issue.Kind)">@IssueLabel(issue.Kind)</span>
                                    <span class="font-mono">@issue.Subject</span>
                                </BbItemTitle>
                                @if (issue.Detail is { Length: > 0 } detail)
                                {
                                    <BbItemDescription>@detail</BbItemDescription>
                                }
                            </BbItemContent>
                        </BbItem>
                    }
                </BbItemGroup>
            </div>
        }

        @if (inv.InstalledItems.Count > 0)
        {
            <div data-mods-list>
                <BbItemGroup Class="mt-3">
                    @foreach (InstalledWorkshopItem item in inv.InstalledItems)
                    {
                        <BbItem Variant="ItemVariant.Outline" Size="ItemSize.Sm" data-workshop-item>
                            <BbItemContent>
                                <BbItemTitle>
                                    @if (Meta(item.WorkshopId) is { Found: true } meta)
                                    {
                                        @* Enriched (#110): resolved Workshop name + preview thumbnail next to the id.
                                           Name and preview url are untrusted external data, escaped/constrained at render. *@
                                        <span class="inline-flex items-center gap-2" data-workshop-enriched>
                                            @if (meta.PreviewUrl is { Length: > 0 } url)
                                            {
                                                <img class="zw-mb-thumb-sm" src="@url" alt="" loading="lazy"
                                                     referrerpolicy="no-referrer" data-workshop-thumb />
                                            }
                                            <span>
                                                @if (meta.Title is { Length: > 0 } title)
                                                {
                                                    <span class="text-sm font-medium" data-workshop-name>@title</span>
                                                }
                                                <span class="font-mono text-xs text-muted-foreground" data-workshop-id>@item.WorkshopId</span>
                                            </span>
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="font-mono text-sm" data-workshop-id>@item.WorkshopId</span>
                                    }
                                </BbItemTitle>
                                @if (item.Mods.Count > 0)
                                {
                                    @foreach (InstalledMod mod in item.Mods)
                                    {
                                        <BbItemDescription>
                                            <span data-mod-id>
                                                <span class="font-mono">@mod.ModId</span>
                                                @if (mod.Name is { Length: > 0 } name)
                                                {
                                                    <span class="text-muted-foreground">— @name</span>
                                                }
                                            </span>
                                        </BbItemDescription>
                                    }
                                }
                                else
                                {
                                    <BbItemDescription>No readable mod.info in this item.</BbItemDescription>
                                }
                            </BbItemContent>
                        </BbItem>
                    }
                </BbItemGroup>
            </div>
        }
        else
        {
            <p class="mt-3 text-sm text-muted-foreground" data-mods-empty>No Workshop content is installed on disk.</p>
        }
    }
    else
    {
        <p class="text-sm text-muted-foreground" data-mods-awaiting>No inventory yet — use Refresh to discover this server's mods.</p>
    }
</div>

@code {
    /// <summary>The Server, as its canonical string id (crosses the static→interactive boundary as a string).</summary>
    [Parameter]
    [EditorRequired]
    public string ServerId { get; set; } = string.Empty;

    /// <summary>The Server's owning Agent, as its canonical string id (the cache ownership-guard key).</summary>
    [Parameter]
    [EditorRequired]
    public string AgentId { get; set; } = string.Empty;

    private ZWarden.Domain.Ids.ServerId _server;
    private ZWarden.Domain.Ids.AgentId _agent;
    private bool _parsed;
    private ModInventory? _inventory;
    private PeriodicTimer? _timer;
    private Task? _loop;

    // #110 enrichment: resolved Workshop metadata by id, filled from the keyless control-plane client. This runs
    // only in OnAfterRenderAsync — which never fires during a static server prerender — so the Steam egress happens
    // only in a live interactive circuit, never on the initial server render. Best-effort: the bare ids render at
    // once and names/previews appear when Steam answers.
    private readonly Dictionary<string, WorkshopItemMetadata> _meta = new(StringComparer.Ordinal);
    private string? _metaSignature;

    protected override void OnInitialized()
    {
        _parsed = ZWarden.Domain.Ids.ServerId.TryParse(ServerId, out _server)
            & ZWarden.Domain.Ids.AgentId.TryParse(AgentId, out _agent);
        Refresh();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        _loop = RunAsync();
    }

    private async Task RunAsync()
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync().ConfigureAwait(false))
            {
                Refresh();
                await InvokeAsync(StateHasChanged).ConfigureAwait(false);
            }
        }
        catch (ObjectDisposedException)
        {
            // The panel was disposed while awaiting the next tick — expected on navigation away.
        }
    }

    private void Refresh()
    {
        if (_parsed)
        {
            _inventory = Inventories.GetLatest(_server, _agent);
        }
    }

    // Enrichment runs only after a render in an interactive circuit (OnAfterRender is not called during static
    // prerender), so no Steam call happens on the server prerender. It re-enriches whenever the set of installed
    // Workshop ids changes, and only on the renderer's dispatcher, so _meta is never touched concurrently.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_parsed || _inventory is not { } inv)
        {
            return;
        }

        List<string> ids = inv.InstalledItems.Select(i => i.WorkshopId).ToList();
        string signature = string.Join(',', ids);
        if (signature == _metaSignature)
        {
            return;
        }

        _metaSignature = signature;
        if (ids.Count == 0)
        {
            return;
        }

        IReadOnlyList<WorkshopItemMetadata> items = await Metadata.GetItemsAsync(ids).ConfigureAwait(false);
        foreach (WorkshopItemMetadata item in items)
        {
            _meta[item.WorkshopId] = item;
        }

        await InvokeAsync(StateHasChanged).ConfigureAwait(false);
    }

    private WorkshopItemMetadata? Meta(string workshopId) =>
        _meta.TryGetValue(workshopId, out WorkshopItemMetadata? metadata) ? metadata : null;

    private static string Summary(ModInventory inv)
    {
        int items = inv.InstalledItems.Count;
        int mods = inv.InstalledItems.Sum(i => i.Mods.Count);
        return $"{items} Workshop item{(items == 1 ? "" : "s")}, {mods} mod{(mods == 1 ? "" : "s")}";
    }

    private static string IssueLabel(ModCompatIssueKind kind) => kind switch
    {
        ModCompatIssueKind.ReferencedNotInstalled => "Referenced, not installed",
        ModCompatIssueKind.EnabledButMissing => "Enabled, missing",
        ModCompatIssueKind.InstalledButInactive => "Installed, inactive",
        ModCompatIssueKind.DuplicateModId => "Duplicate id",
        _ => kind.ToString(),
    };

    private static string IssueClass(ModCompatIssueKind kind) => kind switch
    {
        ModCompatIssueKind.EnabledButMissing => "text-destructive",
        ModCompatIssueKind.InstalledButInactive => "text-muted-foreground",
        _ => "text-amber-600 dark:text-amber-500",
    };

    private static string Observed(DateTimeOffset at) =>
        at.UtcDateTime.ToString("HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture) + " UTC";

    public void Dispose() => _timer?.Dispose();
}
