@using System.Security.Claims
@using ZWarden.Application.Agents
@using ZWarden.Application.Settings
@using ZWarden.Domain.Ids
@using ZWarden.Infrastructure.Tenancy
@inject ActionScopeRunner Actions
@inject UserManager<ApplicationUser> Users
@inject IHostCapacityCache Capacity
@inject IAgentConnectionRegistry Connections
@inject ToastService Toasts
@inject NavigationManager Nav
@inject DeploySheetRequests Requests
@implements IDisposable

@* The Fleet board's "Deploy server" button and sheet (#338; replaces the #230 inline Register form). An interactive
   island on the static Fleet page (ADR 0040/0046): it lists the Hosts and registers the Server through
   ActionScopeRunner, a scope per action carrying the circuit's tenant (#297). The page renders it only for a caller
   holding Server.Register, and the service re-checks it on Deploy and Adopt. When a Host reports containers with no
   Server record, an "Adopt existing" tab adopts one (#339; the Fleet banner opens it through DeploySheetRequests).
   Host names are untrusted, rendered as data. *@

@* "on" once the circuit has rendered the island (browser tests wait for it); see ServerDetail. *@
<span hidden data-circuit="@(_circuitReady ? "on" : "off")"></span>
<BbButton OnClick="@(() => OpenAsync(DeploySheetTab.New))" data-action="deploy-server-open">+ Deploy server</BbButton>

<StepSheet Open="_open" OpenChanged="OpenChangedAsync"
           Title="@(_tab == DeploySheetTab.Adopt ? "Adopt a server" : "Deploy server")"
           Description="@(_tab == DeploySheetTab.Adopt
               ? "A Project Zomboid container ZWarden created that has no server record here, e.g. after a database restore. Adopting it brings it back under management; nothing is changed on the host."
               : "A fresh Project Zomboid container on one of your hosts. It starts once the host's Agent has built it.")"
           Steps="@(_tab == DeploySheetTab.Adopt ? AdoptSteps : DeployServerDraft.StepNames)"
           Step="@(_tab == DeploySheetTab.Adopt ? 0 : _step)" StepChanged="StepChangedAsync" CanAdvance="CanAdvanceAsync"
           OnFinish="FinishAsync" FinishLabel="@(_tab == DeploySheetTab.Adopt ? "Adopt" : "Deploy")" Busy="_busy"
           Lead="@(_adoptable.Count > 0 ? TabsLead : null)" data-deploy-server-sheet>
    @if (_message is not null)
    {
        <div data-deploy-message>
            <BbAlert Variant="AlertVariant.Warning" AccentBorder>
                <BbAlertDescription>@_message</BbAlertDescription>
            </BbAlert>
        </div>
    }

    @switch (_tab == DeploySheetTab.Adopt ? -1 : _step)
    {
        case -1:
            @AdoptStep
            break;
        case DeployServerDraft.Basics:
            @BasicsStep
            break;
        case DeployServerDraft.GameVersion:
            @GameVersionStep
            break;
        default:
            @MemoryStep
            break;
    }
</StepSheet>

<BbPortalHost />
<BbToastProvider />

@code {
    /// <summary>Open the sheet on the first interactive render (the <c>?deploy=1</c> / <c>?adopt=1</c> deep links).</summary>
    [Parameter]
    public bool OpenOnLoad { get; set; }

    /// <summary>With <see cref="OpenOnLoad"/>, open on the Adopt existing tab (<c>?adopt=1</c>).</summary>
    [Parameter]
    public bool StartOnAdopt { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    private static readonly IReadOnlyList<string> AdoptSteps = ["Adopt"];

    private DeployServerDraft _draft = new();
    private IReadOnlyList<HostOption>? _hosts;
    private IReadOnlyList<AdoptOption> _adoptable = [];
    private DeploySheetTab _tab = DeploySheetTab.New;
    private string? _adoptTarget;
    private string? _adoptName;
    private bool _circuitReady;
    private bool _open;
    private bool _busy;
    private int _step;
    private string? _message;
    private string? _overcommitWarning;

    private RenderFragment BasicsStep => @<div class="space-y-4" data-deploy-step="basics">
        @if (_hosts is { Count: 0 })
        {
            <p class="text-sm text-muted-foreground" data-no-hosts>
                No hosts yet. Enroll one on the Hosts page; it can take servers once its Agent connects.
            </p>
        }
        <div class="grid gap-3 sm:grid-cols-2">
            <div class="flex flex-col text-sm sm:col-span-2">
                <BbLabel For="deploy-host" Class="mb-1 text-muted-foreground">Host</BbLabel>
                <BbNativeSelect TValue="string" Id="deploy-host" Value="@_draft.HostId" ValueChanged="HostChanged" Placeholder="Select…">
                    @foreach (HostOption host in _hosts ?? [])
                    {
                        <option value="@host.Id" disabled="@(!host.Deployable)" data-host-option>@host.OptionLabel</option>
                    }
                </BbNativeSelect>
                @if ((_hosts ?? []).Any(h => h.Connected && !h.Deployable))
                {
                    <p class="mt-1 text-xs text-muted-foreground" data-host-no-image>
                        A host with no PZ image can't take servers. Set ZWARDEN_PZ_IMAGE in its Agent's .env and restart the Agent.
                    </p>
                }
            </div>
            <div class="flex flex-col text-sm">
                <BbLabel For="deploy-name" Class="mb-1 text-muted-foreground">Name</BbLabel>
                <BbInput Id="deploy-name" UpdateTiming="UpdateTiming.Immediate" @bind-Value="_draft.Name" autocomplete="off" />
            </div>
            <div class="flex flex-col text-sm">
                <BbLabel For="deploy-public-name" Class="mb-1 text-muted-foreground">Server browser name</BbLabel>
                <BbInput Id="deploy-public-name" UpdateTiming="UpdateTiming.Immediate" @bind-Value="_draft.PublicName" Placeholder="PZ default" />
            </div>
            <div class="flex flex-col text-sm">
                <BbLabel For="deploy-max-players" Class="mb-1 text-muted-foreground">Max players</BbLabel>
                <BbInput Id="deploy-max-players" UpdateTiming="UpdateTiming.Immediate" @bind-Value="_draft.MaxPlayers" Placeholder="32" inputmode="numeric" />
            </div>
            <div class="flex flex-col text-sm">
                <BbLabel For="deploy-password" Class="mb-1 text-muted-foreground">Join password</BbLabel>
                @* Stored encrypted on the provisioning Operation (ADR 0015); seeded into servertest.ini. *@
                <BbInput Id="deploy-password" Type="InputType.Password" UpdateTiming="UpdateTiming.Immediate" @bind-Value="_draft.Password"
                         autocomplete="new-password" Placeholder="None" />
            </div>
            <div class="flex flex-col text-sm">
                <BbLabel For="deploy-port" Class="mb-1 text-muted-foreground">Game port</BbLabel>
                @* #229: the host UDP pair is this port and the one above; blank = the next free pair. *@
                <BbInput Id="deploy-port" UpdateTiming="UpdateTiming.Immediate" @bind-Value="_draft.GamePort" Placeholder="Auto" inputmode="numeric" />
            </div>
            <div class="flex flex-col text-sm sm:col-span-2">
                <BbLabel For="deploy-welcome" Class="mb-1 text-muted-foreground">Welcome message</BbLabel>
                <BbInput Id="deploy-welcome" UpdateTiming="UpdateTiming.Immediate" @bind-Value="_draft.WelcomeMessage" Placeholder="PZ default" />
            </div>
        </div>
        <div class="flex items-center gap-2 text-sm">
            <BbCheckbox Id="deploy-public" @bind-Checked="_draft.Public" />
            <BbLabel For="deploy-public">List it in the in-game public server browser</BbLabel>
        </div>
    </div>;

    private RenderFragment GameVersionStep => @<div class="space-y-4" data-deploy-step="game-version">
        <div class="grid gap-3 sm:grid-cols-2">
            <div class="flex flex-col text-sm">
                <BbLabel For="deploy-branch" Class="mb-1 text-muted-foreground">Build 42 branch</BbLabel>
                <BbNativeSelect TValue="string" Id="deploy-branch" @bind-Value="_draft.Branch">
                    @foreach (ServerBranchOption option in ServerBranchCatalog.Options)
                    {
                        <option value="@ServerBranchView.ChoiceValue(option)">@option.Label</option>
                    }
                    <option value="@ServerBranchView.CustomChoice">Custom…</option>
                </BbNativeSelect>
            </div>
            @if (_draft.Branch == ServerBranchView.CustomChoice)
            {
                <div class="flex flex-col text-sm">
                    <BbLabel For="deploy-custom-branch" Class="mb-1 text-muted-foreground">Custom branch</BbLabel>
                    <BbInput Id="deploy-custom-branch" UpdateTiming="UpdateTiming.Immediate" @bind-Value="_draft.CustomBranch"
                             Placeholder="Steam branch name" spellcheck="false" />
                </div>
            }
        </div>
        <ul class="space-y-1 text-xs text-muted-foreground" data-branch-help>
            @foreach (ServerBranchOption option in ServerBranchCatalog.Options)
            {
                <li><span class="font-medium text-foreground">@option.Label</span>: @option.Description</li>
            }
            <li><span class="font-medium text-foreground">Custom…</span>: any other Steam branch by name. A name Steam doesn't know stops the install with a clear reason in the logs.</li>
        </ul>
        <p class="text-xs text-muted-foreground">
            The branch is fixed once the server is created. Updates stay on it, so a pinned server doesn't move when a new
            build ships.
        </p>
    </div>;

    private RenderFragment MemoryStep => @<div class="space-y-4" data-deploy-step="memory">
        <div class="grid gap-3 sm:grid-cols-2">
            <div class="flex flex-col text-sm">
                <BbLabel For="deploy-players" Class="mb-1 text-muted-foreground">Expected players</BbLabel>
                <BbInput Id="deploy-players" UpdateTiming="UpdateTiming.Immediate" Value="@_draft.ExpectedPlayers" ValueChanged="ExpectedPlayersChanged"
                         Placeholder="e.g. 8" inputmode="numeric" />
            </div>
            <div class="flex flex-col text-sm">
                <BbLabel For="deploy-heap" Class="mb-1 text-muted-foreground">Heap (GiB)</BbLabel>
                <BbInput Id="deploy-heap" UpdateTiming="UpdateTiming.Immediate" Value="@_draft.HeapGiB" ValueChanged="HeapChanged"
                         Placeholder="Suggested" inputmode="decimal" />
            </div>
        </div>
        <p class="text-xs text-muted-foreground">
            Leave the heap blank to use the suggestion: 4 GiB plus 0.25 GiB per expected player (8 players → 6 GiB,
            16 → 8 GiB, 32 → 12 GiB); with no player count the host's default applies. It is a starting point — mods and
            map size matter more than headcount. The container's limit is the heap plus the host's overhead.
        </p>
        <ul class="space-y-1 text-xs text-muted-foreground" data-host-capacity>
            @foreach (HostOption host in (_hosts ?? []).Where(h => h.Connected))
            {
                <li data-host-capacity-line="@host.Id"><span class="font-medium text-foreground">@host.Name</span>: @NewServerForm.CapacityLine(Capacity.GetLatest(host.Id))</li>
            }
        </ul>
        @if (_overcommitWarning is not null)
        {
            <div class="space-y-2" data-overcommit-warning>
                <BbAlert Variant="AlertVariant.Warning" AccentBorder>
                    <BbAlertDescription>@_overcommitWarning</BbAlertDescription>
                </BbAlert>
                <div class="flex items-center gap-2 text-sm">
                    <BbCheckbox Id="deploy-acknowledge" @bind-Checked="_draft.AcknowledgeOvercommit" />
                    <BbLabel For="deploy-acknowledge">Create it anyway</BbLabel>
                </div>
            </div>
        }
    </div>;

    // Only shown when a Host reports something to adopt; the tabs switch what the sheet does.
    private RenderFragment TabsLead => @<BbTabs Value="@TabValue(_tab)" ValueChanged="TabChangedAsync" data-deploy-tabs>
        <BbTabsList Class="w-full">
            <BbTabsTrigger Value="new" Class="flex-1" data-tab="new">New server</BbTabsTrigger>
            <BbTabsTrigger Value="adopt" Class="flex-1" data-tab="adopt">Adopt existing (@_adoptable.Count)</BbTabsTrigger>
        </BbTabsList>
    </BbTabs>;

    private RenderFragment AdoptStep => @<div class="space-y-4" data-deploy-step="adopt">
        @if (_adoptable.Count == 0)
        {
            <p class="text-sm text-muted-foreground" data-adopt-empty>Nothing to adopt: no host reports an unmanaged container.</p>
        }
        else
        {
            <div class="space-y-2">
                <BbLabel Class="text-sm text-muted-foreground">Container</BbLabel>
                <BbRadioGroup TValue="string" Value="@_adoptTarget" ValueChanged="AdoptTargetChanged" AriaLabel="Container to adopt" data-adopt-list>
                    @foreach (AdoptOption option in _adoptable)
                    {
                        <div class="flex items-center gap-3 rounded-md border border-border px-3 py-2" data-adopt-option="@option.Value">
                            <BbRadioGroupItem TValue="string" Value="@option.Value" Id="@($"adopt-{option.Index}")" />
                            <label for="@($"adopt-{option.Index}")" class="flex-1 cursor-pointer text-sm">
                                <span class="font-medium">@option.RunState</span> on <span class="font-medium">@option.HostName</span>
                                @if (option.Detail is not null)
                                {
                                    <span class="ml-1 font-mono text-xs text-muted-foreground">@option.Detail</span>
                                }
                            </label>
                        </div>
                    }
                </BbRadioGroup>
            </div>
            <div class="flex flex-col text-sm">
                <BbLabel For="adopt-name" Class="mb-1 text-muted-foreground">Name</BbLabel>
                <BbInput Id="adopt-name" UpdateTiming="UpdateTiming.Immediate" @bind-Value="_adoptName" autocomplete="off" />
            </div>
        }
    </div>;

    protected override void OnInitialized() => Requests.OpenRequested += OnOpenRequestedAsync;

    public void Dispose() => Requests.OpenRequested -= OnOpenRequestedAsync;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || !RendererInfo.IsInteractive)
        {
            return;
        }

        _circuitReady = true;
        if (OpenOnLoad)
        {
            await OpenAsync(StartOnAdopt ? DeploySheetTab.Adopt : DeploySheetTab.New);
        }

        StateHasChanged();
    }

    // The adopt banner (another island in this circuit) asks for the sheet.
    private Task OnOpenRequestedAsync(DeploySheetTab tab) => InvokeAsync(async () =>
    {
        await OpenAsync(tab);
        StateHasChanged();
    });

    private async Task OpenAsync(DeploySheetTab tab)
    {
        _open = true;
        _message = null;
        await LoadHostsAsync();
        _tab = tab == DeploySheetTab.Adopt && _adoptable.Count > 0 ? DeploySheetTab.Adopt : DeploySheetTab.New;
    }

    private static string TabValue(DeploySheetTab tab) => tab == DeploySheetTab.Adopt ? "adopt" : "new";

    private Task TabChangedAsync(string? value)
    {
        _tab = value == "adopt" ? DeploySheetTab.Adopt : DeploySheetTab.New;
        _message = null;
        return Task.CompletedTask;
    }

    private void AdoptTargetChanged(string? value) => _adoptTarget = value;

    private Task FinishAsync() => _tab == DeploySheetTab.Adopt ? AdoptAsync() : DeployAsync();

    private Task OpenChangedAsync(bool open)
    {
        _open = open;
        return Task.CompletedTask;
    }

    // Read when the sheet opens, so the connection state and free memory are current.
    private async Task LoadHostsAsync()
    {
        UserId user = await CurrentUserAsync();
        IReadOnlyList<DeployHost> hosts = await Actions.RunAsync<IServerInventory, IReadOnlyList<DeployHost>>(
            (inventory, ct) => inventory.ListDeployHostsAsync(user, ct));
        _hosts = [.. hosts
            .Select(h => HostOption.Of(h, Connections.IsConnected(h.Id), Capacity.GetLatest(h.Id)))
            .OrderByDescending(h => h.Deployable)
            .ThenByDescending(h => h.Connected)
            .ThenBy(h => h.Name, StringComparer.OrdinalIgnoreCase)];

        // #347: the tenant's default deploy host, when it can take a server now; else one host that can is chosen for
        // the operator. Either way the operator can pick another.
        List<HostOption> deployable = [.. _hosts.Where(h => h.Deployable)];
        ControlPlaneSettingsSnapshot settings = await Actions.RunAsync<IControlPlaneSettingsService, ControlPlaneSettingsSnapshot>(
            (service, ct) => service.GetAsync(ct));
        if (_draft.HostId is null && settings.DefaultDeployHost is { } preferred && deployable.Any(h => h.Id == preferred))
        {
            _draft.HostId = preferred.ToString();
        }
        else if (_draft.HostId is null && deployable.Count == 1)
        {
            _draft.HostId = deployable[0].Id.ToString();
        }

        // #339: what the tenant's Hosts report without a Server record, on the Hosts listed above.
        IReadOnlyList<DiscoveredServerOnAgent> discovered = await Actions.RunAsync<IServerInventory, IReadOnlyList<DiscoveredServerOnAgent>>(
            (inventory, ct) => inventory.ListAllDiscoveredUnregisteredAsync(ct));
        Dictionary<AgentId, string> names = _hosts.ToDictionary(h => h.Id, h => h.Name);
        _adoptable = AdoptOption.For([.. discovered.Where(d => names.ContainsKey(d.AgentId))], names);
        if (_adoptable.All(o => o.Value != _adoptTarget))
        {
            _adoptTarget = _adoptable.Count == 1 ? _adoptable[0].Value : null;
        }
    }

    private Task<bool> CanAdvanceAsync(int step)
    {
        _message = _draft.Validate(step, Deployable());
        return Task.FromResult(_message is null);
    }

    private Task StepChangedAsync(int step)
    {
        _step = step;
        _message = null;
        return Task.CompletedTask;
    }

    // A different host or heap is a different capacity question: drop the warning and its acknowledgement.
    private void HostChanged(string? value)
    {
        _draft.HostId = value;
        ResetOvercommit();
    }

    private void ExpectedPlayersChanged(string? value)
    {
        _draft.ExpectedPlayers = value;
        ResetOvercommit();
    }

    private void HeapChanged(string? value)
    {
        _draft.HeapGiB = value;
        ResetOvercommit();
    }

    private void ResetOvercommit()
    {
        _overcommitWarning = null;
        _draft.AcknowledgeOvercommit = false;
    }

    private async Task DeployAsync()
    {
        if (_draft.FirstInvalid(Deployable()) is { } invalid)
        {
            (_step, _message) = invalid;
            return;
        }

        _busy = true;
        _message = null;
        try
        {
            UserId user = await CurrentUserAsync();
            NewServerRequest request = _draft.ToRequest();
            ServerRegisterResult result = await Actions.RunAsync<IServerInventory, ServerRegisterResult>(
                (inventory, ct) => inventory.RegisterAsync(user, request, ct));
            if (result.Succeeded)
            {
                string host = _hosts?.FirstOrDefault(h => h.Id == request.AgentId)?.Name ?? HostNames.ShortId(request.AgentId);
                Toasts.Success($"{request.Name} is deploying on {host}. It starts once its Agent has built the container.", "Server deployed");
                _open = false;
                _step = DeployServerDraft.Basics;
                _draft = new DeployServerDraft();
                _overcommitWarning = null;
                _hosts = null;
                RefreshPage();
                return;
            }

            if (result.Failure == ServerRegisterFailure.OverCapacity && Capacity.GetLatest(request.AgentId) is { } capacity)
            {
                // D1 as in #230: warn with the numbers and ask for the acknowledgement; the typed values stay.
                _step = DeployServerDraft.Memory;
                _overcommitWarning = NewServerForm.ShortfallWarning(capacity, request.HeapSizeBytes ?? capacity.DefaultHeapBytes);
                return;
            }

            _step = result.Failure is { } failure ? DeployServerDraft.StepFor(failure) : DeployServerDraft.Basics;
            _message = DeployServerDraft.FailureMessage(result.Failure);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task AdoptAsync()
    {
        string name = _adoptName?.Trim() ?? string.Empty;
        AdoptOption? option = _adoptable.FirstOrDefault(o => o.Value == _adoptTarget);
        if (option is null || name.Length == 0)
        {
            _message = "Choose a container and a name.";
            return;
        }

        _busy = true;
        _message = null;
        try
        {
            UserId user = await CurrentUserAsync();
            ServerImportResult result = await Actions.RunAsync<IServerInventory, ServerImportResult>(
                (inventory, ct) => inventory.ImportAsync(user, option.AgentId, option.ServerId, name, ct));
            if (result.Succeeded)
            {
                Toasts.Success($"{name} on {option.HostName} is now managed.", "Server adopted");
                _open = false;
                _adoptTarget = null;
                _adoptName = null;
                _adoptable = [];
                _hosts = null;
                RefreshPage();
                return;
            }

            _message = result.Failure switch
            {
                ServerImportFailure.NotAuthorized => "You are not permitted to adopt servers.",
                ServerImportFailure.AgentNotFound => "That host is no longer known.",
                ServerImportFailure.NotDiscovered => "That container is no longer reported. It may have been removed.",
                _ => "The server could not be adopted.",
            };
        }
        finally
        {
            _busy = false;
        }
    }

    // Reloads the static page in place so the grid gains the new row (and the adopt banner updates), while this island,
    // and its toast, stays. A ?deploy=1 / ?adopt=1 deep link is dropped so a later reload doesn't reopen the sheet.
    private void RefreshPage()
    {
        Uri current = new(Nav.Uri);
        if (current.Query.Length > 0)
        {
            Nav.NavigateTo(current.GetLeftPart(UriPartial.Path), replace: true);
        }
        else
        {
            Nav.Refresh();
        }
    }

    private HashSet<AgentId> Deployable() => [.. (_hosts ?? []).Where(h => h.Deployable).Select(h => h.Id)];

    private async Task<UserId> CurrentUserAsync()
    {
        ClaimsPrincipal principal = (await AuthState!).User;
        return Guid.TryParse(Users.GetUserId(principal), out Guid id)
            ? UserId.FromGuid(id)
            : throw new InvalidOperationException("Authenticated request carries no user id claim.");
    }

    // One container to adopt: its run state and host, and a short server id only when its host reports several (the
    // id is the only thing that tells them apart).
    private sealed record AdoptOption(int Index, string Value, AgentId AgentId, ServerId ServerId, string HostName, string RunState, string? Detail)
    {
        public static IReadOnlyList<AdoptOption> For(IReadOnlyList<DiscoveredServerOnAgent> discovered, IReadOnlyDictionary<AgentId, string> names)
        {
            HashSet<AgentId> crowded = [.. discovered.GroupBy(d => d.AgentId).Where(g => g.Count() > 1).Select(g => g.Key)];
            return [.. discovered
                .OrderBy(d => names[d.AgentId], StringComparer.OrdinalIgnoreCase)
                .Select((d, i) => new AdoptOption(
                    i,
                    $"{d.AgentId}|{d.ServerId}",
                    d.AgentId,
                    d.ServerId,
                    names[d.AgentId],
                    d.RunState.ToString(),
                    crowded.Contains(d.AgentId) ? ShortServerId(d.ServerId) : null))];
        }

        private static string ShortServerId(ServerId id)
        {
            string full = id.ToString();
            return $"{full[..12]}…{full[^5..]}";
        }
    }

    // One host in the picker: its name (#336, or its short id), whether it is connected, whether its Agent has a usable PZ
    // image (#364), and its free memory. Only a connected host with an image can take a server; offline wins the label.
    private sealed record HostOption(AgentId Id, string Name, bool Connected, bool Deployable, string OptionLabel)
    {
        public static HostOption Of(DeployHost host, bool connected, HostCapacity? capacity)
        {
            string name = HostNames.Display(host.Id, host.Label, host.Hostname);
            string label = !connected ? $"{name} — offline"
                : !host.PzImageReady ? $"{name} — no PZ image configured"
                : capacity is null ? name : $"{name} — {NewServerForm.FormatGiB(capacity.FreeBytes)} free";
            return new HostOption(host.Id, name, connected, connected && host.PzImageReady, label);
        }
    }
}
