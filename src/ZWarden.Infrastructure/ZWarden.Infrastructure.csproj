<Project Sdk="Microsoft.NET.Sdk">

  <!-- TargetFramework, Nullable, ImplicitUsings come from Directory.Build.props. -->

  <ItemGroup>
    <ProjectReference Include="..\ZWarden.Application\ZWarden.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ASP.NET Core Identity's SignInManager, cookie authentication, token providers and host
         filtering (F4). This is the identity-infrastructure composition seam - the same place
         AddSecurityFoundation/AddTenantFoundation/AddZWardenPersistence live. HTTP middleware wiring
         (UseAuthentication/UseHostFiltering) stays in ZWarden.Web; Domain/Application remain web- and
         IdP-free (arch rules 2/6). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core + both providers (ADR 0004/0005). Domain stays EF-free (arch rule 2); the context,
         converters and provider wiring live here. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- ASP.NET Core Identity's EF store (F4). Domain/Application stay IdP-free (arch rules 2/6); the
         Identity entities and IdentityDbContext base live here. -->
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" />
  </ItemGroup>

</Project>
