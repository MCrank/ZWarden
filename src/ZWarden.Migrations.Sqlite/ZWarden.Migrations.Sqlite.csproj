<Project Sdk="Microsoft.NET.Sdk">

  <!-- The SQLite migration history for ZWardenDbContext (ADR 0005/0016). EF migrations are
       provider-specific, so each provider gets its own assembly, selected by UseZWardenProvider's
       MigrationsAssembly. Referenced by the host and the migration tests; Infrastructure never
       references back (the assembly is named by string), so there is no cycle. -->

  <ItemGroup>
    <ProjectReference Include="..\ZWarden.Infrastructure\ZWarden.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
