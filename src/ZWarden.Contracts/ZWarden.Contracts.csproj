<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    F7: the Web ↔ Agent protocol vocabulary. Depends only on ZWarden.Domain (typed ids,
    PRD 18's AgentId/ServerId/OperationId/MessageId). Domain is infrastructure-free
    (arch rule 2), so ZWarden.Agent -> ZWarden.Contracts -> ZWarden.Domain keeps the
    Agent clear of persistence, EF and Docker. No runtime implementation dependency either way.
  -->
  <ItemGroup>
    <ProjectReference Include="..\ZWarden.Domain\ZWarden.Domain.csproj" />
  </ItemGroup>

</Project>
