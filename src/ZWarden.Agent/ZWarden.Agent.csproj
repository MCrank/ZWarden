<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!-- TargetFramework, Nullable, ImplicitUsings come from Directory.Build.props. -->
  <PropertyGroup>
    <UserSecretsId>dotnet-ZWarden.Agent-5c207ab9-d4f0-4c28-80d7-8075d2be8478</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" />
    <!-- The outbound control-plane transport (F10). The Agent's first transport dependency; the architecture
         guard is relaxed to allow it, still forbidding Infrastructure/EF. -->
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <!-- The host Docker boundary (F13, ADR 0008): the Agent is the one project permitted a Docker client.
         Still forbidden in Web (architecture guard). -->
    <PackageReference Include="Docker.DotNet.Enhanced" />
    <!-- Logging stack (ADR 0021). -->
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Settings.Configuration" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <!-- Observability baseline (ADR 0024, F16): OTel SDK + HttpClient instrumentation and the OTLP (opt-in) +
         Console (dev) exporters. No ASP.NET Core instrumentation — the Agent hosts no inbound server. -->
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Exporter.Console" />
    <PackageReference Include="OpenTelemetry.Instrumentation.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ZWarden.Contracts\ZWarden.Contracts.csproj" />
    <ProjectReference Include="..\ZWarden.Rcon\ZWarden.Rcon.csproj" />
    <!-- F20b PR3: the parse-only PZ config seam (ADR 0010). The Agent is the tier that reads and writes the
         live /pz/ files, so it consumes IPzConfigDocument/PzDriftCheck here; Loretta stays confined to
         ZWarden.PzConfig behind the seam (ReferenceDirectionTests). -->
    <ProjectReference Include="..\ZWarden.PzConfig\ZWarden.PzConfig.csproj" />
  </ItemGroup>

</Project>
